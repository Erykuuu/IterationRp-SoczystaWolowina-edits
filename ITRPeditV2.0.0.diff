+
+float opendrt_compress_toe_quadratic_inv(float x, float toe) {
+    if (toe == 0.0) return x;
+    return (x + sqrt(x * (4.0 * toe + x))) / 2.0;
+}
+
+float opendrt_gauss_window(float x, float w) {
+    return exp(-x * x / w);
