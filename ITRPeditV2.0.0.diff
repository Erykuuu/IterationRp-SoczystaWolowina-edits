+float GetCloudShadowCheese(vec3 absoluteWorldPos, WeatherState weather) {
+	float shadow = 1.0;
+
+	#ifdef DIMENSION_OVERWORLD
+	#ifdef CLOUD_SHADOW
+		#ifdef VOLUMETRIC_CLOUDS
+			vec3 sunDir = worldShadowVector * (step(sunAngle, 0.5) * 2.0 - 1.0);
+
+			if (sunDir.y > 0.02) {
+				float baseAltitude = mix(CLOUD_CLEAR_ALTITUDE, CLOUD_RAIN_ALTITUDE, wetness);
+				float baseThickness = mix(CLOUD_CLEAR_THICKNESS, CLOUD_RAIN_THICKNESS, wetness) * weather.thicknessMul;
+				vec2 dynamicAlt = vec2(baseAltitude, baseAltitude + baseThickness);
+
+				float planetRadius = atmosphereModel_bottom_radius * 1e3;
+				float cloudScale = mix(CLOUD_CLEAR_SCALE, CLOUD_RAIN_SCALE, wetness);
+				vec3 windDirection = weather.windOffset;
+
+				float totalDensity = 0.0;
+				const int shadowSamples = 6;
+				float shadowStep = baseThickness / float(shadowSamples);
+
+				for (int i = 0; i < shadowSamples; i++) {
+					float h = dynamicAlt.x + (float(i) + 0.5) * shadowStep;
+					vec3 p = absoluteWorldPos + sunDir * ((h - absoluteWorldPos.y) / sunDir.y);
+					totalDensity += SampleDensity(SetCloudPos(p, dynamicAlt, planetRadius, cloudScale, windDirection), windDirection, false).y;
+				}
+
+				float density = totalDensity / float(shadowSamples);
+				float currentOpacity = CLOUD_SHADOW_OPACITY;
+
+				density = saturate(density * 12.0 * CLOUD_GODRAY_SHADOW);
+				shadow *= max(1.0 - density * currentOpacity, 0.0);
+			}
+		#endif
+	#endif
+	#endif
+
+	return shadow;
+}
+
+#endif
