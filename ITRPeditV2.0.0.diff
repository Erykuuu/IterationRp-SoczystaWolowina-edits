+float RevelationCloudWeatherGate(vec3 cloudPos, vec3 windDirection, RevelationDayParams day) {
+#ifdef CLOUD_REVELATION_WEATHER_MAP
+	vec2 weatherWorldDrift = RevelationCloudWeatherWorldDrift();
+
+	vec2 weatherUv = (cloudPos.xz + weatherWorldDrift) / CLOUD_REVELATION_WEATHER_SCALE;
+	weatherUv += windDirection.xz * 0.015;
+
+	vec2 revWeather = SampleWrappedRevelationCloudMap(weatherUv);
+	float mapCoverage = smoothstep(day.weatherLow, day.weatherHigh, revWeather.x);
+
+	float hugeLocalNoise = textureLod(noisetex, (cloudPos.xz + weatherWorldDrift * 0.65) / 512000.0 + vec2(0.75), 0.0).z;
+	float localGate = smoothstep(day.weatherLow * 1.1, day.weatherHigh * 0.8, hugeLocalNoise);
+	mapCoverage *= mix(1.0, localGate, day.localNoise);
+
+	// When rain takes over, fade back toward the native rainy coverage instead of forcing dry gaps.
+	float dryWeatherMapFade = 1.0 - smoothstep(0.02, 0.35, wetness);
+	float weatherMapStrength = day.weatherStrength * dryWeatherMapFade;
+
+	return mix(1.0, saturate(mapCoverage), weatherMapStrength);
+#else
+	return 1.0;
+#endif
+}
