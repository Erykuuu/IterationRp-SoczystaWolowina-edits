diff --git a/shaders/Lib/IndividualFunctions/WeatherEngine.glsl b/shaders/Lib/IndividualFunctions/WeatherEngine.glsl
new file mode 100644
index 0000000..728de40
--- /dev/null
+++ b/shaders/Lib/IndividualFunctions/WeatherEngine.glsl
@@ -0,0 +1,28 @@
+#ifndef INCLUDE_WEATHER_ENGINE
+#define INCLUDE_WEATHER_ENGINE
+
+struct WeatherState {
+	float targetCoverage;
+	float thicknessMul;
+	float densityMul;
+	float rainFactor;
+	vec3 windOffset;
+	float landScatteringStrength;
+};
+
+WeatherState GetWeatherEngineState() {
+	WeatherState state;
+	state.rainFactor = saturate(wetness * 1.1);
+	state.targetCoverage = 0.5;
+	state.thicknessMul = 1.0;
+	state.densityMul = 1.0;
+	state.landScatteringStrength = LANDSCATTERING_STRENGTH;
+
+	// Keep cloud-shadow sampling on the same animation clock as the visible cloud field.
+	float wind = 0.0005 * (CLOUD_ANIM_TIME * CLOUD_SPEED + 10.0 * FTC_OFFSET);
+	state.windOffset = vec3(1.0, wetness * 0.1 - 0.05, -0.4) * wind;
+
+	return state;
+}
+
+#endif
