index 0000000..dc1e36a
--- /dev/null
+++ b/shaders/Lib/IndividualFunctions/DustMotes.glsl
@@ -0,0 +1,112 @@
+
+// ============================================================
+//  DustMotes.glsl -- Volumetric dust particles (v7)
+//  High-contrast 3D noise creating isolated bright specks
+//  that look like individual floating particles (dead skin,
+//  lint, pollen) caught in light shafts.
+//
+//  v7 vs v6:
+//  - 2x higher frequency (finer, smaller features)
+//  - 3 octaves instead of 2 (more detail breakup)
+//  - pow(8) instead of pow(4) (isolated specks, not haze)
+// ============================================================
+
+#ifdef DUST_MOTES
+
+// Cheap hash -- no sin(), just fract/dot/add
+float DM_hash(vec3 p) {
+	p = fract(p * vec3(0.1031, 0.1030, 0.0973));
+	p += dot(p, p.yxz + 33.33);
+	return fract((p.x + p.y) * p.z);
+}
+
+// Smooth 3D value noise with trilinear interpolation
+float DustMoteSample(vec3 worldPos) {
+	// v7: Higher frequency for individual particle illusion.
+	// Each noise cell is ~0.4-0.5 blocks wide at DENSITY=1.0.
+	vec3 p = worldPos * (2.0 + DUST_MOTES_DENSITY * 1.0);
+
+	// Slow drift animation
+	p += frameTimeCounter * DUST_MOTES_DRIFT_SPEED * vec3(0.3, -0.15, 0.2);
+
+	// === Octave 1 (base) ===
+	vec3 ip = floor(p);
+	vec3 fp = fract(p);
+	fp = fp * fp * (3.0 - 2.0 * fp);
+
+	float n000 = DM_hash(ip);
+	float n100 = DM_hash(ip + vec3(1, 0, 0));
+	float n010 = DM_hash(ip + vec3(0, 1, 0));
+	float n110 = DM_hash(ip + vec3(1, 1, 0));
+	float n001 = DM_hash(ip + vec3(0, 0, 1));
+	float n101 = DM_hash(ip + vec3(1, 0, 1));
+	float n011 = DM_hash(ip + vec3(0, 1, 1));
+	float n111 = DM_hash(ip + vec3(1, 1, 1));
+
+	float n = mix(
+		mix(mix(n000, n100, fp.x), mix(n010, n110, fp.x), fp.y),
+		mix(mix(n001, n101, fp.x), mix(n011, n111, fp.x), fp.y),
+		fp.z
+	);
+
+	// === Octave 2 (detail) ===
+	vec3 p2 = p * 2.3 + 17.0;
+	vec3 ip2 = floor(p2);
+	vec3 fp2 = fract(p2);
+	fp2 = fp2 * fp2 * (3.0 - 2.0 * fp2);
+
+	float m000 = DM_hash(ip2 + 71.0);
+	float m100 = DM_hash(ip2 + vec3(1, 0, 0) + 71.0);
+	float m010 = DM_hash(ip2 + vec3(0, 1, 0) + 71.0);
+	float m110 = DM_hash(ip2 + vec3(1, 1, 0) + 71.0);
+	float m001 = DM_hash(ip2 + vec3(0, 0, 1) + 71.0);
+	float m101 = DM_hash(ip2 + vec3(1, 0, 1) + 71.0);
+	float m011 = DM_hash(ip2 + vec3(0, 1, 1) + 71.0);
+	float m111 = DM_hash(ip2 + vec3(1, 1, 1) + 71.0);
+
+	float n2 = mix(
+		mix(mix(m000, m100, fp2.x), mix(m010, m110, fp2.x), fp2.y),
+		mix(mix(m001, m101, fp2.x), mix(m011, m111, fp2.x), fp2.y),
+		fp2.z
+	);
+
+	// === Octave 3 (fine breakup -- makes particle edges irregular) ===
+	vec3 p3 = p * 5.7 + 43.0;
+	vec3 ip3 = floor(p3);
+	vec3 fp3 = fract(p3);
+	fp3 = fp3 * fp3 * (3.0 - 2.0 * fp3);
+
+	float k000 = DM_hash(ip3 + 137.0);
+	float k100 = DM_hash(ip3 + vec3(1, 0, 0) + 137.0);
+	float k010 = DM_hash(ip3 + vec3(0, 1, 0) + 137.0);
+	float k110 = DM_hash(ip3 + vec3(1, 1, 0) + 137.0);
+	float k001 = DM_hash(ip3 + vec3(0, 0, 1) + 137.0);
+	float k101 = DM_hash(ip3 + vec3(1, 0, 1) + 137.0);
+	float k011 = DM_hash(ip3 + vec3(0, 1, 1) + 137.0);
+	float k111 = DM_hash(ip3 + vec3(1, 1, 1) + 137.0);
+
+	float n3 = mix(
+		mix(mix(k000, k100, fp3.x), mix(k010, k110, fp3.x), fp3.y),
+		mix(mix(k001, k101, fp3.x), mix(k011, k111, fp3.x), fp3.y),
+		fp3.z
+	);
+
+	// Blend octaves: base dominates, detail breaks up edges, fine adds speckling
+	n = n * 0.55 + n2 * 0.30 + n3 * 0.15;
+
+	// Contrast curve: exponent controls how "particle-like" vs "hazy" the result is.
+	// Linear mix keeps the range in [10.0, 2.0] so even the sharpest
+	// setting produces visible specks (old formula 8/SIZE went to pow 27
+	// at SIZE=0.3 which was invisible).
+	//
+	// SIZE 0.1: exponent ~10.0 -> sparse sharp specks (top ~10% visible)
+	// SIZE 1.0: exponent ~6.9  -> individual particles (top ~25% visible)
+	// SIZE 2.0: exponent ~3.5  -> dusty clusters
+	// SIZE 3.0: exponent ~2.0  -> soft haze
+	float exponent = mix(10.0, 2.0, clamp((DUST_MOTES_SIZE - 0.1) / 2.9, 0.0, 1.0));
+	n = pow(n, exponent);
+
+	return n;
+}
+
+#endif // DUST_MOTES
diff --git a/shaders/Lib/IndividualFunctions/LutGrading.glsl b/shaders/Lib/IndividualFunctions/LutGrading.glsl
new file mode 100644
index 0000000..89b80ab
--- /dev/null
+++ b/shaders/Lib/IndividualFunctions/LutGrading.glsl
@@ -0,0 +1,114 @@
+vec3 ApplyTimeAwareGrading(vec3 color, float luminance){
+	#ifdef TIME_AWARE_GRADING
+		vec3 worldSunVector = shadowModelViewInverse2 * fsign(0.5 - sunAngle);
+		float sunHeight = worldSunVector.y;
+
+		float dayWeight = smoothstep(0.16, 0.42, sunHeight);
+		float nightWeight = 1.0 - smoothstep(-0.10, 0.03, sunHeight);
+		float goldenWeight = smoothstep(-0.10, 0.05, sunHeight) * (1.0 - smoothstep(0.10, 0.28, sunHeight));
+		float blueHourWeight = smoothstep(-0.14, 0.01, sunHeight) * (1.0 - smoothstep(0.04, 0.18, sunHeight));
+		blueHourWeight *= 1.0 - goldenWeight * 0.55;
+
+		#if TIME_GRADE_STYLE == 1
+			vec3 debugTint = vec3(1.0);
+			debugTint = mix(debugTint, TINT_DAY, dayWeight);
+			debugTint = mix(debugTint, TINT_GOLDEN_HOUR, goldenWeight);
+			debugTint = mix(debugTint, TINT_BLUE_HOUR, blueHourWeight);
+			debugTint = mix(debugTint, TINT_NIGHT, nightWeight);
+			return mix(color, color * debugTint, TIME_GRADE_STRENGTH);
+		#else
+			float highlightWeight = curve(saturate(luminance * 1.65 - 0.55));
+			float shadowWeight = curve(saturate(0.62 - luminance * 1.1));
+			float midWeight = saturate(1.0 - highlightWeight - shadowWeight * 0.75);
+
+			vec3 graded = color;
+
+			vec3 dayGrade = graded;
+			dayGrade *= mix(vec3(1.0), GRADE_DAY_HIGHLIGHT, highlightWeight * 0.35 + midWeight * 0.15);
+			dayGrade = mix(dayGrade, vec3(luminance), 0.04);
+			graded = mix(graded, dayGrade, dayWeight * 0.55);
+
+			vec3 goldenGrade = graded;
+			goldenGrade *= mix(vec3(1.0), GRADE_GOLDEN_HI, highlightWeight * 0.9 + midWeight * 0.45);
+			goldenGrade *= mix(vec3(1.0), GRADE_GOLDEN_SH, shadowWeight * 0.3);
+			goldenGrade = mix(vec3(luminance), goldenGrade, 1.12);
+			graded = mix(graded, goldenGrade, goldenWeight * 0.9);
+
+			vec3 blueHourGrade = graded;
+			blueHourGrade *= mix(vec3(1.0), GRADE_BLUE_SH, shadowWeight * 0.95 + midWeight * 0.35);
+			blueHourGrade *= mix(vec3(1.0), vec3(0.97, 1.0, 1.05), highlightWeight * 0.25);
+			blueHourGrade = mix(blueHourGrade, vec3(luminance), 0.08);
+			graded = mix(graded, blueHourGrade, blueHourWeight * 0.8);
+
+			vec3 nightGrade = graded;
+			nightGrade *= mix(vec3(1.0), GRADE_NIGHT_SH, shadowWeight * 1.1 + midWeight * 0.4);
+			nightGrade *= mix(vec3(1.0), vec3(0.95, 0.98, 1.05), highlightWeight * 0.3);
+			nightGrade = mix(nightGrade, vec3(luminance), 0.22 + shadowWeight * 0.12);
+			nightGrade *= 1.0 - shadowWeight * 0.08;
+			graded = mix(graded, nightGrade, nightWeight * 0.95);
+
+			return mix(color, graded, TIME_GRADE_STRENGTH);
+		#endif
+	#else
+		return color;
+	#endif
+}
+
+vec3 SampleLutTexel(sampler2D lutSampler, vec3 indexCoord) {
+	const float size = 32.0;
+	const float width = 1024.0;
+
+	vec2 uv = vec2(
+		(indexCoord.z * size + indexCoord.x + 0.5) / width,
+		(indexCoord.y + 0.5) / size
+	);
+
+	return textureLod(lutSampler, uv, 0.0).rgb;
+}
+
+vec3 ManualSampleLut(sampler2D lutSampler, vec3 color) {
+	vec3 lookupColor = saturate(color);
+	const float size = 32.0;
+
+	vec3 coord = lookupColor * (size - 1.0);
+	vec3 c0 = floor(coord);
+	vec3 c1 = min(c0 + 1.0, vec3(size - 1.0));
+	vec3 f = fract(coord);
+
+	vec3 c000 = SampleLutTexel(lutSampler, vec3(c0.x, c0.y, c0.z));
+	vec3 c100 = SampleLutTexel(lutSampler, vec3(c1.x, c0.y, c0.z));
+	vec3 c010 = SampleLutTexel(lutSampler, vec3(c0.x, c1.y, c0.z));
+	vec3 c110 = SampleLutTexel(lutSampler, vec3(c1.x, c1.y, c0.z));
+	vec3 c001 = SampleLutTexel(lutSampler, vec3(c0.x, c0.y, c1.z));
+	vec3 c101 = SampleLutTexel(lutSampler, vec3(c1.x, c0.y, c1.z));
+	vec3 c011 = SampleLutTexel(lutSampler, vec3(c0.x, c1.y, c1.z));
+	vec3 c111 = SampleLutTexel(lutSampler, vec3(c1.x, c1.y, c1.z));
+
+	vec3 x00 = mix(c000, c100, f.x);
+	vec3 x10 = mix(c010, c110, f.x);
+	vec3 x01 = mix(c001, c101, f.x);
+	vec3 x11 = mix(c011, c111, f.x);
+
+	vec3 y0 = mix(x00, x10, f.y);
+	vec3 y1 = mix(x01, x11, f.y);
+
+	return mix(y0, y1, f.z);
+}
+
+vec3 ApplyInjectedLut(vec3 color){
+	float strength = LUT_STRENGTH;
+	#ifdef HDR_ENABLED
+		strength *= saturate(1.0 - (Luminance(color) - 1.0) * 10.0);
+	#endif
+	#if LUT_PROFILE == 1
+		return mix(color, ManualSampleLut(lutSlot1_2D, color), strength);
+	#elif LUT_PROFILE == 2
+		return mix(color, ManualSampleLut(lutSlot2_2D, color), strength);
+	#elif LUT_PROFILE == 3
+		return mix(color, ManualSampleLut(lutSlot3_2D, color), strength);
+	#elif LUT_PROFILE == 4
+		return mix(color, ManualSampleLut(lutSlot4_2D, color), strength);
+	#else
+		return color;
+	#endif
+}
