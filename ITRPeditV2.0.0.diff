+    p.rs_sa = 0.2;
+    p.pt_lml = 0.15; p.pt_lml_r = 0.0; p.pt_lml_g = 0.0; p.pt_lml_b = 0.0;
+    p.pt_lmh = 0.0; p.pt_lmh_r = 0.0; p.pt_lmh_b = 0.0;
+    p.ptm_low = 0.25; p.ptm_low_rng = 0.25; p.ptm_low_st = 0.8;
+    p.ptm_high_rng = 0.6; p.ptm_high_st = 0.25;
+    p.brl = -2.0; p.brl_r = -2.0; p.brl_g = -2.0;
+    p.brl_rng = 0.35; p.brl_st = 0.35;
+    p.brlp = 0.0; p.brlp_r = -1.0; p.brlp_g = -1.0; p.brlp_b = -1.0;
+    p.ptl_c = 0.05; p.ptl_y = 0.05;
+    p.hc_r_rng = 0.25;
+    p.hs_r = 0.7; p.hs_r_rng = 1.33; p.hs_g = 1.0; p.hs_g_rng = 2.0;
+    p.hs_b = 0.75; p.hs_b_rng = 2.0;
+    p.hs_c = 1.0; p.hs_c_rng = 0.5; p.hs_m = 1.0; p.hs_y = 1.0; p.hs_y_rng = 0.765;
+    return p;
+}
+
+OpenDRTParams opendrt_preset_umbra() {
+    OpenDRTParams p = opendrt_preset_default();
+    p.tn_con = 1.8; p.tn_toe = 0.001; p.tn_off = 0.015;
+    p.tn_lcon_enable = true; p.tn_lcon = 1.0; p.tn_lcon_w = 1.0;
+    p.cwp = 5;
+    p.pt_lml = 0.0; p.pt_lml_r = 0.5; p.pt_lml_b = 0.15;
+    p.pt_lmh_r = 0.25;
+    p.ptl_c = 0.05; p.ptl_m = 0.06; p.ptl_y = 0.05;
+    p.ptm_low = 0.4; p.ptm_low_rng = 0.35; p.ptm_low_st = 0.66;
+    p.ptm_high = -0.6; p.ptm_high_rng = 0.45; p.ptm_high_st = 0.45;
+    p.brl = -2.0; p.brl_r = -4.5; p.brl_g = -3.0; p.brl_b = -4.0;
+    p.brl_rng = 0.35; p.brl_st = 0.3;
+    p.brlp = 0.0; p.brlp_r = -2.0; p.brlp_g = -1.0; p.brlp_b = -0.5;
+    p.hc_r_rng = 0.35;
+    p.hs_r = 0.66; p.hs_r_rng = 1.0; p.hs_g = 0.5; p.hs_g_rng = 2.0;
+    p.hs_b = 0.85; p.hs_b_rng = 2.0;
+    p.hs_c = 0.0; p.hs_m = 0.25; p.hs_y = 0.66; p.hs_y_rng = 0.66;
+    return p;
+}
+
+// Main OpenDRT transform
+vec3 opendrt_transform(vec3 rgb, OpenDRTParams p) {
+
+    // Tonescale constraint calculations
+    float ts_x1 = pow(2.0, 6.0 * p.tn_sh + 4.0);
+    float ts_y1 = p.tn_Lp / 100.0;
+    float ts_x0 = 0.18 + p.tn_off;
+    float ts_y0 = p.tn_Lg / 100.0 * (1.0 + p.tn_gb * (log(ts_y1) / log(2.0)));
+    float ts_s0 = opendrt_compress_toe_quadratic_inv(ts_y0, p.tn_toe);
+    float ts_p = p.tn_con / (1.0 + float(p.tn_su) * 0.05);
+    float ts_s10 = ts_x0 * (pow(max(ts_s0, 1e-10), -1.0 / p.tn_con) - 1.0);
+    float ts_m1 = ts_y1 / opendrt_spowf(ts_x1 / (ts_x1 + ts_s10), p.tn_con);
+    float ts_m2 = opendrt_compress_toe_quadratic_inv(ts_m1, p.tn_toe);
+    float ts_s = ts_x0 * (opendrt_spowf(ts_s0 / max(ts_m2, 1e-10), -1.0 / p.tn_con) - 1.0);
+    float ts_dsc = 100.0 / p.tn_Lp;
+
+    float pt_cmp_Lf = p.pt_hdr * min(1.0, (p.tn_Lp - 100.0) / 900.0);
+    float s_Lp100 = ts_x0 * (opendrt_spowf(p.tn_Lg / 100.0, -1.0 / p.tn_con) - 1.0);
+    float ts_s1 = ts_s * pt_cmp_Lf + s_Lp100 * (1.0 - pt_cmp_Lf);
+
+    // Convert from linear Rec709 to P3-D65
+    rgb = OPENDRT_MAT_REC709_TO_P3D65 * rgb;
+
+    // Render space desaturation
+    vec3 rs_w = vec3(p.rs_rw, 1.0 - p.rs_rw - p.rs_bw, p.rs_bw);
+    float sat_L = dot(rgb, rs_w);
+    rgb = sat_L * p.rs_sa + rgb * (1.0 - p.rs_sa);
+
+    // Offset
+    rgb += p.tn_off;
+
+    // Tonescale norm and RGB ratios
+    float tsn = length(rgb) / OPENDRT_SQRT3;
+    rgb = vec3(tsn == 0.0 ? 0.0 : rgb.x / tsn, tsn == 0.0 ? 0.0 : rgb.y / tsn, tsn == 0.0 ? 0.0 : rgb.z / tsn);
+
+    vec2 opp = opendrt_opponent(rgb);
+    float ach_d = length(opp) / 2.0;
+    ach_d = 1.25 * opendrt_compress_toe_quadratic(ach_d, 0.25);
+
+    float hue = mod(atan(opp.x, opp.y) + OPENDRT_PI + 1.10714931, 2.0 * OPENDRT_PI);
+
+    vec3 ha_rgb = vec3(
+        opendrt_gauss_window(opendrt_hue_offset(hue, 0.1), 0.66),
+        opendrt_gauss_window(opendrt_hue_offset(hue, 4.3), 0.66),
+        opendrt_gauss_window(opendrt_hue_offset(hue, 2.3), 0.66)
+    );
+
+    vec3 ha_rgb_hs = vec3(
+        opendrt_gauss_window(opendrt_hue_offset(hue, -0.4), 0.66),
+        ha_rgb.y,
+        opendrt_gauss_window(opendrt_hue_offset(hue, 2.5), 0.66)
+    );
+
+    vec3 ha_cmy = vec3(
+        opendrt_gauss_window(opendrt_hue_offset(hue, 3.3), 0.5),
+        opendrt_gauss_window(opendrt_hue_offset(hue, 1.3), 0.5),
+        opendrt_gauss_window(opendrt_hue_offset(hue, -1.15), 0.5)
+    );
+
+    // Brilliance (pre-tonescale)
+    if (p.brl_enable) {
+        float brl_tsf = opendrt_spowf(tsn / (tsn + 1.0), 1.0 - p.brl_rng);
+        float brl_exf = (p.brl + p.brl_r * ha_rgb.x + p.brl_g * ha_rgb.y + p.brl_b * ha_rgb.z) *
+                        opendrt_spowf(ach_d, 1.0 / p.brl_st);
+        float brl_ex = pow(2.0, brl_exf * (brl_exf < 0.0 ? brl_tsf : 1.0 - brl_tsf));
+        tsn *= brl_ex;
+    }
+
+    // Contrast low
+    if (p.tn_lcon_enable) {
+        float lcon_m = pow(2.0, -p.tn_lcon);
+        float lcon_w = p.tn_lcon_w / 4.0;
+        lcon_w *= lcon_w;
+        float lcon_cnst_sc;
+        if (lcon_m == 1.0) {
+            lcon_cnst_sc = 1.0;
+        } else {
+            float _x2 = ts_x0 * ts_x0;
+            float _p0 = _x2 - 3.0 * lcon_m * lcon_w;
+            float _p1 = 2.0 * _x2 + 27.0 * lcon_w - 9.0 * lcon_m * lcon_w;
+            float _p2 = pow(sqrt(_x2 * _p1 * _p1 - 4.0 * _p0 * _p0 * _p0) / 2.0 + ts_x0 * _p1 / 2.0, 1.0 / 3.0);
+            lcon_cnst_sc = (_p0 / (3.0 * _p2) + _p2 / 3.0 + ts_x0 / 3.0) / ts_x0;
+        }
+        tsn *= lcon_cnst_sc;
+        if (lcon_m != 1.0)
+            tsn = tsn * (tsn * tsn + lcon_m * lcon_w) / (tsn * tsn + lcon_w);
+    }
+
+    // Contrast high
+    if (p.tn_hcon_enable) {
+        float hcon_p = pow(2.0, p.tn_hcon);
+        float _x0_c = 0.18 * pow(2.0, p.tn_hcon_pv);
+        if (tsn >= _x0_c && hcon_p != 1.0) {
+            float _o = _x0_c - _x0_c / hcon_p;
+            float _s0 = pow(_x0_c, 1.0 - hcon_p) / hcon_p;
+            float _x1 = _x0_c * pow(2.0, p.tn_hcon_st);
+            float _k1 = hcon_p * _s0 * pow(_x1, hcon_p) / _x1;
+            float _y1 = _s0 * pow(_x1, hcon_p) + _o;
+            if (tsn > _x1)
+                tsn = _k1 * (tsn - _x1) + _y1;
+            else
+                tsn = _s0 * pow(tsn, hcon_p) + _o;
+        }
+    }
+
+    // Hyperbolic compression
+    float tsn_pt = opendrt_compress_hyperbolic_power(tsn, ts_s1, ts_p);
+    float tsn_const = opendrt_compress_hyperbolic_power(tsn, s_Lp100, ts_p);
+    tsn = opendrt_compress_hyperbolic_power(tsn, ts_s, ts_p);
+
+    // Hue contrast R
+    if (p.hc_enable) {
+        float hc_ts = 1.0 - tsn_const;
+        float hc_c = hc_ts * (1.0 - ach_d) + ach_d * (1.0 - hc_ts);
+        hc_c *= ach_d * ha_rgb.x;
+        hc_ts = opendrt_spowf(hc_ts, 1.0 / p.hc_r_rng);
+        float hc_f = p.hc_r * (hc_c - 2.0 * hc_c * hc_ts) + 1.0;
+        rgb = vec3(rgb.x, rgb.y * hc_f, rgb.z * hc_f);
+    }
+
+    // Hue shift RGB
+    if (p.hs_rgb_enable) {
+        vec3 hs_rgb = vec3(
+            ha_rgb_hs.x * ach_d * opendrt_spowf(tsn_pt, 1.0 / p.hs_r_rng),
+            ha_rgb_hs.y * ach_d * opendrt_spowf(tsn_pt, 1.0 / p.hs_g_rng),
+            ha_rgb_hs.z * ach_d * opendrt_spowf(tsn_pt, 1.0 / p.hs_b_rng)
+        );
+        vec3 hsf = vec3(hs_rgb.x * p.hs_r, hs_rgb.y * -p.hs_g, hs_rgb.z * -p.hs_b);
+        hsf = vec3(hsf.z - hsf.y, hsf.x - hsf.z, hsf.y - hsf.x);
+        rgb += hsf;
+    }
+
+    // Hue shift CMY
+    if (p.hs_cmy_enable) {
+        float tsn_pt_compl = 1.0 - tsn_pt;
+        vec3 hs_cmy = vec3(
+            ha_cmy.x * ach_d * opendrt_spowf(tsn_pt_compl, 1.0 / p.hs_c_rng),
+            ha_cmy.y * ach_d * opendrt_spowf(tsn_pt_compl, 1.0 / p.hs_m_rng),
+            ha_cmy.z * ach_d * opendrt_spowf(tsn_pt_compl, 1.0 / p.hs_y_rng)
+        );
+        vec3 hsf = vec3(hs_cmy.x * -p.hs_c, hs_cmy.y * p.hs_m, hs_cmy.z * p.hs_y);
+        hsf = vec3(hsf.z - hsf.y, hsf.x - hsf.z, hsf.y - hsf.x);
+        rgb += hsf;
+    }
+
+    // Purity compression
+    float pt_lml_p = 1.0 + 4.0 * (1.0 - tsn_pt) *
+                     (p.pt_lml + p.pt_lml_r * ha_rgb_hs.x + p.pt_lml_g * ha_rgb_hs.y + p.pt_lml_b * ha_rgb_hs.z);
+    float ptf = 1.0 - opendrt_spowf(tsn_pt, pt_lml_p);
+    float pt_lmh_p = (1.0 - ach_d * (p.pt_lmh_r * ha_rgb_hs.x + p.pt_lmh_b * ha_rgb_hs.z)) *
+                     (1.0 - p.pt_lmh * ach_d);
+    ptf = opendrt_spowf(ptf, pt_lmh_p);
+
+    // Mid-range purity
+    if (p.ptm_enable) {
+        float ptm_low_f = 1.0;
+        if (p.ptm_low_st != 0.0 && p.ptm_low_rng != 0.0)
+            ptm_low_f = 1.0 + p.ptm_low * exp(-2.0 * ach_d * ach_d / p.ptm_low_st) *
+                               opendrt_spowf(1.0 - tsn_const, 1.0 / p.ptm_low_rng);
+        float ptm_high_f = 1.0;
+        if (p.ptm_high_st != 0.0 && p.ptm_high_rng != 0.0)
+            ptm_high_f = 1.0 + p.ptm_high * exp(-2.0 * ach_d * ach_d / p.ptm_high_st) *
+                               opendrt_spowf(tsn_pt, 1.0 / (4.0 * p.ptm_high_rng));
+        ptf *= ptm_low_f * ptm_high_f;
+    }
+
+    // Lerp to peak achromatic by ptf in rgb ratios
+    rgb = rgb * ptf + 1.0 - ptf;
+
+    // Inverse render space
+    sat_L = dot(rgb, rs_w);
+    rgb = (sat_L * p.rs_sa - rgb) / (p.rs_sa - 1.0);
+
+    // Display gamut (Rec709) and creative whitepoint
+    {
+        vec3 _cwp_neutral = OPENDRT_MAT_P3D65_TO_XYZ * rgb;
+        float _cwp_f = opendrt_spowf(tsn_const, 2.0 * p.cwp_lm);
+        rgb = _cwp_neutral;
+        if (p.cwp == 0) rgb = OPENDRT_MAT_D65_TO_D93 * _cwp_neutral;
+        else if (p.cwp == 1) rgb = OPENDRT_MAT_D65_TO_D75 * _cwp_neutral;
+        else if (p.cwp == 3) rgb = OPENDRT_MAT_D65_TO_D60 * _cwp_neutral;
+        else if (p.cwp == 4) rgb = OPENDRT_MAT_D65_TO_D55 * _cwp_neutral;
+        else if (p.cwp == 5) rgb = OPENDRT_MAT_D65_TO_D50 * _cwp_neutral;
+        rgb = rgb * _cwp_f + _cwp_neutral * (1.0 - _cwp_f);
+        rgb = OPENDRT_MAT_XYZ_TO_REC709 * rgb;
+        rgb *= OPENDRT_CWP_REC709[p.cwp] * _cwp_f + 1.0 - _cwp_f;
+    }
+
+    // Post brilliance
+    if (p.brlp_enable) {
+        vec2 brlp_opp = opendrt_opponent(rgb);
+        float brlp_ach_d = length(brlp_opp) / 4.0;
+        brlp_ach_d = 1.1 * (brlp_ach_d * brlp_ach_d / (brlp_ach_d + 0.1));
+        vec3 brlp_ha_rgb = ach_d * ha_rgb;
+        float brlp_m = p.brlp + p.brlp_r * brlp_ha_rgb.x + p.brlp_g * brlp_ha_rgb.y + p.brlp_b * brlp_ha_rgb.z;
+        float brlp_ex = pow(2.0, brlp_m * brlp_ach_d * tsn);
+        rgb *= brlp_ex;
+    }
+
+    // Purity softclip
+    if (p.ptl_enable) {
+        vec3 ptl_s = vec3(p.ptl_c, p.ptl_m, p.ptl_y);
+        vec3 ptl_r = ptl_s * log(max(vec3(0.0), 1.0 + exp(rgb / ptl_s)));
+        rgb = mix(ptl_r, rgb, max(vec3(greaterThan(rgb, 10.0 * ptl_s)), vec3(lessThan(ptl_s, vec3(1e-4)))));
+    }
+
+    // Final tonescale adjustments
+    tsn *= ts_m2;
+    tsn = opendrt_compress_toe_quadratic(tsn, p.tn_toe);
+    tsn *= ts_dsc;
+
+    // Return from RGB ratios
+    rgb *= tsn;
+
+    return rgb;
+}
diff --git a/shaders/Lib/Programs/Composite/ImageConvolveIFFT_CS.glsl b/shaders/Lib/Programs/Composite/ImageConvolveIFFT_CS.glsl
new file mode 100644
index 0000000..f150272
--- /dev/null
+++ b/shaders/Lib/Programs/Composite/ImageConvolveIFFT_CS.glsl
@@ -0,0 +1,105 @@
+// by huj31415
+
+// unpack image and kernel spectra and complex multiply
+// ifft and save to image
+
+#include "/Lib/UniformDeclare.glsl"
+#include "/Lib/Utilities.glsl"
+
+#include "/Lib/BasicFunctions/FFT.glsl"
+
+// N rows, N/4 threads per row
+const ivec3 workGroups = ivec3(1, FFT_SIZE, 1);
+layout (local_size_x = N_4_1, local_size_y = 1) in;
+
+#define IFFT
+
+#ifdef ROW
+// Row pass ===================================================================
+
+layout (rgba32f) uniform image2D kerFFT;
+layout (rgba32f) uniform image2D imgFFT;
+layout (rgba32f) uniform writeonly image2D tmpFFT;
+
+vec4 freqConvolve(ivec2 coord) {
+  if (coord.x >= FFT_SIZE || coord.y >= FFT_SIZE) return vec4(0.0);
+
+  // get symmetric coordinate -k = (N - x) % N
+  ivec2 symCoord = (ivec2(FFT_SIZE) - coord) & ivec2(FFT_SIZE - 1); // Modulo using bitwise AND for power-of-two sizes
+
+  // fetch current and symmetric samples for both image and kernel
+
+  // unpack and convolve, 0.5 factored out and applied at end
+  vec4 h_img    = imageLoad(imgFFT, coord);
+  vec4 h_imgSym = imageLoad(imgFFT, symCoord);
+  vec4 h_ker    = imageLoad(kerFFT, coord);
+  vec4 h_kerSym = imageLoad(kerFFT, symCoord);
+  
+  vec2 F_R = vec2(h_img.x + h_imgSym.x, h_img.y - h_imgSym.y);
+  vec2 K_R = vec2(h_ker.x + h_kerSym.x, h_ker.y - h_kerSym.y);
+  vec2 Out_R = cmul(F_R, K_R);
+
+  vec2 F_G = vec2(h_img.y + h_imgSym.y, h_imgSym.x - h_img.x);
+  vec2 K_G = vec2(h_ker.y + h_kerSym.y, h_kerSym.x - h_ker.x);
+  vec2 Out_G = cmul(F_G, K_G);
+
+  vec2 F_B = vec2(h_img.z + h_imgSym.z, h_img.w - h_imgSym.w);
+  vec2 K_B = vec2(h_ker.z + h_kerSym.z, h_ker.y - h_kerSym.y);
+  vec2 Out_B = cmul(F_B, K_B);
+
+  vec2 F_A = vec2(h_img.w + h_imgSym.w, h_imgSym.z - h_img.z);
+  vec2 K_A = vec2(h_ker.w + h_kerSym.w, h_kerSym.z - h_ker.z);
+  vec2 Out_A = cmul(F_A, K_A);
+
+  // repack into rgba for ifft
+  return 0.25 * vec4(
+    Out_R.x - Out_G.y,
+    Out_R.y + Out_G.x,
+    Out_B.x - Out_A.y,
+    Out_B.y + Out_A.x
+  );
+}
+
+
+
+void main() {
+  uint y = gl_GlobalInvocationID.y;
+  uint x = gl_GlobalInvocationID.x;
+
+  vec4 t0 = freqConvolve(ivec2(x, y));
+  vec4 t1 = freqConvolve(ivec2(x + N_4_1, y));
+  vec4 t2 = freqConvolve(ivec2(x + N_4_2, y));
+  vec4 t3 = freqConvolve(ivec2(x + N_4_3, y));
+
+  rgbaRowFFT(y, x, t0, t1, t2, t3);
+
+  imageStore(tmpFFT, ivec2(y, x), t0);
+  imageStore(tmpFFT, ivec2(y, x + N_4_1), t1);
+  imageStore(tmpFFT, ivec2(y, x + N_4_2), t2);
+  imageStore(tmpFFT, ivec2(y, x + N_4_3), t3);
+}
+
+#else
+// Column pass ================================================================
+
+layout (rgba32f) uniform image2D tmpFFT;
+layout (rgba32f) uniform writeonly image2D imgFFT;
+
+void main() {
+  uint y = gl_GlobalInvocationID.y;
+  uint x = gl_GlobalInvocationID.x;
+
+  vec4 t0 = imageLoad(tmpFFT, ivec2(x, y));
+  vec4 t1 = imageLoad(tmpFFT, ivec2(x + N_4_1, y));
+  vec4 t2 = imageLoad(tmpFFT, ivec2(x + N_4_2, y));
+  vec4 t3 = imageLoad(tmpFFT, ivec2(x + N_4_3, y));
+
+  rgbaRowFFT(y, x, t0, t1, t2, t3);
+
+  imageStore(imgFFT, ivec2(y, x), t0 * NORM);
+  imageStore(imgFFT, ivec2(y, x + N_4_1), t1 * NORM);
+  imageStore(imgFFT, ivec2(y, x + N_4_2), t2 * NORM);
+  imageStore(imgFFT, ivec2(y, x + N_4_3), t3 * NORM);
+}
+
+#endif
\ No newline at end of file
diff --git a/shaders/Lib/Programs/Composite/ImageFFT_CS.glsl b/shaders/Lib/Programs/Composite/ImageFFT_CS.glsl
new file mode 100644
index 0000000..f1f5589
--- /dev/null
+++ b/shaders/Lib/Programs/Composite/ImageFFT_CS.glsl
@@ -0,0 +1,95 @@
+// by huj31415
+
+// run once per frame
+// compute FFT of image and write to image
+
+#include "/Lib/UniformDeclare.glsl"
+#include "/Lib/Utilities.glsl"
+
+#include "/Lib/BasicFunctions/FFT.glsl"
+
+// N rows, N/4 threads per row
+const ivec3 workGroups = ivec3(1, FFT_SIZE, 1);
+layout (local_size_x = N_4_1, local_size_y = 1) in;
+
+#ifdef ROW
+// Row pass ===================================================================
+
+// FBTEX_MAIN_OUTPUT already declared in UniformDeclare.glsl
+layout (rgba32f) uniform writeonly image2D tmpFFT;
+
+float GetExposureValue(){
+	return texelFetch(pixelData2D, ivec2(PIXELDATA_EXPOSURE, 0), 0).y;
+}
+
+#ifdef CAP_LUMINANCE
+  const float maxLuminance = float(1 << CAP_LUMINANCE);
+#endif
+
+// soft knee thresholding
+vec4 softKnee(vec4 color) {
+  float l = Luminance(color.rgb);
+  float x = max(0, l - BLOOM_THRESHOLD + BLOOM_KNEE);
+  color.rgb *= mix(x * x / (4 * BLOOM_KNEE), max(0, l - BLOOM_THRESHOLD), float(x > BLOOM_THRESHOLD + BLOOM_KNEE)) / max(l, 1e-6);
+  #ifdef CAP_LUMINANCE
+    color *= min(1.0, maxLuminance / l);
+  #endif
+  return color;
+}
+
+// downsample and pad scene texture into the FFT workspace with correct aspect ratio
+vec4 sampleThresholdedSceneTex(uint x, uint y) {
+  float maxDim = float(FFT_SIZE - KERNEL_SIZE);
+  vec2 size = aspectRatio >= 1.0 ? vec2(maxDim, maxDim / aspectRatio) : vec2(maxDim * aspectRatio, maxDim);
+  // zero pad outside valid image region
+  if (any(greaterThanEqual(vec2(x, y), size))) {
+    return vec4(0.0);
+  }
+
+  // map thread coordinates to uv
+  vec2 uv = (vec2(x, y) + 0.5) / size;
+
+  return softKnee(textureLod(FBTEX_MAIN_OUTPUT, uv, 0) * GetExposureValue());
+}
+
+void main() {
+  uint y = gl_GlobalInvocationID.y;
+  uint x = gl_GlobalInvocationID.x;
+
+  vec4 t0 = sampleThresholdedSceneTex(x, y);
+  vec4 t1 = sampleThresholdedSceneTex(x + N_4_1, y);
+  vec4 t2 = sampleThresholdedSceneTex(x + N_4_2, y);
+  vec4 t3 = sampleThresholdedSceneTex(x + N_4_3, y);
+
+  rgbaRowFFT(y, x, t0, t1, t2, t3);
+
+  imageStore(tmpFFT, ivec2(y, x),         t0);
+  imageStore(tmpFFT, ivec2(y, x + N_4_1), t1);
+  imageStore(tmpFFT, ivec2(y, x + N_4_2), t2);
+  imageStore(tmpFFT, ivec2(y, x + N_4_3), t3);
+}
+
+#else
+// Column pass ================================================================
+
+layout (rgba32f) uniform image2D tmpFFT;
+layout (rgba32f) uniform writeonly image2D imgFFT;
+
+void main() {
+  uint y = gl_GlobalInvocationID.y;
+  uint x = gl_GlobalInvocationID.x;
+
+  vec4 t0 = imageLoad(tmpFFT, ivec2(x, y));
+  vec4 t1 = imageLoad(tmpFFT, ivec2(x + N_4_1, y));
+  vec4 t2 = imageLoad(tmpFFT, ivec2(x + N_4_2, y));
+  vec4 t3 = imageLoad(tmpFFT, ivec2(x + N_4_3, y));
+
+  rgbaRowFFT(y, x, t0, t1, t2, t3);
+
+  imageStore(imgFFT, ivec2(y, x),         t0 * NORM);
+  imageStore(imgFFT, ivec2(y, x + N_4_1), t1 * NORM);
+  imageStore(imgFFT, ivec2(y, x + N_4_2), t2 * NORM);
+  imageStore(imgFFT, ivec2(y, x + N_4_3), t3 * NORM);
+}
+
+#endif
