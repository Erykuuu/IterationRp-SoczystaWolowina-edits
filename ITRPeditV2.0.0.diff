+	state.targetCoverage = 0.5;
+	state.thicknessMul = 1.0;
+	state.densityMul = 1.0;
+	state.landScatteringStrength = LANDSCATTERING_STRENGTH;
+
+	// Keep cloud-shadow sampling on the same animation clock as the visible cloud field.
+	float wind = 0.0005 * (CLOUD_ANIM_TIME * CLOUD_SPEED + 10.0 * FTC_OFFSET);
+	state.windOffset = vec3(1.0, wetness * 0.1 - 0.05, -0.4) * wind;
+
+	return state;
+}
