+vec3 getEyeFlare(vec2 coord, vec3 sunScreen, vec2 centerVec, vec2 fromSun) {
+    vec3 flare = vec3(0.0);
+    vec2 aspectVec = vec2(viewWidth / viewHeight, 1.0);
+    vec2 circularFromSun = fromSun * aspectVec;
+    float dist = length(circularFromSun);
+    if (dist < 1e-5) return vec3(0.0);
+
+    // Subtle chromatic diffraction ring
+    float ringRadius = 0.26;
+    float rR = exp(-abs(dist - ringRadius * 0.96) * 60.0);
+    float rG = exp(-abs(dist - ringRadius * 1.00) * 60.0);
+    float rB = exp(-abs(dist - ringRadius * 1.04) * 60.0);
+    vec3 diffractionRing = vec3(rR, rG, rB) * 0.08;
+
+    // Ciliary Spikes (wet, organic, spiky starburst)
+    float angle = atan(circularFromSun.y, circularFromSun.x);
+    // Movement based on camera center distance (so it shifts as you look around)
+    float camShift = length(centerVec) * 4.0 + float(frameCounter) * 0.002;
+    
+    // Organic radial noise
+    float p1 = sin(angle * 12.0 + camShift);
+    float p2 = sin(angle * 28.0 - camShift * 1.5);
+    float p3 = sin(angle * 54.0 + camShift * 0.5);
+    float spikes = max(0.0, p1 * 0.4 + p2 * 0.3 + p3 * 0.3);
+    spikes = pow(spikes, 3.0); // Sharpen spikes
+
+    // Add some high-frequency jitter
+    float jitter = fract(sin(floor(angle * 100.0) * 12.9898) * 43758.5453) * 0.2;
+    
+    // Smoothly fade spikes based on distance
+    float starburst = (spikes + jitter) * exp(-dist * 18.0);
+
+    // Warm, organic tint for the eye glow
+    vec3 eyeTint = mix(vec3(1.0, 0.85, 0.7), vec3(1.0, 0.6, 0.4), saturate(dist * 5.0));
+
+    flare += diffractionRing * FLARE_BRIGHTNESS * 1.2;
+    flare += eyeTint * starburst * FLARE_BRIGHTNESS * 0.8;
+
+    return flare;
+}
+
+vec3 getCameraFlare(vec2 coord, vec3 sunScreen, vec2 centerVec, vec2 ghostAxis, vec2 fromSun, float bloomGuide) {
+    vec3 flare = vec3(0.0);
+    
+    // Cinematic ghost chain inspired by film-lens plugins:
+    // softer elliptical ghosts instead of hard concentric circles.
+    for (int i = 0; i < 5; i++){
+        float fi = float(i);
+        float offset = 0.14 + fi * 0.16;
+        vec2 ghostCenter = sunScreen.xy + centerVec * offset;
+        float ghostRadius = 0.012 + fi * 0.013;
+        float stretch = mix(1.35, 2.15, fi / 4.0);
+        vec2 blobRadius = vec2(ghostRadius * stretch, ghostRadius);
+
+        vec3 ghostColor = mix(vec3(1.0, 0.76, 0.56), vec3(0.58, 0.82, 1.0), fi / 4.0);
+        vec3 ghostBlob = GhostBlob(coord, ghostCenter, ghostAxis, blobRadius, ghostColor, 8.0 + fi * 6.0);
+
+        float core = EllipseMask(coord, ghostCenter, ghostAxis, blobRadius * 0.52) * 0.65;
+        float edge = EllipseMask(coord, ghostCenter, ghostAxis, blobRadius * 1.28) * 0.35;
+        flare += (ghostBlob + ghostColor * (core + edge) * 0.25) * FLARE_BRIGHTNESS * (0.85 + fi * 0.1);
+    }
+
+    // Cinematic anamorphic streak: strong horizontal signature, center-weighted.
+    float streakAxis = abs(fromSun.y);
+    float streakLength = abs(fromSun.x);
+    float streak = exp(-streakAxis * 210.0) * exp(-streakLength * 3.8);
+    streak += exp(-streakAxis * 320.0) * exp(-streakLength * 1.8) * 0.6;
+    vec3 streakColor = vec3(0.72, 0.82, 1.0) * 0.55 + vec3(1.0, 0.74, 0.56) * 0.45;
+    flare += streakColor * streak * (0.10 + bloomGuide * 0.14) * FLARE_BRIGHTNESS;
+
+    // Large blue lens arc similar to plugin-style cinematic flares.
+    vec2 arcCenter = sunScreen.xy + centerVec * 0.55;
+    float arcRadius = length(coord - arcCenter);
+    float arc = exp(-abs(arcRadius - 0.20) * 52.0);
+    float arcSoft = exp(-abs(arcRadius - 0.235) * 35.0) * 0.6;
+    vec2 arcDir = normalize(coord - arcCenter + vec2(1e-5));
+    float arcFacing = saturate(dot(arcDir, ghostAxis) * 0.6 + 0.55);
+    flare += vec3(0.22, 0.38, 1.0) * (arc + arcSoft) * arcFacing * FLARE_BRIGHTNESS * 0.9;
+
+    // Warm internal orb near source.
+    vec2 warmCenter = sunScreen.xy + centerVec * 0.12;
+    float warmOrb = EllipseMask(coord, warmCenter, ghostAxis, vec2(0.032, 0.018));
+    flare += vec3(1.0, 0.78, 0.36) * warmOrb * FLARE_BRIGHTNESS * 0.5;
+
+    // Subtle diffraction/starburst structure around the source.
+    float starburst = StarburstMask(coord, sunScreen.xy);
+    flare += vec3(1.0, 0.93, 0.86) * starburst * 0.06 * FLARE_BRIGHTNESS;
+
+    return flare;
+}
