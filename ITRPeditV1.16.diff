diff --git a/shaders/Lib/IndividualFunctions/Aurora.glsl b/shaders/Lib/IndividualFunctions/Aurora.glsl
new file mode 100644
index 0000000..ba8ff79
--- /dev/null
+++ b/shaders/Lib/IndividualFunctions/Aurora.glsl
@@ -0,0 +1,156 @@
+#ifndef INCLUDE_AURORA
+#define INCLUDE_AURORA
+
+#include "/Lib/Utilities.glsl"
+
+// Auroras by nimitz 2017 (twitter: @stormoid)
+// License Creative Commons Attribution-NonCommercial-ShareAlike 3.0 Unported License
+
+#define aurora_time frameTimeCounter
+
+mat2 aurora_mm2(in float a){float c = cos(a), s = sin(a);return mat2(c,s,-s,c);}
+mat2 aurora_m2 = mat2(0.95534, 0.29552, -0.29552, 0.95534);
+float aurora_tri(in float x){return clamp(abs(fract(x)-.5),0.01,0.49);}
+vec2 aurora_tri2(in vec2 p){return vec2(aurora_tri(p.x)+aurora_tri(p.y),aurora_tri(p.y+aurora_tri(p.x)));}
+
+float aurora_triNoise2d(in vec2 p, float spd)
+{
+    float z=1.8;
+    float z2=2.5;
+	float rz = 0.;
+    p *= aurora_mm2(p.x*0.06);
+    vec2 bp = p;
+	for (float i=0.; i<5.; i++ )
+	{
+        vec2 dg = aurora_tri2(bp*1.85)*.75;
+        dg *= aurora_mm2(aurora_time*spd);
+        p -= dg/z2;
+
+        bp *= 1.3;
+        z2 *= .45;
+        z *= .42;
+		p *= 1.21 + (rz-1.0)*.02;
+        
+        rz += aurora_tri(p.x+aurora_tri(p.y))*z;
+        p*= -aurora_m2;
+	}
+    return clamp(1./pow(rz*29., 1.3),0.,.55);
+}
+
+float aurora_hash21(in vec2 n){ return fract(sin(dot(n, vec2(12.9898, 4.1414))) * 43758.5453); }
+
+vec3 DrawAurora(vec3 worldDir) {
+    // Smoother horizon cut-off to avoid hard lines
+    float horizonFade = smoothstep(0.0, 0.2, worldDir.y);
+    if (horizonFade <= 0.0) return vec3(0.0);
+    
+    // User-specified origin
+    vec3 ro = vec3(0, 0, -6.7);
+    vec3 rd = worldDir;
+    
+    vec4 col = vec4(0);
+    vec4 avgCol = vec4(0);
+    
+    int preset = AURORA_COLOR_PRESET;
+    if (preset == 5) {
+        float daySeed = fract(tan(distance(vec2(float(worldDay) * 1.61803), vec2(float(worldDay) * 2.71828))) * 43758.5453);
+        preset = int(floor(daySeed * 5.0));
+    }
+
+    vec3 colorBase;
+    vec3 colorTop;
+
+    if (preset == 0) {
+        colorBase = vec3(0.05, 1.0, 0.4);
+        colorTop  = vec3(0.05, 0.4, 1.0);
+    } else if (preset == 1) {
+        colorBase = vec3(1.0, 0.05, 0.6);
+        colorTop  = vec3(0.3, 0.05, 1.0);
+    } else if (preset == 2) {
+        colorBase = vec3(0.05, 1.0, 0.3);
+        colorTop  = vec3(1.0, 0.05, 0.05);
+    } else if (preset == 3) {
+        colorBase = vec3(0.05, 1.0, 0.9);
+        colorTop  = vec3(1.0, 0.05, 0.9);
+    } else { // preset == 4
+        colorBase = vec3(0.3, 0.1, 1.0);
+        colorTop  = vec3(0.9, 0.05, 0.6);
+    }
+    
+    #ifdef PROGRAM_SKYIMAGE
+        vec2 ditherPos = vec2(gl_GlobalInvocationID.xy);
+    #else
+        vec2 ditherPos = gl_FragCoord.xy;
+    #endif
+
+    // Centralized mask for moonlight balance
+    float moonMask = smoothstep(0.0, 0.5, sunAngle) * (1.0 - smoothstep(0.5, 1.0, sunAngle));
+    float mask = (0.5 + 0.5 * moonMask);
+
+    for(float i=0.; i<32.; i++)
+    {
+        float of = 0.006*aurora_hash21(ditherPos)*smoothstep(0.,15., i);
+        float pt = ((0.8 + pow(i, 1.4) * 0.002) - ro.y) / (max(rd.y, 0.02));
+        pt -= of;
+    	vec3 bpos = ro + pt*rd;
+        vec2 p = bpos.zx;
+        
+        // Refined randomness - less aggressive warping
+        p += aurora_tri2(p * 0.04 + aurora_time * 0.001) * 3.0;
+        p *= aurora_mm2(sin(p.x * 0.015 + aurora_time * 0.005) * 0.3);
+        
+        float rzt = aurora_triNoise2d(p, 0.06);
+        
+        // Softer intensity mask to ensure visibility
+        float intensityMask = aurora_triNoise2d(p * 0.015, 0.002);
+        rzt *= smoothstep(0.05, 0.4, intensityMask + 0.1);
+        
+        // Sharp but vibrant trails
+        rzt = pow(max(rzt, 0.0), 1.6) * 2.2; 
+        
+        vec3 auroraColor = mix(colorBase, colorTop, i / 32.0);
+        vec4 col2 = vec4(auroraColor * rzt, rzt);
+        
+        avgCol = mix(avgCol, col2, 0.5);
+        col += avgCol * exp2(-i * 0.065 - 2.5) * smoothstep(0.0, 5.0, i);
+    }
+    
+    // Smooth horizon fade
+    col *= horizonFade * exp(-max(0.0, 0.12 - rd.y) * 12.0);
+    
+    // Final balanced intensity for maximum vibrancy and GI
+    return col.rgb * 0.25; 
+}
+
+// Smooth mask for biome and time transitions
+float GetAuroraMask() {
+    #if !defined AURORA || !defined DIMENSION_OVERWORLD
+        return 0.0;
+    #endif
+
+    // Time fade: Smoothly fade in/out during tick brackets
+    float timeMask = smoothstep(11500.0, 12500.0, float(worldTime)) * (1.0 - smoothstep(23000.0, 24000.0, float(worldTime)));
+    
+    // Moon mask for consistent brightness balance
+    float moonMask = smoothstep(0.0, 0.5, sunAngle) * (1.0 - smoothstep(0.5, 1.0, sunAngle));
+    float mask = timeMask * (0.5 + 0.5 * moonMask);
+
+    // Biome fade: Smooth transition based on biome weights
+    #ifdef AURORA_BIOME_RESTRICTION
+        float biomeMask = smoothstep(0.0, 0.2, max(eyeSnowySmooth, BiomeHotSmooth));
+    #else
+        float biomeMask = 1.0;
+    #endif
+    
+    #ifdef AURORA_FORCE
+        return mask * biomeMask;
+    #endif
+
+    // Robust daily probability hash (Gold Noise)
+    float dayHash = fract(tan(distance(vec2(float(worldDay) * 1.61803), vec2(float(worldDay) * 2.71828))) * 43758.5453);
+    float probMask = step(dayHash, AURORA_PROBABILITY);
+
+    return mask * biomeMask * probMask;
+}
+
+#endif
diff --git a/shaders/Lib/IndividualFunctions/BiomeColorGrading.glsl b/shaders/Lib/IndividualFunctions/BiomeColorGrading.glsl
new file mode 100644
index 0000000..eab3e9d
--- /dev/null
+++ b/shaders/Lib/IndividualFunctions/BiomeColorGrading.glsl
@@ -0,0 +1,50 @@
+
+vec3 ApplyBiomeColorGrading(vec3 color, float luminance) {
+    // Accumulate transformations across all active biomes
+    vec3  biomeTint     = vec3(1.0);
+    float biomeSat      = 1.0;
+    float biomeContrast = 1.0;
+    float biomeExp      = 1.0;
+
+    // 1. BiomeWinter: Cold, bluish, crisp
+    biomeTint     = mix(biomeTint, BIOME_TINT_WINTER, BiomeWinterSmooth);
+    biomeSat      = mix(biomeSat, 0.75, BiomeWinterSmooth);
+    biomeContrast = mix(biomeContrast, 1.08, BiomeWinterSmooth);
+
+    // 2. BiomeHot: Warm, scorched, hazy
+    biomeTint = mix(biomeTint, BIOME_TINT_HOT, BiomeHotSmooth);
+    biomeExp  = mix(biomeExp, 1.1, BiomeHotSmooth);
+    biomeSat  = mix(biomeSat, 0.88, BiomeHotSmooth);
+
+    // 3. BiomeLush: Vibrant, deep greens
+    biomeSat      = mix(biomeSat, 1.25, BiomeLushSmooth);
+    biomeTint     = mix(biomeTint, BIOME_TINT_LUSH, BiomeLushSmooth);
+    biomeContrast = mix(biomeContrast, 1.05, BiomeLushSmooth);
+
+    // 4. BiomeCherry: Dreamy pink highlights
+    biomeTint = mix(biomeTint, BIOME_TINT_CHERRY, BiomeCherrySmooth);
+    biomeExp  = mix(biomeExp, 1.1, BiomeCherrySmooth);
+    biomeSat  = mix(biomeSat, 1.15, BiomeCherrySmooth);
+
+    // 4.5 BiomeAutumn: Golden, nostalgic
+    biomeTint = mix(biomeTint, BIOME_TINT_AUTUMN, BiomeAutumnSmooth);
+    biomeSat  = mix(biomeSat, 1.15, BiomeAutumnSmooth);
+
+    // 5. BiomeUnderground: Cold, high-detail caves
+    biomeTint = mix(biomeTint, BIOME_TINT_CAVE, BiomeUndergroundSmooth);
+    biomeSat  = mix(biomeSat, 0.85, BiomeUndergroundSmooth);
+    
+    // Apply all transformations in one efficient block
+    vec3 result = mix(vec3(luminance), color, biomeSat);
+    result *= biomeTint * (biomeExp * BIOME_GRADING_STRENGTH + (1.0 - BIOME_GRADING_STRENGTH));
+    
+    #if defined BIOME_CONTRAST_FIX
+    result = pow(max(result, 0.0), vec3(biomeContrast));
+    #endif
+
+    // Special Underground Detail Pass (kept separate as it's a mask)
+    float midtoneMask = smoothstep(0.05, 0.45, luminance) * (1.0 - smoothstep(0.45, 0.85, luminance));
+    result *= 1.0 + (midtoneMask * 0.35 * BiomeUndergroundSmooth * BIOME_GRADING_STRENGTH);
+
+    return mix(color, result, BIOME_GRADING_STRENGTH);
+}
