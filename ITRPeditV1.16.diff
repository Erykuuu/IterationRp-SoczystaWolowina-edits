diff --git a/shaders/Lib/BasicFunctions/TorchFlicker.glsl b/shaders/Lib/BasicFunctions/TorchFlicker.glsl
new file mode 100644
index 0000000..b8974d1
--- /dev/null
+++ b/shaders/Lib/BasicFunctions/TorchFlicker.glsl
@@ -0,0 +1,25 @@
+#ifndef TORCH_FLICKER_GLSL
+#define TORCH_FLICKER_GLSL
+
+float TorchFlickerHash(float x, float seed){
+	return fract(sin(x * 12.9898 + seed * 78.233) * 43758.5453);
+}
+
+float TorchFlickerFactor(float seed){
+	#ifdef TORCH_FLICKER
+		float t = frameTimeCounter * TORCH_FLICKER_SPEED + seed * 13.37;
+		float phase = floor(t);
+		float blend = smoothstep(0.0, 1.0, fract(t));
+		float pulseA = TorchFlickerHash(phase, seed);
+		float pulseB = TorchFlickerHash(phase + 1.0, seed);
+		float randomPulse = mix(pulseA, pulseB, blend);
+		float sinePulse = 0.5 + 0.5 * sin(t * 6.2831853);
+		float pulse = mix(sinePulse, randomPulse, TORCH_FLICKER_VARIATION);
+		float flicker = (pulse - 0.5) * (0.45 * TORCH_FLICKER_STRENGTH);
+		return 1.0 + flicker;
+	#else
+		return 1.0;
+	#endif
+}
+
+#endif
