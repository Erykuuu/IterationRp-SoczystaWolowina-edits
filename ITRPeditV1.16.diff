+vec3 drawLensFlare(vec2 coord){
+	vec3 worldSunVector = shadowModelViewInverse2 * fsign(0.5 - sunAngle);
+	if (worldSunVector.y <= 0.02) return vec3(0.0);
+
+	vec3 viewSunVector = mat3(gbufferModelView) * worldSunVector;
+	if (viewSunVector.z >= -0.01) return vec3(0.0);
+
+	vec3 sunScreen = ScreenPos_From_ViewPos_Raw(viewSunVector * 12000.0);
+	if (sunScreen.x < -0.3 || sunScreen.x > 1.3 || sunScreen.y < -0.3 || sunScreen.y > 1.3) return vec3(0.0);
+
+	float sunDepth = clamp(sunScreen.z, 0.0, 1.0);
+	float sourceVis = isSunVisible(sunScreen.xy, sunDepth);
+	sourceVis = sourceVis * sourceVis * (3.0 - 2.0 * sourceVis); // smooth Hermite ramp
+
+	// Fade in/out when sun enters or exits screen to avoid hard flashing.
+	float edgeX = smoothstep(0.0, 0.06, sunScreen.x) * (1.0 - smoothstep(0.94, 1.0, sunScreen.x));
+	float edgeY = smoothstep(0.0, 0.06, sunScreen.y) * (1.0 - smoothstep(0.94, 1.0, sunScreen.y));
+	float screenEdgeFade = saturate(edgeX * edgeY);
+
+	float solarHeight = saturate((worldSunVector.y - 0.02) * 1.5);
+	float duskBoost = mix(0.85, 0.45, solarHeight);
+	float rainBoost = 1.0 + wetness * 0.08;
+	float sourceLuma = max(Luminance(textureLod(colortex1, sunScreen.xy, 0.0).rgb), Luminance(textureLod(colortex2, sunScreen.xy * 0.5, 0.0).rgb) * 2.0);
+	float lumaGate = max(saturate(sourceLuma * 0.010 + 0.035), 0.42);
+	float visibility = sourceVis * screenEdgeFade * lumaGate * duskBoost * rainBoost;
+	if (visibility <= 0.001) return vec3(0.0);
+
+	vec2 fromSun = coord - sunScreen.xy;
+	vec2 centerVec = vec2(0.5) - sunScreen.xy;
+	float dist = length(fromSun);
+	float axisLen = max(length(centerVec), 1e-4);
+	vec2 ghostAxis = centerVec / axisLen;
+	float coreMask = exp(-dist * 42.0);
+
+	vec3 flare = vec3(0.0);
+	vec3 bloomTap = textureLod(colortex2, coord * 0.5, 0.0).rgb;
+	float bloomGuide = saturate(Luminance(bloomTap) * 1.65);
+
+	#ifdef LENS_GLARE
+		float core = coreMask * 0.3;
+		float veil = exp(-dist * 12.0) * 0.025;
+		float haloInner = exp(-abs(dist - 0.02) * 180.0) * 0.07;
+		float haloOuter = exp(-abs(dist - 0.055) * 85.0) * 0.025;
+		vec3 glareColor = mix(vec3(1.0, 0.84, 0.76), vec3(0.86, 0.9, 1.0), saturate(dist * 6.0));
+		flare += glareColor * (core + veil + haloInner + haloOuter) * GLARE_BRIGHTNESS * 1.2;
+	#endif
+
+	#ifdef LENS_FLARE
+		#if LENS_FLARE_MODE == 1
+			flare += getEyeFlare(coord, sunScreen, centerVec, fromSun);
+		#else
+			flare += getCameraFlare(coord, sunScreen, centerVec, ghostAxis, fromSun, bloomGuide);
+		#endif
+	#endif
+
+	float currentExposure = max(GetExposureValue(), 1e-4);
+	float exposureComp = min(mix(1.0, 1.0 / currentExposure, FLARE_EXPOSURE_COMPENSATION), 8.0);
+
+	return flare * visibility * (1.0 + bloomGuide * 0.45) * exposureComp;
+}
