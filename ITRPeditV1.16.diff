+	// Vectorized branchless Soft Light blend
+	vec3 blendLayer = grainOffset * 0.5 + 0.5;
+	vec3 d = mix(sqrt(max(color, 0.0)), ((16.0 * color - 12.0) * color + 4.0) * color, step(color, vec3(0.25)));
