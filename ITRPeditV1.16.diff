diff --git a/shaders/Lib/IndividualFunctions/WeatherEngine.glsl b/shaders/Lib/IndividualFunctions/WeatherEngine.glsl
new file mode 100644
index 0000000..d7c3bec
--- /dev/null
+++ b/shaders/Lib/IndividualFunctions/WeatherEngine.glsl
@@ -0,0 +1,146 @@
+#ifndef INCLUDE_WEATHER_ENGINE
+#define INCLUDE_WEATHER_ENGINE
+
+#include "/Lib/Utilities.glsl"
+
+struct WeatherState {
+	float targetCoverage; 
+	float thicknessMul;   
+	float densityMul;
+	float rainFactor;     
+	vec3 windOffset;      
+	float landScatteringStrength;
+};
+
+// Perfectly continuous wave-based noise
+float GetWeatherWave(float t, float periodDays) {
+	float phase = t * (TAU / (24000.0 * periodDays));
+	return sin(phase) * 0.5 + 0.5;
+}
+
+// Resolves the weather parameters at a specific tick time
+void ResolveWeatherWaves(float tickTime, out float flow, out float detail) {
+	#ifdef CLOUD_WEATHER_NETWORK
+		float waveA = GetWeatherWave(tickTime, 4.5); 
+		float waveB = GetWeatherWave(tickTime + 1500.0, 2.1); 
+		float waveC = GetWeatherWave(tickTime * 0.5, 0.8); 
+		
+		flow = saturate(waveA * 0.6 + waveB * 0.4);
+		detail = waveC;
+	#else
+		flow = 0.5;
+		detail = 0.5;
+	#endif
+}
+
+WeatherState GetWeatherEngineState() {
+	WeatherState state;
+	state.rainFactor = saturate(wetness * 1.1);
+	
+	// Use raw ticks for weather waves to ensure periodDays matches actual Minecraft days.
+	#if CLOUD_ANIMATION_TYPE == 1
+		float todayTicks = float(worldDay) * 24000.0 + float(worldTime);
+		float tomorrowTicks = (float(worldDay) + 1.0) * 24000.0;
+	#else
+		float todayTicks = frameTimeCounter * 20.0;
+		float tomorrowTicks = todayTicks + 24000.0; // Approximation for frame-time
+	#endif
+	
+	float timeOfDay = mod(float(worldTime), 24000.0);
+	
+	// Midnight Crossfade Window (Transitions weather states and wind seamlessly across the clock reset)
+	float dayTransition = smoothstep(18000.0, 24000.0, timeOfDay);
+
+	// --- Dual Flow Sampling (The Pop-Killer) ---
+	float flowToday, detailToday;
+	float flowTomorrow, detailTomorrow;
+	
+	// Sample waves for NOW (using cumulative time)
+	ResolveWeatherWaves(todayTicks, flowToday, detailToday);
+	
+	// Sample waves for START OF NEXT DAY (using cumulative time)
+	ResolveWeatherWaves(tomorrowTicks, flowTomorrow, detailTomorrow);
+	
+	// Blend the waves during the night to handle the transition to the next day's forecast
+	float weatherFlow = mix(flowToday, flowTomorrow, dayTransition);
+	float detailFlow = mix(detailToday, detailTomorrow, dayTransition);
+
+	#ifdef CLOUD_WEATHER_NETWORK
+		// --- Dynamic Threshold Stacking (States are allocated portions of the 0-1 flow range) ---
+		float thresholdOvercast  = 1.0 - CLOUD_PROB_OVERCAST;
+		float thresholdBroken    = max(0.0, thresholdOvercast - CLOUD_PROB_BROKEN);
+		float thresholdScattered = max(0.0, thresholdBroken - CLOUD_PROB_SCATTERED);
+
+		// --- State Weights (Non-overlapping transitions) ---
+		float weightOvercast  = smoothstep(thresholdOvercast - 0.05, thresholdOvercast + 0.05, weatherFlow);
+		weightOvercast = max(weightOvercast, state.rainFactor);
+		
+		float weightBroken    = smoothstep(thresholdBroken - 0.05, thresholdBroken + 0.05, weatherFlow);
+		float weightScattered = smoothstep(thresholdScattered - 0.05, thresholdScattered + 0.05, weatherFlow);
+
+		// Mutually exclusive weighting
+		weightBroken    *= (1.0 - weightOvercast);
+		weightScattered *= (1.0 - weightOvercast) * (1.0 - weightBroken);
+		
+		// --- State Resolution ---
+		float coverageNode  = 0.02; // Base Clear state (almost zero clouds)
+		float thicknessNode = 0.25;
+		float densityNode   = 0.35;
+		
+		// Transition to Scattered
+		coverageNode  = mix(coverageNode,  0.22, weightScattered);
+		thicknessNode = mix(thicknessNode, 0.45, weightScattered);
+		densityNode   = mix(densityNode,   0.7,  weightScattered);
+		
+		// Transition to Broken
+		coverageNode  = mix(coverageNode,  0.55, weightBroken);
+		thicknessNode = mix(thicknessNode, 0.8,  weightBroken);
+		densityNode   = mix(densityNode,   1.1,  weightBroken);
+		
+		// Transition to Overcast
+		coverageNode  = mix(coverageNode,  1.0, weightOvercast);
+		thicknessNode = mix(thicknessNode, 1.0, weightOvercast);
+		densityNode   = mix(densityNode,   1.8, weightOvercast);
+		
+		// --- Horizon Fix ---
+		float horizonFactor = smoothstep(0.2, 0.3, abs(sunAngle - 0.25)) * (1.0 - smoothstep(0.0, 0.1, abs(sunAngle - 0.25)));
+		horizonFactor += smoothstep(0.2, 0.3, abs(sunAngle - 0.75)) * (1.0 - smoothstep(0.0, 0.1, abs(sunAngle - 0.75)));
+		horizonFactor = saturate(horizonFactor);
+
+		coverageNode = mix(coverageNode, 0.4, horizonFactor * CLOUD_PROB_SUNSET_SCAT * (1.0 - weightOvercast));
+		coverageNode += (detailFlow - 0.5) * 0.1 * CLOUD_WEATHER_VARIANCE;
+		
+		state.targetCoverage = saturate(coverageNode);
+
+		// Significant density boost during storms for ominous dark clouds
+		float stormFactor = saturate(wetness * 0.5 + thunderStrength * 0.5);
+		densityNode *= 1.0 + stormFactor * 1.5;
+
+		state.thicknessMul = saturate(thicknessNode);
+		state.densityMul = densityNode;
+		state.landScatteringStrength = mix(LANDSCATTERING_STRENGTH_MIN, LANDSCATTERING_STRENGTH_MAX, weatherFlow);
+		
+	#else
+		state.targetCoverage = 0.5;
+		state.thicknessMul = 1.0;
+		state.densityMul = 1.0;
+		state.landScatteringStrength = (LANDSCATTERING_STRENGTH_MIN + LANDSCATTERING_STRENGTH_MAX) * 0.5;
+	#endif
+	
+	// --- Master Wind Offset (Continuous forward motion across days) ---
+	vec3 windVector = CLOUD_SPEED * vec3(1.0, 0.0, 0.1) * 4e-4;
+	
+	#if CLOUD_ANIMATION_TYPE == 1
+		// Only crossfade wind if using World Time (to handle the 24000 -> 0 tick reset)
+		vec3 windToday = (float(worldDay) * 24000.0 + float(worldTime)) * 0.05 * windVector;
+		vec3 windTomorrow = ((float(worldDay) + 1.0) * 24000.0) * 0.05 * windVector; 
+		state.windOffset = mix(windToday, windTomorrow, dayTransition);
+	#else
+		// Frame time is continuous, no crossfade needed
+		state.windOffset = frameTimeCounter * windVector;
+	#endif
+
+	return state;
+}
+
+#endif
