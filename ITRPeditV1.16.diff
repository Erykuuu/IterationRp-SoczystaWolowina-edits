+vec3 getFilmGrain(vec3 color, vec2 uv) {
+	float grainSize = FILM_GRAIN_SIZE;
+	float grainIntensity = FILM_GRAIN_INTENSITY;
+	
+	// Golden ratio based temporal seed for perfectly random movement every frame
+	float timeSeed = fract(float(frameCounter % 10000) * 0.61803398875);
+	
+	// Per-channel noise with strong decorrelation (using large primes)
+	vec3 noise;
+	float scale = screenSize.y / grainSize;
+	noise.r = smoothNoise_fg(uv, timeSeed + 13.37, scale);
+	noise.g = smoothNoise_fg(uv, timeSeed + 42.11, scale);
+	noise.b = smoothNoise_fg(uv, timeSeed + 91.07, scale);
+	
+	noise = noise * 2.0 - 1.0;
+	
+	// Luminance Masking (Film grain is naturally more visible in midtones)
+	float luma = Luminance(color);
+	float mask = exp(-pow((luma - 0.4) * 2.5, 2.0)); 
+	mask = max(mask, 0.05); 
