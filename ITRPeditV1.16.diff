+#include "/Lib/IndividualFunctions/WeatherEngine.glsl"
 
-vec2 SampleDensity(vec4 cloudPos, vec3 windDirection, bool sampleDetail){
+#if CLOUD_STYLE == 1
+
+// ================= CUSTOM EDIT CLOUDS (ITRPedit) =================
+
+vec3 SampleDensity(vec4 cloudPos, vec3 windDirection, bool sampleDetail, WeatherState weather){
+
+	// Edge-Aware Dynamic Warp (The "Curl" and "Wisp" Foundation)
+	// We use the coverage noise to pre-calculate how much "wispiness" to apply
+	float coverageNoise = textureLod(CloudNoise3D, cloudPos.xyz * vec3(8.5e-5, 1e-5, 8.5e-5) + windDirection + CLOUD_COVERAGE_NOISE_OFFSET, 0.0).x;
+
+	#ifdef CLOUD_WEATHER_NETWORK
+		float clearCovery = mix(CLOUD_COVERAGE_MIN, CLOUD_COVERAGE_MAX, weather.targetCoverage);
+		clearCovery = mix(clearCovery, 0.92, weather.rainFactor);
+	#elif defined CLOUD_DYNAMIC_COVERAGE
+		float dynT = sin(CLOUD_ANIM_TIME * CLOUD_TRANSITION_SPEED * 2e-4) * 0.5 + 0.5;
+		dynT = smoothstep(0.0, 1.0, dynT);
+		float clearCovery = mix(CLOUD_COVERAGE_MIN, CLOUD_COVERAGE_MAX, dynT);
+	#else
+		float clearCovery = CLOUD_CLEAR_COVERY;
+	#endif
+
+	float coverage = mix(clearCovery, CLOUD_RAIN_COVERY, wetness);
+	coverage = saturate(coverage);
+	
+	float localAging = saturate(remap(1.0 - coverageNoise, coverage * 0.1, coverage, 0.0, 1.0));
+	float wispFactor = saturate(remap(1.0 - coverageNoise, coverage * 0.4, coverage, 0.0, 1.0)); 
+
+	// Stabilized Curling Warp: Stronger for visibility
+	float curlStrength = wispFactor * localAging * 32.0 * CLOUD_WISP_CURL_STRENGTH;
+	vec2 curlOffset = vec2(sin(cloudPos.y * 0.015 * CLOUD_WISP_FREQUENCY + CLOUD_ANIM_TIME * 2e-4), cos(cloudPos.y * 0.015 * CLOUD_WISP_FREQUENCY + CLOUD_ANIM_TIME * 1e-4));
+	cloudPos.xz += curlOffset * curlStrength;
+
+	//Base Noise Fetch
+		vec4 baseNoise = textureLod(CloudNoise3D, cloudPos.xyz * CLOUD_BASE_NOISE_SCALE * 0.88 + windDirection * 10.0, 0.0);
+
+		float baseDensity = baseNoise.y * 0.4 + baseNoise.z * 0.4 + baseNoise.w * 0.2;
+		baseDensity = remapSaturate(baseNoise.x, baseDensity * 0.8 - 0.8, 1.0);
+
+		// Organic cumulus profile
+		float shapeProfile = curveTop(saturate(1.1 - cloudPos.w * 1.1)) * 0.6 + 0.4;
+		shapeProfile *= curveTop(saturate((1.0 - cloudPos.w) * 1.2));
+		
+		// Silhouette Scalloping: Moved back to base pass for visibility (using existing high-freq channel)
+		shapeProfile *= 1.0 + (baseNoise.w - 0.5) * wispFactor * 0.55 * CLOUD_WISP_SCALLOP_INTENSITY;
+		baseDensity *= shapeProfile;
+		
+		baseDensity *= fsqrt(saturate(cloudPos.w * 4.0)) * 0.1 + 0.9;
+
+	//Final Coverage Integration
+		float erosionScale = mix(CLOUD_AGING_EROSION_MAX, max(CLOUD_AGING_EROSION_MIN, 0.5), localAging); 
+		float heightSquash = mix(CLOUD_AGING_SQUASH, 1.0, localAging); 
+
+		coverage = remapSaturate(1.0 - coverageNoise, coverage * 0.1, coverage);
+		baseDensity = remapSaturate(baseDensity, coverage, 1.0); 
+
+	//Density Control
+		float verticalTaper = curve(saturate(cloudPos.w * 1.3 - 0.3)) * 1.0 + 1.0;
+		verticalTaper *= curveTop(saturate(cloudPos.w * 1.5));
+		verticalTaper *= smoothstep(0.0, 0.15, cloudPos.w) * smoothstep(1.0, 0.7, cloudPos.w / heightSquash);
+		
+		baseDensity *= verticalTaper;
