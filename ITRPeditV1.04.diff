+	#if defined DISTANT_HORIZONS || defined VOXY
+		float lodDepth = textureLod(LOD_DEPTH_TEX_1, coord, 0.0).x;
+		#ifdef LOD_RENDERING
+			lodDepth = ScreenDepth_From_LODScreenDepth(lodDepth);
+		#endif
