@@ -0,0 +1,164 @@
+
+// ============================================================
+// Rainbow.glsl — Atmospheric Rainbow (Death Stranding style)
+// ============================================================
+//
+//  Physics:
+//    Primary bow:   ~42° from anti-solar point, red outer / violet inner
+//    Secondary bow: ~51°, violet outer / red inner (Alexander's dark band between)
+//    Supernumerary: faint oscillating fringes just inside the primary bow
+//
+//  Visibility conditions:
+//    - Sun elevation below ~42° (so the bow rim is above the horizon)
+//    - Some recent rain / overcast wetness
+//    - Not raining so hard that sky is fully obscured
+//    - Slowly time-varying probability (RAINBOW_PROBABILITY)
+//
+//  All brightness values are in the same linear HDR space as the rest of
+//  Sky_Overworld_FS.glsl. RAINBOW_BRIGHTNESS default 1.0 matches the
+//  look of Death Stranding's rainbow (vivid but not blown out).
+// ============================================================
+
+// ---- Spectral colour -------------------------------------------------------
+// Piecewise wavelength (nm) → linear-light sRGB.
+// Based on Bruton's algorithm, squared to convert from perceptual to linear.
+vec3 _RbWavelengthToRGB(float w) {
+    vec3 c;
+    if      (w < 440.0) { c = vec3((440.0-w)/60.0, 0.0,             1.0            ); }
+    else if (w < 490.0) { c = vec3(0.0,             (w-440.0)/50.0,  1.0            ); }
+    else if (w < 510.0) { c = vec3(0.0,             1.0,             (510.0-w)/20.0 ); }
+    else if (w < 580.0) { c = vec3((w-510.0)/70.0,  1.0,             0.0            ); }
+    else if (w < 645.0) { c = vec3(1.0,             (645.0-w)/65.0,  0.0            ); }
+    else                { c = vec3(1.0,             0.0,             0.0            ); }
+    return c * c; // gamma → linear light
+}
+
+// Spectral colour with saturation control and optional sun-colour tint.
+// t: 0 = violet end, 1 = red end (maps to 400–700 nm)
+vec3 _RbSpectrum(float t, vec3 sunColor, float saturation) {
+    float w      = mix(400.0, 700.0, saturate(t));
+    vec3  pure   = _RbWavelengthToRGB(w);
+    float lum    = dot(pure, vec3(0.2126, 0.7152, 0.0722));
+    vec3  grey   = vec3(lum);
+    vec3  sat    = mix(grey, pure, saturation);
+
+    // Subtle solar tint: sunset rainbows lean warm, midday lean cool
+    vec3 sunNorm = normalize(sunColor + vec3(0.001));
+    return mix(sat, sat * sunNorm * (length(pure) + 0.3), 0.18);
+}
+
+// ---- Main rainbow renderer -------------------------------------------------
+
+void RenderRainbow(inout vec3 color, vec3 worldDir, vec3 sunDir,
+                   vec3 sunColor, float rainbowStrength)
+{
+    if (rainbowStrength < 0.001) return;
+    // Only sky pixels above horizon
+    if (worldDir.y < -0.04) return;
+
+    vec3  antiSun  = -sunDir;
+    float cosTheta = clamp(dot(worldDir, antiSun), -1.0, 1.0);
+    float thetaDeg = degrees(acos(cosTheta));
+
+    float sat = RAINBOW_SATURATION;
+
+    // ---- Primary bow (40.4° – 42.5°) ----------------------------------------
+    // t=0 → violet at inner edge (40.4°), t=1 → red at outer edge (42.5°)
+    {
+        const float thetaMin = 40.4;
+        const float thetaMax = 42.5;
+        float t = (thetaDeg - thetaMin) / (thetaMax - thetaMin);
+
+        if (t > -0.6 && t < 1.6) {
+            // Radial profile: gaussian-ish, sharpest at the red (outer) edge
+            float profile = 1.0 - abs(t - 0.5) / 0.5;
+            profile = saturate(profile);
+            profile = profile * profile * (3.0 - 2.0 * profile); // smoothstep shape
+
+            // Extra sharpness at outer (red) edge — physically real
+            profile *= mix(0.7, 1.0, saturate((t - 0.5) * 3.0 + 0.5));
+
+            vec3 spectral = _RbSpectrum(saturate(t), sunColor, sat);
+            color += spectral * profile * rainbowStrength * 0.12;
+
+            // Supernumerary fringes: oscillating bands just inside the primary bow.
+            // They arise from wave interference and give that DS "haunted" quality.
+            if (t < 0.05) {
+                float inner = saturate(-t * 2.5); // ramps up as we move inside the bow
+                float fringes = sin(t * 28.0 * 3.14159 + 1.5) * 0.5 + 0.5;
+                fringes *= inner * 0.3;
+                // Fringes are nearly white / pale blue
+                vec3 fringeColor = mix(vec3(0.5, 0.6, 1.0), vec3(0.9, 0.95, 1.0), saturate(-t * 4.0));
+                color += fringeColor * fringeColor * fringes * rainbowStrength * 0.025;
+            }
+
+            // Alexander's dark band: between primary outer edge and secondary inner edge
+            // (42.5° – 50°). We don't add light here — the natural effect is
+            // that this region *lacks* the extra backscatter the bow provides.
+            // A subtle desaturation of the sky behind emulates the perceived darkening.
+            if (t > 1.0 && thetaDeg < 50.0) {
+                float bandFade = remapSaturate(thetaDeg, 42.5, 50.0) *
+                                 remapSaturate(thetaDeg, 50.0, 45.0);
+                color *= mix(1.0, 0.82, bandFade * rainbowStrength * 0.6);
+            }
+        }
+    }
+
+    // ---- Secondary bow (50.0° – 53.5°) — reversed order ---------------------
+    // t=0 → red at inner edge (50°), t=1 → violet at outer edge (53.5°)
+    #ifdef RAINBOW_SECONDARY
+    {
+        const float thetaMin = 50.0;
+        const float thetaMax = 53.5;
+        float t = (thetaDeg - thetaMin) / (thetaMax - thetaMin);
+
+        if (t > -0.6 && t < 1.6) {
+            float profile = 1.0 - abs(t - 0.5) / 0.5;
+            profile = saturate(profile);
+            profile = profile * profile * (3.0 - 2.0 * profile);
+
+            // Reversed: t=0→red end of spectrum, t=1→violet end
+            vec3 spectral = _RbSpectrum(1.0 - saturate(t), sunColor, sat);
+            // Secondary is naturally ~40–50% as bright, and broader
+            color += spectral * profile * rainbowStrength * 0.042;
+        }
+    }
+    #endif
+}
+
+// ---- Visibility / strength -------------------------------------------------
+
+float GetRainbowStrength() {
+    // --- Sun height gate ---
+    // Primary bow rim touches the horizon when sun elevation = 42°.
+    // As sun rises above that, the full bow sinks below ground.
+    // We fade in as sun drops below 42° and fade out below the horizon.
+    float sunElev     = worldSunVector.y;               // -1…1
+    float sunGate     = remapSaturate(sunElev,  0.72, 0.52)   // fades in under 42°
+                      * remapSaturate(sunElev, -0.12, 0.05);   // fades out at night
+
+    if (sunGate < 0.001) return 0.0;
+
+    // --- Wetness gate ---
+    // Peak during / just after rain (wetness 0.1–0.7).
+    // Heavy overcast (wetness→1) blocks the sun → no rainbow.
+    float wetGate = remapSaturate(wetness, 0.03, 0.20)
+                  * (1.0 - remapSaturate(wetness, 0.60, 1.0) * 0.85);
+
+    if (wetGate < 0.001) return 0.0;
+
+    // --- Time-varying probability ---
+    // Uses the same CLOUD_TRANSITION_SPEED so rainbow timing feels linked
+    // to cloud movement. Produces a slow sinusoidal "appear / linger / fade"
+    // with a period of about 3–4 Minecraft hours at speed 1.0.
+    float cycle = sin(frameTimeCounter * CLOUD_TRANSITION_SPEED * 1.85e-4) * 0.5 + 0.5;
+    // A second harmonic adds variation so it doesn't feel perfectly periodic.
+    cycle += sin(frameTimeCounter * CLOUD_TRANSITION_SPEED * 7.3e-5 + 1.2) * 0.18;
+    cycle = saturate(cycle * 0.85);
+    // Threshold: only pass when the cycle exceeds (1 - probability).
+    cycle = remapSaturate(cycle, 1.0 - RAINBOW_PROBABILITY, 1.0);
+    // Smooth the hard threshold so entry/exit are gradual.
+    cycle = cycle * cycle * (3.0 - 2.0 * cycle);
+
+    return sunGate * wetGate * cycle * RAINBOW_BRIGHTNESS;
+}
