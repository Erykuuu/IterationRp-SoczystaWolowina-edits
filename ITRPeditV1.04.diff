diff --git a/ITRPedit/shaders/Lib/IndividualFunctions/BiomeColorGrading.glsl b/ITRPedit/shaders/Lib/IndividualFunctions/BiomeColorGrading.glsl
new file mode 100644
index 0000000..9273f9c
--- /dev/null
+++ b/ITRPedit/shaders/Lib/IndividualFunctions/BiomeColorGrading.glsl
@@ -0,0 +1,63 @@
+
+vec3 ApplyBiomeColorGrading(vec3 color) {
+    vec3 result = color;
+    
+    // 1. BiomeWinter: Cold, bluish, crisp
+    if (BiomeWinterSmooth > 0.001) {
+        vec3 winter = color;
+        winter = mix(vec3(Luminance(winter)), winter, 0.75); // Subtle desaturate
+        winter *= vec3(0.92, 0.96, 1.15); // Cold blue tint
+        winter = pow(max(winter, 0.0), vec3(1.08)); // Crisp contrast
+        result = mix(result, winter, BiomeWinterSmooth * BIOME_GRADING_STRENGTH);
+    }
+    
+    // 2. BiomeHot: Warm, scorched, hazy
+    if (BiomeHotSmooth > 0.001) {
+        vec3 hot = color;
+        hot *= vec3(1.15, 1.02, 0.85); // Amber desert tint
+        hot *= 1.1; // Bright sun boost
+        hot = mix(vec3(Luminance(hot)), hot, 0.88); // Drier saturation
+        result = mix(result, hot, BiomeHotSmooth * BIOME_GRADING_STRENGTH);
+    }
+    
+    // 3. BiomeLush: Vibrant, deep greens
+    if (BiomeLushSmooth > 0.001) {
+        vec3 lush = color;
+        lush = mix(vec3(Luminance(lush)), lush, 1.25); // Vibrant saturation
+        lush *= vec3(0.95, 1.12, 0.98); // Emerald tint
+        lush = pow(max(lush, 0.0), vec3(1.05)); // Deep shadows
+        result = mix(result, lush, BiomeLushSmooth * BIOME_GRADING_STRENGTH);
+    }
+    
+    // 4. BiomeCherry: Dreamy pink highlights
+    if (BiomeCherrySmooth > 0.001) {
+        vec3 cherry = color;
+        cherry *= vec3(1.18, 0.92, 1.12); // Soft pink tint
+        cherry *= 1.1; // Soft exposure boost
+        cherry = mix(vec3(Luminance(cherry)), cherry, 1.15); // Sweet vibrancy
+        result = mix(result, cherry, BiomeCherrySmooth * BIOME_GRADING_STRENGTH);
+    }
+
+    // 4.5 BiomeAutumn: Golden, nostalgic
+    if (BiomeAutumnSmooth > 0.001) {
+        vec3 autumn = color;
+        autumn *= vec3(1.16, 1.08, 0.88); // Golden amber tint
+        autumn = mix(vec3(Luminance(autumn)), autumn, 1.15); // Warm saturation
+        result = mix(result, autumn, BiomeAutumnSmooth * BIOME_GRADING_STRENGTH);
+    }
+    
+    // 5. BiomeUnderground: Cold, high-detail caves
+    if (BiomeUndergroundSmooth > 0.001) {
+        vec3 cave = color;
+        cave *= vec3(0.85, 0.94, 1.12); // Cold cave tint
+        cave = mix(vec3(Luminance(cave)), cave, 0.85);
+        
+        float luma = Luminance(cave);
+        float midtoneMask = smoothstep(0.05, 0.45, luma) * (1.0 - smoothstep(0.45, 0.85, luma));
+        cave *= 1.0 + midtoneMask * 0.35; // Detail boost
+        
+        result = mix(result, cave, BiomeUndergroundSmooth * BIOME_GRADING_STRENGTH);
+    }
+    
+    return result;
+}
