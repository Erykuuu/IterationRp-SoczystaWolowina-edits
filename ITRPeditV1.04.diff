+vec3 ApplyInjectedLut(vec3 color){
+	#if LUT_PROFILE == 1
+		return mix(color, SampleLut32_1(color), LUT_STRENGTH);
+	#elif LUT_PROFILE == 2
+		return mix(color, SampleLut32_2(color), LUT_STRENGTH);
+	#elif LUT_PROFILE == 3
+		return mix(color, SampleLut32_3(color), LUT_STRENGTH);
+	#elif LUT_PROFILE == 4
+		return mix(color, SampleLut32_4(color), LUT_STRENGTH);
+	#else
+		return color;
+	#endif
+}
