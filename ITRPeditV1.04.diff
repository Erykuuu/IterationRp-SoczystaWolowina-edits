+	float finePetals = abs(cos(a * 16.0 + Hash11(floor(a * 57.0)) * 0.75));
+	float angular = mix(petals, finePetals, 0.35);
+	float radial = exp(-r * 35.0) + exp(-abs(r - 0.025) * 220.0) * 0.35;
+
+	float sparkle = Hash21(floor(coord * screenSize * 0.25) + vec2(float(frameCounter % 1024), 0.0));
+	sparkle = mix(0.82, 1.15, sparkle);
+
