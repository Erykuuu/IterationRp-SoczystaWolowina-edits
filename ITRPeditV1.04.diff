+vec3 getFilmGrain(vec3 color, vec2 uv) {
+	float grainSize = FILM_GRAIN_SIZE; // Configurable scale
+	float grainIntensity = FILM_GRAIN_INTENSITY; // Overall intensity
+	
+	// Temporal variation using frameCounter
+	float timeSeed = float(frameCounter % 10000) * 0.1337;
+	
+	// Per-channel noise (simulating color film layers)
+	vec3 noise;
+	noise.r = smoothNoise_fg(uv, timeSeed + 1.0, screenSize.y / grainSize);
+	noise.g = smoothNoise_fg(uv, timeSeed + 2.0, screenSize.y / grainSize);
+	noise.b = smoothNoise_fg(uv, timeSeed + 3.0, screenSize.y / grainSize);
+	
+	// Shift noise from [0, 1] to [-1, 1]
+	noise = noise * 2.0 - 1.0;
+	
+	// Luminance Masking (bell curve based on luminance)
+	float luma = dot(color, vec3(0.299, 0.587, 0.114));
+	// 1.0 at mid-tones, drops to 0.1 at absolute black, and 0.0 at bright highlights
+	float mask = exp(-pow((luma - 0.4) * 2.5, 2.0)); 
+	mask = max(mask, 0.05); // slight grain at absolute black
+	
+	vec3 grainOffset = noise * grainIntensity * mask;
+	
+	// Soft Light blending
+	vec3 blendColor;
+	
+	// R channel
+	float baseR = color.r;
+	float blendLayerR = grainOffset.r * 0.5 + 0.5;
+	if (blendLayerR < 0.5) {
+		blendColor.r = baseR - (1.0 - 2.0 * blendLayerR) * baseR * (1.0 - baseR);
+	} else {
+		float d = (baseR <= 0.25) ? ((16.0 * baseR - 12.0) * baseR + 4.0) * baseR : sqrt(baseR);
+		blendColor.r = baseR + (2.0 * blendLayerR - 1.0) * (d - baseR);
+	}
+	
+	// G channel
+	float baseG = color.g;
+	float blendLayerG = grainOffset.g * 0.5 + 0.5;
+	if (blendLayerG < 0.5) {
+		blendColor.g = baseG - (1.0 - 2.0 * blendLayerG) * baseG * (1.0 - baseG);
+	} else {
+		float d = (baseG <= 0.25) ? ((16.0 * baseG - 12.0) * baseG + 4.0) * baseG : sqrt(baseG);
+		blendColor.g = baseG + (2.0 * blendLayerG - 1.0) * (d - baseG);
+	}
+	
+	// B channel
+	float baseB = color.b;
+	float blendLayerB = grainOffset.b * 0.5 + 0.5;
+	if (blendLayerB < 0.5) {
+		blendColor.b = baseB - (1.0 - 2.0 * blendLayerB) * baseB * (1.0 - baseB);
+	} else {
+		float d = (baseB <= 0.25) ? ((16.0 * baseB - 12.0) * baseB + 4.0) * baseB : sqrt(baseB);
+		blendColor.b = baseB + (2.0 * blendLayerB - 1.0) * (d - baseB);
+	}
+	
+	return saturate(blendColor);
+}
