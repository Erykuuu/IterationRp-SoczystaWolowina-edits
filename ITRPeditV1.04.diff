+// High-speed pseudo-random hash for noise generation
+float hash3_fg(vec3 p3) {
+	p3  = fract(p3 * .1031);
+	p3 += dot(p3, p3.yzx + 33.33);
+	return fract((p3.x + p3.y) * p3.z);
+}
+
+// Smooth noise function
+float smoothNoise_fg(vec2 uv, float seed, float scale) {
+	vec2 p = uv * scale;
+	vec2 i = floor(p);
+	vec2 f = fract(p);
+	// Smooth interpolation
+	f = f * f * (3.0 - 2.0 * f);
+	
+	float n00 = hash3_fg(vec3(i, seed));
+	float n10 = hash3_fg(vec3(i + vec2(1.0, 0.0), seed));
+	float n01 = hash3_fg(vec3(i + vec2(0.0, 1.0), seed));
+	float n11 = hash3_fg(vec3(i + vec2(1.0, 1.0), seed));
+	
+	float nx0 = mix(n00, n10, f.x);
+	float nx1 = mix(n01, n11, f.x);
+	
+	return mix(nx0, nx1, f.y);
+}
