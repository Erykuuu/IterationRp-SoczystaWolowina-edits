+struct RevelationDayParams {
+	float altitude;
+	float height;
+	float coverage;
+	float density;
+	float weatherLow;
+	float weatherHigh;
+	float weatherStrength;
+	float localNoise;
+	float scale;
+	float baseNoiseScale;
+	float detailNoiseScale;
+	float coverageNoiseOffset;
+	float detailedNoiseStrength;
+	float dualLobeSoftening;
+	float dualLobeBodyG;
+	float dualLobeBodyStrength;
+};
+
+int RevelationDayHash(int d) {
+	float h = fract(sin(float(d) * 12.9898 + 78.233) * 43758.5453);
+	return int(floor(h * 10.0));
+}
+
+float RevelationDayRainBypass() {
+	return saturate(wetness);
+}
+
+float RevelationDayPresetMix() {
+#if CLOUD_REVELATION_DAY_MODE == 0
+	return 0.0;
+#elif CLOUD_REVELATION_DAY_MODE == 1
+	return 1.0 - RevelationDayRainBypass();
+#else
+	return 1.0 - RevelationDayRainBypass();
+#endif
+}
+
+int RevelationDayCurrentIndex() {
+#if CLOUD_REVELATION_DAY_MODE == 1
+	return max(CLOUD_REVELATION_MANUAL_DAY - 1, 0);
+#elif CLOUD_REVELATION_DAY_MODE == 2
+	return int(mod(float(worldDay), 10.0));
+#elif CLOUD_REVELATION_DAY_MODE == 3
+	return RevelationDayHash(worldDay);
+#else
+	return 0;
+#endif
+}
+
+int RevelationDayPreviousIndex() {
+#if CLOUD_REVELATION_DAY_MODE == 2
+	return int(mod(float(worldDay + 9), 10.0));
+#elif CLOUD_REVELATION_DAY_MODE == 3
+	return RevelationDayHash(worldDay - 1);
+#else
+	return RevelationDayCurrentIndex();
+#endif
+}
+
+float RevelationDayBlend() {
+#if CLOUD_REVELATION_DAY_MODE == 2 || CLOUD_REVELATION_DAY_MODE == 3
+	float transitionTicks = min(1000.0, 1000.0 / max(CLOUD_REVELATION_DAY_TRANSITION_SPEED, 0.01));
+	float p = saturate(float(worldTime) / transitionTicks);
+	return p * p * (3.0 - 2.0 * p);
+#else
+	return 1.0;
+#endif
