diff --git a/shaders/Lib/BasicFunctions/FFT.glsl b/shaders/Lib/BasicFunctions/FFT.glsl
new file mode 100644
index 0000000..6f29d41
--- /dev/null
+++ b/shaders/Lib/BasicFunctions/FFT.glsl
@@ -0,0 +1,153 @@
+// by huj31415
+
+#define PI 3.1415926535
+#define TAU 6.283185307
+
+#if FFT_SIZE == 1024
+  #define N_4_1 256 // N / 4
+  #define N_4_2 512 // 2N / 4
+  #define N_4_3 768 // 3N / 4
+	#define START_Ns 4
+#elif FFT_SIZE == 2048
+  #define N_4_1 512
+  #define N_4_2 1024
+  #define N_4_3 1536
+	#define START_Ns 8
+#endif
+
+#ifdef IFFT
+  #define INV -1.0
+#else
+  #define INV 1.0
+#endif
+
+const float NORM = 1.0 / float(FFT_SIZE);
+  
+shared vec2 row[FFT_SIZE];
+
+vec2 cmul(in vec2 A, in vec2 B) {
+	return vec2(A.x * B.x - A.y * B.y, dot(A, B.yx));
+}
+
+// to prevent shared bank conflicts
+uint swizzle(uint x) {
+  return (x & ~31) | ((x & 31) ^ ((x >> 5) & 31));
+}
+
+uint digit_reverse_4(uint x) {
+  return ((x & 3) << 8) | ((x & 12) << 4) | (x & 48) | ((x & 192) >> 4) | ((x >> 8) & 3);
+}
+
+// in-place Cooley-Tukey FFT, forward if inv = 1, inverse if inv = -1
+void fftR4_CT(uint x, uint Ns) {
+  uint Ns4 = Ns >> 2u; // Ns / 4
+  uint offset = x & (Ns4 - 1u); // x % Ns4;
+
+  // replace with shared memory LUT
+  float angle = -INV * TAU * (float(offset) / float(Ns));
+  vec2 w1 = vec2(cos(angle), sin(angle));
+
+  uint base = (x / Ns4) * Ns + offset; // floor(x / Ns4) * Ns + offset;
+  uint i0 = swizzle(base);
+  uint i1 = swizzle(base + Ns4);
+  uint i2 = swizzle(base + Ns4 * 2u);
+  uint i3 = swizzle(base + Ns4 * 3u);
+
+  vec2 t0 = row[i0];
+  vec2 t1 = cmul(w1, row[i1]);
+  vec2 w2 = cmul(w1, w1);
+  vec2 t2 = cmul(w2, row[i2]);
+  vec2 t3 = cmul(cmul(w2, w1), row[i3]);
+
+  row[i0] = t0 + t1 + t2 + t3;
+  row[i1] = t0 - t2 + vec2(t1.y - t3.y, t3.x - t1.x) * INV;
+  row[i2] = t0 - t1 + t2 - t3;
+  row[i3] = t0 - t2 + vec2(t3.y - t1.y, t1.x - t3.x) * INV;
+}
+
+/* usage:
+  uint y  = gl_GlobalInvocationID.y;
+  uint x0 = gl_GlobalInvocationID.x;
+  uint x1 = x0 + N_4_1;
+  uint x2 = x1 + N_4_1;
+  uint x3 = x2 + N_4_1;
+
+  vec4 t0 = imageLoad(input, ivec2(x0, y), 0);
+  vec4 t1 = imageLoad(input, ivec2(x1, y), 0);
+  vec4 t2 = imageLoad(input, ivec2(x2, y), 0);
+  vec4 t3 = imageLoad(input, ivec2(x3, y), 0);
+
+  rgbaRowFFT(y, x0...x3, t0...t3);
+
+  #if INV == 1
+    float normalizer = 1.0;
+  #else
+    float normalizer = 1.0 / float(N);
+  #endif
+  imageStore(output, ivec2(y, x0), t0 * normalizer);
+  imageStore(output, ivec2(y, x1), t1 * normalizer);
+  imageStore(output, ivec2(y, x2), t2 * normalizer);
+  imageStore(output, ivec2(y, x3), t3 * normalizer);
+*/
+
+// avoid passing x0-x3 to reduce register pressure, only pass x and compute others inside the function, can #define multiples of N_4_1
+void rgbaRowFFT(uint y, uint x, inout vec4 t0, inout vec4 t1, inout vec4 t2, inout vec4 t3) {
+	#if FFT_SIZE == 2048
+		// load rg as real and imag and do radix 2 prepass
+		uint p00 = digit_reverse_4(x) << 1;
+		row[swizzle(p00)]     = t0.rg + t2.rg;
+		row[swizzle(p00 + 1)] = t0.rg - t2.rg;
+
+		uint p01 = digit_reverse_4(x + N_4_1) << 1;
+		row[swizzle(p01)]     = t1.rg + t3.rg;
+		row[swizzle(p01 + 1)] = t1.rg - t3.rg;
+	#else
+		// load rg as real and imag
+		row[swizzle(digit_reverse_4(x))] = t0.rg;
+		row[swizzle(digit_reverse_4(x + N_4_1))] = t1.rg;
+		row[swizzle(digit_reverse_4(x + N_4_2))] = t2.rg;
+		row[swizzle(digit_reverse_4(x + N_4_3))] = t3.rg;
+	#endif
+  barrier();
+
+  for (uint Ns = START_Ns; Ns <= FFT_SIZE; Ns <<= 2) {
+    fftR4_CT(x, Ns);
+    barrier();
+  }
+
+  // store rg fft output
+  t0.rg = row[swizzle(x)];
+  t1.rg = row[swizzle(x + N_4_1)];
+  t2.rg = row[swizzle(x + N_4_2)];
+  t3.rg = row[swizzle(x + N_4_3)];
+  barrier();
+
+	#if FFT_SIZE == 2048
+		// load rg as real and imag and do radix 2 prepass
+		uint p10 = digit_reverse_4(x) << 1;
+		row[swizzle(p10)]     = t0.ba + t2.ba;
+		row[swizzle(p10 + 1)] = t0.ba - t2.ba;
+
+		uint p11 = digit_reverse_4(x + N_4_1) << 1;
+		row[swizzle(p11)]     = t1.ba + t3.ba;
+		row[swizzle(p11 + 1)] = t1.ba - t3.ba;
+	#else
+    // load ba as real and imag
+		row[swizzle(digit_reverse_4(x))] = t0.ba;
+		row[swizzle(digit_reverse_4(x + N_4_1))] = t1.ba;
+		row[swizzle(digit_reverse_4(x + N_4_2))] = t2.ba;
+		row[swizzle(digit_reverse_4(x + N_4_3))] = t3.ba;
+	#endif
+  barrier();
+
+  for (uint Ns = START_Ns; Ns <= FFT_SIZE; Ns <<= 2) {
+    fftR4_CT(x, Ns);
+    barrier();
+  }
+
+  // store combination of r and g FFT output (transposed)
+  t0.ba = row[swizzle(x)];
+  t1.ba = row[swizzle(x + N_4_1)];
+  t2.ba = row[swizzle(x + N_4_2)];
+  t3.ba = row[swizzle(x + N_4_3)];
+}
\ No newline at end of file
diff --git a/shaders/Lib/Compat/PhysicsOcean.glsl b/shaders/Lib/Compat/PhysicsOcean.glsl
new file mode 100644
index 0000000..8763347
--- /dev/null
+++ b/shaders/Lib/Compat/PhysicsOcean.glsl
@@ -0,0 +1,157 @@
+// Minimal Physics Mod ocean support layer for native physics_ocean wrappers.
+// Based on the mod's public-domain integration helper, trimmed to only the
+// pieces needed by this pack's water path.
+
+// Keep both defines like the donor helper:
+// - support marker for the mod
+// - actual compile-time feature switch for the shader code
+#define PHYSICS_OCEAN_SUPPORT
+#define PHYSICS_OCEAN
+
+const int PHYSICS_ITERATIONS_OFFSET = 13;
+const float PHYSICS_DRAG_MULT = 0.048;
+const float PHYSICS_XZ_SCALE = 0.035;
+const float PHYSICS_TIME_MULTIPLICATOR = 0.45;
+const float PHYSICS_W_DETAIL = 0.75;
+const float PHYSICS_FREQUENCY = 6.0;
+const float PHYSICS_SPEED = 2.0;
+const float PHYSICS_WEIGHT = 0.8;
+const float PHYSICS_FREQUENCY_MULT = 1.18;
+const float PHYSICS_SPEED_MULT = 1.07;
+const float PHYSICS_ITER_INC = 12.0;
+const float PHYSICS_NORMAL_STRENGTH = 0.6;
+
+uniform int physics_iterationsNormal;
+uniform vec2 physics_waveOffset;
+uniform ivec2 physics_textureOffset;
+uniform float physics_gameTime;
+uniform float physics_globalTime;
+uniform float physics_oceanHeight;
+uniform sampler2D physics_waviness;
+uniform float physics_oceanWaveHorizontalScale;
+uniform vec3 physics_modelOffset;
+uniform float physics_rippleRange;
+uniform float physics_foamAmount;
+uniform float physics_foamOpacity;
+uniform sampler2D physics_ripples;
+uniform sampler3D physics_foam;
+
+#ifdef PHYSICSMOD_VERTEX
+	out vec3 physics_localPosition;
+	out float physics_localWaviness;
+#endif
+
+#ifdef PHYSICSMOD_FRAGMENT
+	in vec3 physics_localPosition;
+	in float physics_localWaviness;
+#endif
+
+float physics_waveHeight(vec2 position, int iterations, float factor, float time){
+	position = (position - physics_waveOffset) * PHYSICS_XZ_SCALE * physics_oceanWaveHorizontalScale;
+	float iter = 0.0;
+	float frequency = PHYSICS_FREQUENCY;
+	float speed = PHYSICS_SPEED;
+	float weight = 1.0;
+	float height = 0.0;
+	float waveSum = 0.0;
+	float modifiedTime = time * PHYSICS_TIME_MULTIPLICATOR;
+
+	for (int i = 0; i < iterations; i++){
+		vec2 direction = vec2(sin(iter), cos(iter));
+		float x = dot(direction, position) * frequency + modifiedTime * speed;
+		float wave = exp(sin(x) - 1.0);
+		float result = wave * cos(x);
+		vec2 force = result * weight * direction;
+
+		position -= force * PHYSICS_DRAG_MULT;
+		height += wave * weight;
+		iter += PHYSICS_ITER_INC;
+		waveSum += weight;
+		weight *= PHYSICS_WEIGHT;
+		frequency *= PHYSICS_FREQUENCY_MULT;
+		speed *= PHYSICS_SPEED_MULT;
+	}
+
+	return height / waveSum * physics_oceanHeight * factor - physics_oceanHeight * factor * 0.5;
+}
+
+vec3 physics_waveNormal(const in vec2 position, const in vec2 direction, const in float factor, const in float time){
+	float oceanHeightFactor = physics_oceanHeight / 13.0;
+	float totalFactor = oceanHeightFactor * factor;
+	vec3 waveNormal = normalize(vec3(direction.x * totalFactor, PHYSICS_NORMAL_STRENGTH, direction.y * totalFactor));
+
+	vec2 eyePosition = position + physics_modelOffset.xz;
+	vec2 rippleFetch = (eyePosition + vec2(physics_rippleRange)) / (physics_rippleRange * 2.0);
+	vec2 rippleTexelSize = vec2(2.0 / textureSize(physics_ripples, 0).x, 0.0);
+	float left = texture(physics_ripples, rippleFetch - rippleTexelSize.xy).r;
+	float right = texture(physics_ripples, rippleFetch + rippleTexelSize.xy).r;
+	float top = texture(physics_ripples, rippleFetch - rippleTexelSize.yx).r;
+	float bottom = texture(physics_ripples, rippleFetch + rippleTexelSize.yx).r;
+	float totalEffect = left + right + top + bottom;
+
+	float normalx = left - right;
+	float normalz = top - bottom;
+	vec3 rippleNormal = normalize(vec3(normalx, 1.0, normalz));
+	return normalize(mix(waveNormal, rippleNormal, pow(totalEffect, 0.5)));
+}
+
+struct WavePixelData {
+	vec2 direction;
+	vec2 worldPos;
+	vec3 normal;
+	float foam;
+	float height;
+};
+
+WavePixelData physics_wavePixel(const in vec2 position, const in float factor, const in float iterations, const in float time){
+	vec2 wavePos = (position.xy - physics_waveOffset) * PHYSICS_XZ_SCALE * physics_oceanWaveHorizontalScale;
+	float iter = 0.0;
+	float frequency = PHYSICS_FREQUENCY;
+	float speed = PHYSICS_SPEED;
+	float weight = 1.0;
+	float height = 0.0;
+	float waveSum = 0.0;
+	float modifiedTime = time * PHYSICS_TIME_MULTIPLICATOR;
+	vec2 dx = vec2(0.0);
+
+	for (int i = 0; i < iterations; i++){
+		vec2 direction = vec2(sin(iter), cos(iter));
+		float x = dot(direction, wavePos) * frequency + modifiedTime * speed;
+		float wave = exp(sin(x) - 1.0);
+		float result = wave * cos(x);
+		vec2 force = result * weight * direction;
+
+		dx += force / pow(weight, PHYSICS_W_DETAIL);
+		wavePos -= force * PHYSICS_DRAG_MULT;
+		height += wave * weight;
+		iter += PHYSICS_ITER_INC;
+		waveSum += weight;
+		weight *= PHYSICS_WEIGHT;
+		frequency *= PHYSICS_FREQUENCY_MULT;
+		speed *= PHYSICS_SPEED_MULT;
+	}
+
+	WavePixelData data;
+	data.direction = -vec2(dx / pow(waveSum, 1.0 - PHYSICS_W_DETAIL));
+	data.worldPos = wavePos / physics_oceanWaveHorizontalScale / PHYSICS_XZ_SCALE;
+	data.height = height / waveSum * physics_oceanHeight * factor - physics_oceanHeight * factor * 0.5;
+	data.normal = physics_waveNormal(position, data.direction, max(0.1, factor), time);
+
+	float waveAmplitude = data.height * pow(max(data.normal.y, 0.0), 4.0);
+	vec2 waterUV = mix(position - physics_waveOffset, data.worldPos, clamp(factor * 2.0, 0.2, 1.0));
+	vec2 s1 = textureLod(physics_foam, vec3(waterUV * 0.26, physics_globalTime / 360.0), 0).rg;
+	vec2 s2 = textureLod(physics_foam, vec3(waterUV * 0.02, physics_globalTime / 360.0 + 0.5), 0).rg;
+	vec2 s3 = textureLod(physics_foam, vec3(waterUV * 0.1, physics_globalTime / 360.0 + 1.0), 0).rg;
+
+	float waterSurfaceNoise = s1.r * s2.r * s3.r * 2.8 * physics_foamAmount;
+	waveAmplitude = clamp(waveAmplitude * 1.2, 0.0, 1.0);
+	waterSurfaceNoise = (1.0 - waveAmplitude) * waterSurfaceNoise + waveAmplitude * physics_foamAmount;
+
+	float worleyNoise = 0.2 + 0.8 * s1.g * (1.0 - s2.g);
+	float waterFoamMinSmooth = 0.45;
+	float waterFoamMaxSmooth = 2.0;
+	waterSurfaceNoise = smoothstep(waterFoamMinSmooth, 1.0, waterSurfaceNoise) * worleyNoise;
+	data.foam = clamp(waterFoamMaxSmooth * waterSurfaceNoise * physics_foamOpacity, 0.0, 1.0);
+
+	return data;
+}
diff --git a/shaders/Lib/IndividualFunctions/Aurora.glsl b/shaders/Lib/IndividualFunctions/Aurora.glsl
new file mode 100644
index 0000000..6c763e5
--- /dev/null
+++ b/shaders/Lib/IndividualFunctions/Aurora.glsl
@@ -0,0 +1,154 @@
+#ifndef INCLUDE_AURORA
+#define INCLUDE_AURORA
+
+// Auroras by nimitz 2017 (twitter: @stormoid)
+// License Creative Commons Attribution-NonCommercial-ShareAlike 3.0 Unported License
+
+#define aurora_time frameTimeCounter
+
+mat2 aurora_mm2(in float a){float c = cos(a), s = sin(a);return mat2(c,s,-s,c);}
+mat2 aurora_m2 = mat2(0.95534, 0.29552, -0.29552, 0.95534);
+float aurora_tri(in float x){return clamp(abs(fract(x)-.5),0.01,0.49);}
+vec2 aurora_tri2(in vec2 p){return vec2(aurora_tri(p.x)+aurora_tri(p.y),aurora_tri(p.y+aurora_tri(p.x)));}
+
+float aurora_triNoise2d(in vec2 p, float spd)
+{
+    float z=1.8;
+    float z2=2.5;
+	float rz = 0.;
+    p *= aurora_mm2(p.x*0.06);
+    vec2 bp = p;
+	for (float i=0.; i<5.; i++ )
+	{
+        vec2 dg = aurora_tri2(bp*1.85)*.75;
+        dg *= aurora_mm2(aurora_time*spd);
+        p -= dg/z2;
+
+        bp *= 1.3;
+        z2 *= .45;
+        z *= .42;
+		p *= 1.21 + (rz-1.0)*.02;
+        
+        rz += aurora_tri(p.x+aurora_tri(p.y))*z;
+        p*= -aurora_m2;
+	}
+    return clamp(1./pow(rz*29., 1.3),0.,.55);
+}
+
+float aurora_hash21(in vec2 n){ return fract(sin(dot(n, vec2(12.9898, 4.1414))) * 43758.5453); }
+
+vec3 DrawAurora(vec3 worldDir) {
+    // Smoother horizon cut-off to avoid hard lines
+    float horizonFade = smoothstep(0.0, 0.2, worldDir.y);
+    if (horizonFade <= 0.0) return vec3(0.0);
+    
+    // User-specified origin
+    vec3 ro = vec3(0, 0, -6.7);
+    vec3 rd = worldDir;
+    
+    vec4 col = vec4(0);
+    vec4 avgCol = vec4(0);
+    
+    int preset = AURORA_COLOR_PRESET;
+    if (preset == 5) {
+        float daySeed = fract(tan(distance(vec2(float(worldDay) * 1.61803), vec2(float(worldDay) * 2.71828))) * 43758.5453);
+        preset = int(floor(daySeed * 5.0));
+    }
+
+    vec3 colorBase;
+    vec3 colorTop;
+
+    if (preset == 0) {
+        colorBase = vec3(0.05, 1.0, 0.4);
+        colorTop  = vec3(0.05, 0.4, 1.0);
+    } else if (preset == 1) {
+        colorBase = vec3(1.0, 0.05, 0.6);
+        colorTop  = vec3(0.3, 0.05, 1.0);
+    } else if (preset == 2) {
+        colorBase = vec3(0.05, 1.0, 0.3);
+        colorTop  = vec3(1.0, 0.05, 0.05);
+    } else if (preset == 3) {
+        colorBase = vec3(0.05, 1.0, 0.9);
+        colorTop  = vec3(1.0, 0.05, 0.9);
+    } else { // preset == 4
+        colorBase = vec3(0.3, 0.1, 1.0);
+        colorTop  = vec3(0.9, 0.05, 0.6);
+    }
+    
+    #ifdef PROGRAM_SKYIMAGE
+        vec2 ditherPos = vec2(gl_GlobalInvocationID.xy);
+    #else
+        vec2 ditherPos = gl_FragCoord.xy;
+    #endif
+
+    // Centralized mask for moonlight balance
+    float moonMask = smoothstep(0.0, 0.5, sunAngle) * (1.0 - smoothstep(0.5, 1.0, sunAngle));
+    float mask = (0.5 + 0.5 * moonMask);
+
+    for(float i=0.; i<32.; i++)
+    {
+        float of = 0.006*aurora_hash21(ditherPos)*smoothstep(0.,15., i);
+        float pt = ((0.8 + pow(i, 1.4) * 0.002) - ro.y) / (max(rd.y, 0.02));
+        pt -= of;
+    	vec3 bpos = ro + pt*rd;
+        vec2 p = bpos.zx;
+        
+        // Refined randomness - less aggressive warping
+        p += aurora_tri2(p * 0.04 + aurora_time * 0.001) * 3.0;
+        p *= aurora_mm2(sin(p.x * 0.015 + aurora_time * 0.005) * 0.3);
+        
+        float rzt = aurora_triNoise2d(p, 0.06);
+        
+        // Softer intensity mask to ensure visibility
+        float intensityMask = aurora_triNoise2d(p * 0.015, 0.002);
+        rzt *= smoothstep(0.05, 0.4, intensityMask + 0.1);
+        
+        // Sharp but vibrant trails
+        rzt = pow(max(rzt, 0.0), 1.6) * 2.2; 
+        
+        vec3 auroraColor = mix(colorBase, colorTop, i / 32.0);
+        vec4 col2 = vec4(auroraColor * rzt, rzt);
+        
+        avgCol = mix(avgCol, col2, 0.5);
+        col += avgCol * exp2(-i * 0.065 - 2.5) * smoothstep(0.0, 5.0, i);
+    }
+    
+    // Smooth horizon fade
+    col *= horizonFade * exp(-max(0.0, 0.12 - rd.y) * 12.0);
+    
+    // Final balanced intensity for maximum vibrancy and GI
+    return col.rgb * 0.25; 
+}
+
+// Smooth mask for biome and time transitions
+float GetAuroraMask() {
+    #if !defined AURORA || !defined DIMENSION_OVERWORLD
+        return 0.0;
+    #endif
+
+    // Time fade: Smoothly fade in/out during tick brackets
+    float timeMask = smoothstep(11500.0, 12500.0, float(worldTime)) * (1.0 - smoothstep(23000.0, 24000.0, float(worldTime)));
+    
+    // Moon mask for consistent brightness balance
+    float moonMask = smoothstep(0.0, 0.5, sunAngle) * (1.0 - smoothstep(0.5, 1.0, sunAngle));
+    float mask = timeMask * (0.5 + 0.5 * moonMask);
+
+    // Biome fade: Smooth transition based on biome weights
+    #ifdef AURORA_BIOME_RESTRICTION
+        float biomeMask = smoothstep(0.0, 0.2, max(eyeSnowySmooth, BiomeHotSmooth));
+    #else
+        float biomeMask = 1.0;
+    #endif
+    
+    #ifdef AURORA_FORCE
+        return mask * biomeMask;
+    #endif
+
+    // Robust daily probability hash (Gold Noise)
+    float dayHash = fract(tan(distance(vec2(float(worldDay) * 1.61803), vec2(float(worldDay) * 2.71828))) * 43758.5453);
+    float probMask = step(dayHash, AURORA_PROBABILITY);
+
+    return mask * biomeMask * probMask;
+}
+
+#endif
