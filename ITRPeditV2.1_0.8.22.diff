+
+			}else{
+				ircColor += ircColor100.rgb *  f.x * rf.y * rf.z;
+				ircColor += ircColor001.rgb * rf.x * rf.y *  f.z;
+				ircColor += ircColor010.rgb * rf.x *  f.y * rf.z;
+				ircColor += ircColor101.rgb *  f.x * rf.y *  f.z;
+				ircColor += ircColor110.rgb *  f.x *  f.y * rf.z;
