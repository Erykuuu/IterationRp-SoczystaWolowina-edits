+#include "/Lib/IndividualFunctions/WeatherEngine.glsl"
+
+#if CLOUD_STYLE == 1
+
+// ================= CUSTOM EDIT PLANAR CLOUDS (ITRPedit) =================
+
+float BicubicBlurNoise(vec2 coord){
+	coord = mod(coord * (1.2e-4 * 128.0), 128.0) - 0.5;
+
+	vec2 p = floor(coord);
+	vec2 f = coord - p;
+
+	vec2 ff = f * f;
+	vec4 w0;
+	vec4 w1;
+	w0.xz = 1.0 - f; w0.xz *= w0.xz * w0.xz;
+	w1.yw = ff * f;
+	w1.xz = 3.0 * w1.yw + 4.0 - 6.0 * ff;
+	w0.yw = 6.0 - w1.xz - w1.yw - w0.xz;
+
+	vec4 s = w0 + w1;
+	vec4 c = p.xxyy + vec2(-0.5, 1.5).xyxy + w1 / s;
+	c *= 1.0 / 128.0;
+
+	vec2 m = s.xz / (s.xz + s.yw);
+	return mix(mix(textureLod(noisetex, c.yw, 0.0).w, textureLod(noisetex, c.xw, 0.0).w, m.x),
+			   mix(textureLod(noisetex, c.yz, 0.0).w, textureLod(noisetex, c.xz, 0.0).w, m.x),
+			   m.y);
+}
+
+float BilinearNoise(vec2 position) {
+	return textureLod(noisetex, mod(position * 1.2e-4, 1.0), 0.0).w;
+}
+
+
+
+float GetPlanarCloudsDistortion(vec2 movingPos){
+	float density = BilinearNoise(movingPos * 0.5);
+	float scale = 4.0;
+	for (int i = 0; i < 2; i++, scale *= 2.0){
+		density += BilinearNoise(movingPos * scale) * pow(scale, -1.0);
+	}
+	return density;
+}
+
+vec2 GetPlanarMovingPos(vec2 centerPosition, vec2 cameraPosition, vec2 windDirection) {
+	vec2 position = (centerPosition + cameraPosition + 10000.0) * PC_NOISE_SCALE;
+	vec2 movingPos = position - windDirection;
+
+	#if CLOUD_PLANAR_TYPE == 4
+		float cycle = CLOUD_ANIM_TIME * 0.006 * CLOUD_TRANSITION_SPEED;
+		float w1 = saturate(sin(cycle) * 1.5);             
+		float w2 = saturate(sin(cycle + 2.09) * 1.5);      
+		float w3 = saturate(sin(cycle + 4.18) * 1.5);      
+		float totalW = w1 + w2 + w3 + 1e-5;
+		float cirrusWeight = w1 / totalW;
+		float curlsWeight  = w2 / totalW;
+
+		if (cirrusWeight > 0.001) {
+			vec2 cirrusUV = movingPos;
+			cirrusUV.x *= 0.45; 
+			float warp = BicubicBlurNoise(cirrusUV * 0.4 + windDirection * 0.05);
+			cirrusUV += vec2(warp, warp * 0.2) * 0.8;
+			movingPos = mix(movingPos, cirrusUV, cirrusWeight);
+		}
+
+		if (curlsWeight > 0.001) {
+			vec2 curlsUV = movingPos;
+			vec2 warpUV = curlsUV * 0.4;
+			vec2 warpOffset = vec2(BilinearNoise(warpUV), BilinearNoise(warpUV + 0.5));
+			curlsUV += warpOffset * 1.5;
+			movingPos = mix(movingPos, curlsUV, curlsWeight);
+		}
+	#elif CLOUD_PLANAR_TYPE == 1 // Cirrus
+		movingPos.x *= 0.45; 
+		float warp = BicubicBlurNoise(movingPos * 0.4 + windDirection * 0.05);
+		movingPos += vec2(warp, warp * 0.2) * 0.8;
+	#elif CLOUD_PLANAR_TYPE == 2 // Cirrocumulus
+		vec2 warpUV = movingPos * 0.4;
+		vec2 warpOffset = vec2(BilinearNoise(warpUV), BilinearNoise(warpUV + 0.5));
+		movingPos += warpOffset * 1.5;
+	#endif
+
+	return movingPos;
+}
+
+float GetPlanarCloudsDensity(vec2 centerPosition, vec2 cameraPosition, vec2 coverageDensity, vec2 windDirection){
+	vec2 movingPos = GetPlanarMovingPos(centerPosition, cameraPosition, windDirection);
+
+	float distortion = GetPlanarCloudsDistortion(movingPos);
+	movingPos += distortion * 100.0;
+
+	const float octScale = 2.45;
+	const mat2 rotateGoldenAngle = octScale * rotMatGA;
+
+	float density = BicubicBlurNoise(movingPos);
+	mat2 rot = rotateGoldenAngle;
+	float weights = 1.0;
+
+	float softnessBias = mix(0.45, 0.95, saturate(PC_SOFTNESS / 20.0));
+	
+	// Performance Fix: Locked to 6 octaves for speed as requested
+	for (int i = 1; i <= 6; i++, rot = rotateGoldenAngle * rot){
+		float scale = fsqrt(float(i));
+		
+		float angle = float(i) * 2.399; 
+		mat2 octaveRot = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
+		
+		vec2 noisePosition = (rot * octaveRot) * (movingPos * scale);
+		noisePosition *= vec2(0.8, 1.2); 
+
+		float weight = pow(octScale, -softnessBias * i);
+
+		density += textureLod(noisetex, mod(noisePosition * (1.2e-4 * 128.0), 128.0) / 128.0, PC_SOFTNESS / 8.0).w * weight;
+		weights += weight;
+	}
+	density /= weights;
+
+	float detail = 0.0;
+	float detailWeights = 0.0;
+	float freq = 3.5; 
+	float amp = 0.5;
+	int detailOctaves = clamp(PC_QUALITY / 3 + 2, 2, 10);
+	for (int i = 0; i < detailOctaves; i++){
+		detail += BicubicBlurNoise(movingPos * freq) * amp; 
+		detailWeights += amp;
+		freq *= 2.15;
+		amp *= mix(0.5, 0.2, saturate(PC_SOFTNESS / 20.0)); 
+	}
+	density = mix(density, detail / detailWeights, mix(0.4, 0.05, saturate(PC_SOFTNESS / 20.0)));
+
+	#if CLOUD_PLANAR_TYPE == 3 // Altocumulus (Ice Scales)
+		density = pow(saturate(density * 1.1 - 0.1), 2.5); 
+		density = saturate(density * 1.8 - 0.6 + coverageDensity.x * 0.4);
+	#elif CLOUD_PLANAR_TYPE == 4
+		float cycle = CLOUD_ANIM_TIME * 0.006 * CLOUD_TRANSITION_SPEED;
+		float scalesWeight = saturate(sin(cycle + 4.18) * 1.5);
+		scalesWeight /= (saturate(sin(cycle) * 1.5) + saturate(sin(cycle + 2.09) * 1.5) + scalesWeight + 1e-5);
+		
+		float scalesDensity = pow(saturate(density * 1.1 - 0.1), 2.5);
+		scalesDensity = saturate(scalesDensity * 1.7 - 0.5 + coverageDensity.x * 0.4);
+		
+		float baseDensity = saturate(density * 1.25 - 1.25 + coverageDensity.x);
+		density = mix(baseDensity, scalesDensity, scalesWeight);
+	#else
+		// Softer remapping for standard/cirrus modes
+		density = saturate(density * 1.25 - 1.25 + coverageDensity.x);
+	#endif
+
+	density *= exp(-distortion * 0.35);
+	
+	float finalDensity = density * density * coverageDensity.y;
+
+	#ifdef CLOUD_PLANAR_DOUBLE_LAYER
+		vec2 lagPos = movingPos + windDirection * 0.15 + vec2(15.0, 10.0);
+		float shadowLayer = BicubicBlurNoise(lagPos * 0.85);
+		shadowLayer = saturate(shadowLayer * 2.2 - 1.1);
+		finalDensity = mix(finalDensity * 0.65, finalDensity, shadowLayer * 0.5 + 0.5);
+	#endif
+
+	return finalDensity;
+}
+
+float GetPlanarCloudsLightingDensity(vec2 centerPosition, vec2 cameraPosition, vec2 coverageDensity, vec2 windDirection){
+	vec2 movingPos = GetPlanarMovingPos(centerPosition, cameraPosition, windDirection);
+
+	float distortion = GetPlanarCloudsDistortion(movingPos);
+	movingPos += distortion * 120.0;
+
+	const float octScale = 2.45;
+	const mat2 rotateGoldenAngle = octScale * rotMatGA;
+
+	float density = BicubicBlurNoise(movingPos);
+	mat2 rot = rotateGoldenAngle;
+	float weights = 1.0;
+
+	float softnessBias = mix(0.6, 1.15, saturate(PC_SOFTNESS / 20.0));
+
+	// Performance Fix: Locked to 3 octaves for speed as requested
+	for (int i = 1; i <= 3; i++, rot = rotateGoldenAngle * rot){
+		float scale = fsqrt(float(i));
+		
+		float angle = float(i) * 2.399; 
+		mat2 octaveRot = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
+		
+		vec2 noisePosition = (rot * octaveRot) * (movingPos * scale);
+		noisePosition *= vec2(1.0 - 0.35 * scale, 1.0 + 0.05 * scale);
+
+		float weight = pow(octScale, -softnessBias * i);
+
+		density += textureLod(noisetex, mod(noisePosition * (1.2e-4 * 128.0), 128.0) / 128.0, PC_SOFTNESS / 8.0).w * weight;
+		weights += weight;
+	}
+	density /= weights;
+
+	#if CLOUD_PLANAR_TYPE == 3
+		density = pow(saturate(density * 1.1 - 0.1), 2.5);
+		density = saturate(density * 1.7 - 0.5 + coverageDensity.x * 0.4);
+	#elif CLOUD_PLANAR_TYPE == 4
+		float cycle = CLOUD_ANIM_TIME * 0.006 * CLOUD_TRANSITION_SPEED;
+		float scalesWeight = saturate(sin(cycle + 4.18) * 1.5);
+		scalesWeight /= (saturate(sin(cycle) * 1.5) + saturate(sin(cycle + 2.09) * 1.5) + scalesWeight + 1e-5);
+		
+		float scalesDensity = pow(saturate(density * 1.1 - 0.1), 2.5);
+		scalesDensity = saturate(scalesDensity * 1.7 - 0.5 + coverageDensity.x * 0.4);
+		
+		float baseDensity = saturate(density * 1.15 - 1.2 + coverageDensity.x);
+		density = mix(baseDensity, scalesDensity, scalesWeight);
+	#else
+		density = saturate(density * 1.15 - 1.2 + coverageDensity.x);
+	#endif
+
+	density *= exp(-distortion * 0.9);
+	
+	return density * density * coverageDensity.y;
+}
+
+vec2 GetPlanarCloudWind(){
+	float wind = 0.001 * (CLOUD_ANIM_TIME * CLOUD_SPEED + 10.0 * FTC_OFFSET);
+	return vec2(-wind, wind * 0.2);
+}
+
+vec2 GetPlanarCloudCoverage(){
+	WeatherState weather = GetWeatherEngineState();
+	
+	#ifdef CLOUD_WEATHER_NETWORK
+		float pcClearCoverage = mix(PC_COVERAGE_MIN, PC_COVERAGE_MAX, weather.targetCoverage);
+		float pcClearDensity  = PC_CLEAR_DENSITY * weather.densityMul;
+	#elif defined CLOUD_DYNAMIC_COVERAGE
+		float pcDynT = sin(CLOUD_ANIM_TIME * CLOUD_TRANSITION_SPEED * 1e-3) * 0.5 + 0.5;
+		pcDynT = smoothstep(0.0, 1.0, pcDynT);
+		float pcClearCoverage = mix(PC_COVERAGE_MIN, PC_COVERAGE_MAX, pcDynT);
+		float pcClearDensity  = PC_CLEAR_DENSITY;
+	#else
+		float pcClearCoverage = PC_CLEAR_COVERAGE;
+		float pcClearDensity  = PC_CLEAR_DENSITY;
+	#endif
+
+	vec2 coverageDensity = mix(vec2(pcClearCoverage, pcClearDensity), vec2(PC_RAIN_COVERAGE, PC_RAIN_DENSITY), wetness);
+	coverageDensity.x = saturate(coverageDensity.x);
+
+	return coverageDensity;
+}
+
+void PlanarClouds(inout vec3 color, vec3 worldDir, vec3 colorSun, vec3 colorSky, vec3 camera, float dither, float maxDistance, float cloudTransmittance){
+	float planetRadius = atmosphereModel_bottom_radius * 1e3;
+
+	float R = planetRadius;
+	float h = cameraPosition.y;
+	float H = PC_ALTITUDE;
+
+	float b = (R + h) * worldDir.y;
+	float c = (h - H) * (2.0 * R + h + H);
+	float d = b * b - c;
+
+	if (d >= 0.0){
+		float intersection = -b + sqrt(d);
+
+		vec3 rayStartPos = vec3(0.0, planetRadius + cameraPosition.y, 0.0);
+		float iPlanet = RaySphereIntersection(rayStartPos, worldDir, planetRadius).x;
+
+		if (intersection > 0.0 && intersection < maxDistance && (iPlanet < 0.0 || intersection < iPlanet)){
+			vec2 windDirection = GetPlanarCloudWind();
+			vec2 coverageDensity = GetPlanarCloudCoverage();
+
+		float VdotL = dot(worldDir, worldShadowVector) * 0.5 + 0.5;
+
+		vec3 centerPosition = worldDir * intersection;
+		vec2 cpXZ = centerPosition.xz;
+		vec2 camXZ = cameraPosition.xz;
+
+		cloudTransmittance = min(GetPlanarCloudsDensity(cpXZ, camXZ, coverageDensity, windDirection) * cloudTransmittance * 40.0, 0.92);
+		#ifdef VOLUMETRIC_CLOUDS
+			cloudTransmittance *= 1.0 - wetness;
+		#endif
+		
+		if (cloudTransmittance > 1e-5){
+			float stepLength = mix(150.0, 0.0, worldShadowVector.z);
+			
+			cpXZ += stepLength * dither * worldShadowVector.xy;
+
+			float lightingDepth = 0.0;
+			int samples = clamp(PC_QUALITY, 2, 12);
+			for (int i = 0; i < samples; i++, cpXZ += worldShadowVector.xy * stepLength, stepLength *= 1.5){
+				lightingDepth += GetPlanarCloudsLightingDensity(cpXZ, camXZ, coverageDensity, windDirection) * stepLength;
+			}
+
+			float sunlightEnergy = 1.0 / (lightingDepth + 1.0);
+			float powderFactor = exp2(-cloudTransmittance * (worldShadowVector.y * 5.0 + 0.5));
+			
+			// Spectral Ice Lighting: Adjust phase function for translucency
+			#if CLOUD_PLANAR_TYPE > 0
+				sunlightEnergy *= MiePhaseFunction(powderFactor * 0.1, VdotL * 0.5 + 0.5); // Minimal forward scattering (g near 0)
+				sunlightEnergy *= mix(1.0, 1.3, saturate(1.0 - cloudTransmittance)); // High translucency
+			#else
+				sunlightEnergy *= MiePhaseFunction(powderFactor * 0.8, VdotL * 0.5 + 0.5);
+				sunlightEnergy *= MiePhaseFunction(0.9, VdotL) * 0.4 + 1.0;
+			#endif
+
+			vec3 cloudColor = colorSun * (sunlightEnergy * mix(PC_CLEAR_SUNLIGHTING, PC_RAIN_SUNLIGHTING, wetness) * 7.0);
+
+			#ifdef CLOUD_PLANAR_SPECTRAL
+				// Optimized Chromatic Fringe: Use a single low-res sample instead of full density recursion
+				float fringeSpread = mix(15.0, 45.0, saturate(1.0 - VdotL));
+				vec2 fringeDir = worldShadowVector.xy * fringeSpread * 0.0001;
+				
+				float densityR = textureLod(noisetex, mod((cpXZ + fringeDir) * (1.2e-4 * 128.0), 128.0) / 128.0, 2.0).w;
+				float densityB = textureLod(noisetex, mod((cpXZ - fringeDir) * (1.2e-4 * 128.0), 128.0) / 128.0, 2.0).w;
+				
+				float diff = (densityR - densityB);
+				cloudColor *= mix(vec3(1.0), vec3(1.1, 1.0, 1.2), diff * 0.3 * saturate(1.0 - cloudTransmittance));
+			#endif
+
+			float skylightEnergy = exp2(-cloudTransmittance * 0.15);
+
+			cloudColor += colorSky * (skylightEnergy * mix(PC_CLEAR_SKYLIGHTING, PC_RAIN_SKYLIGHTING, wetness) * 0.2);
+
+			cloudTransmittance *= exp2(-(length(centerPosition) + 2e3) * 4e-5);
+
+			vec3 atmoPoint = camera + centerPosition * 0.001;
+			vec3 transmittance;
+			vec3 sunDir = worldShadowVector * (step(sunAngle, 0.5) * 2.0 - 1.0);
+			vec3 aerialPerspective = GetSkyRadianceToPoint(camera, atmoPoint, sunDir, -sunDir, transmittance);
+
+			vec3 colorShift = mix(vec3(1.0), vec3(1.1, 0.9, 1.2), cloudTransmittance);
+			cloudColor *= colorShift;
+
+			color *= (1.0 - cloudTransmittance);
+			color += (cloudColor * transmittance + aerialPerspective) * cloudTransmittance;
+		}
+		}
+	}
+}
+
+#else
+
+// ================= ORIGINAL PLANAR CLOUDS (IterationRP) =================
+
+float BicubicBlurNoise(vec2 coord){
+	coord = coord * (1.2e-4 * 128.0) - 0.5;
+
+	vec2 p = floor(coord);
+	vec2 f = coord - p;
+
+	vec2 ff = f * f;
+	vec4 w0;
+	vec4 w1;
+	w0.xz = 1.0 - f; w0.xz *= w0.xz * w0.xz;
+	w1.yw = ff * f;
+	w1.xz = 3.0 * w1.yw + 4.0 - 6.0 * ff;
+	w0.yw = 6.0 - w1.xz - w1.yw - w0.xz;
+
+	vec4 s = w0 + w1;
+	vec4 c = p.xxyy + vec2(-0.5, 1.5).xyxy + w1 / s;
+	c *= 1.0 / 128.0;
+
+	vec2 m = s.xz / (s.xz + s.yw);
+	return mix(mix(textureLod(noisetex, c.yw, 0.0).w, textureLod(noisetex, c.xw, 0.0).w, m.x),
+			   mix(textureLod(noisetex, c.yz, 0.0).w, textureLod(noisetex, c.xz, 0.0).w, m.x),
+			   m.y);
+}
+
+float BilinearNoise(vec2 position) {
+	return textureLod(noisetex, position * 1.2e-4, 0.0).w;
+}
+
+float GetPlanarCloudsDistortion(vec2 position, vec2 windDirection){
+	float density = BilinearNoise(position - windDirection);
+	float scale = 10.0;
+	for (int i = 0; i < 3; i++, scale *= 3.0){
+		density += BilinearNoise(scale * (position - windDirection * fsqrt(scale))) * pow(scale, -1.3);
+	}
+	return density;
+}
+
+float GetPlanarCloudsDensity(vec2 position, vec2 coverageDensity, vec2 windDirection){
+	position = position * PC_NOISE_SCALE + vec2(10000.0);
+
+	float distortion = GetPlanarCloudsDistortion(position, windDirection);
+	position += distortion * 300.0;
+
+	const float octScale = 2.8;
+	const mat2 rotateGoldenAngle = octScale * rotMatGA;
+
+	float density = BicubicBlurNoise(position - windDirection);
+	mat2 rot = rotateGoldenAngle;
+	float weights = 1.0;
+
+	for (float i = 1.0; i <= 6.0; i++, rot = rotateGoldenAngle * rot){
+		float scale = fsqrt(i);
+		
+		vec2 noisePosition = rot * (position - windDirection * scale);
+		noisePosition *= vec2(1.0 - 0.35 * scale, 1.0 + 0.05 * scale);
+
+		float weight = pow(octScale, -0.85 * i);
+
+		density += BicubicBlurNoise(noisePosition) * weight;
+		weights += weight;
+	}
+	density /= weights;
+
+	density = saturate(density * 1.4 - 1.45 + coverageDensity.x);
+	density *= exp(-distortion);
+	
+	return density * density * coverageDensity.y;
+}
+
+float GetPlanarCloudsLightingDensity(vec2 position, vec2 coverageDensity, vec2 windDirection){
+	position = position * PC_NOISE_SCALE + vec2(10000.0);
+
+	float distortion = GetPlanarCloudsDistortion(position, windDirection);
+	position += distortion * 300.0;
+
+	const float octScale = 2.8;
+	const mat2 rotateGoldenAngle = octScale * rotMatGA;
+
+	float density = BicubicBlurNoise(position - windDirection);
+	mat2 rot = rotateGoldenAngle;
+	float weights = 1.0;
+
+	for (float i = 1.0; i <= 3.0; i++, rot = rotateGoldenAngle * rot){
+		float scale = fsqrt(i);
+		
+		vec2 noisePosition = rot * (position - windDirection * scale);
+		noisePosition *= vec2(1.0 - 0.35 * scale, 1.0 + 0.05 * scale);
+
+		float weight = pow(octScale, -0.85 * i);
+
+		density += BilinearNoise(noisePosition) * weight;
+		weights += weight;
+	}
+	density /= weights;
+
+	density = saturate(density * 1.4 - 1.45 + coverageDensity.x);
+	density *= exp(-distortion);
+	
+	return density * density * coverageDensity.y;
+}
+
+void PlanarClouds(inout vec3 color, vec3 worldDir, vec3 colorSun, vec3 colorSky, vec3 camera, float dither, float maxDistance, float cloudTransmittance){
+	float planetRadius = atmosphereModel_bottom_radius * 1e3;
+
+	vec3 rayStartPos = vec3(0.0, planetRadius + cameraPosition.y, 0.0);
+	float intersection = RaySphereIntersection(rayStartPos, worldDir, planetRadius + PC_ALTITUDE).y;
+
+	if (intersection > 0.0 && intersection < maxDistance){
+		float wind = 2.5 * (frameTimeCounter * CLOUD_SPEED + 10.0 * FTC_OFFSET);
+		vec2 windDirection = vec2(-wind, wind * 0.2);
+
+		#if CLOUD_STYLE == 2
+			WeatherState weather = GetWeatherEngineState();
+			#ifdef CLOUD_WEATHER_NETWORK
+				float clearCovery = mix(CLOUD_COVERAGE_MIN, CLOUD_COVERAGE_MAX, weather.targetCoverage);
+				clearCovery = mix(clearCovery, 0.92, weather.rainFactor);
+			#elif defined CLOUD_DYNAMIC_COVERAGE
+				float dynT = sin(frameTimeCounter * CLOUD_TRANSITION_SPEED * 2e-4) * 0.5 + 0.5;
+				dynT = smoothstep(0.0, 1.0, dynT);
+				float clearCovery = mix(CLOUD_COVERAGE_MIN, CLOUD_COVERAGE_MAX, dynT);
+			#else
+				float clearCovery = PC_CLEAR_COVERAGE;
+			#endif
+		#else
+			float clearCovery = PC_CLEAR_COVERAGE;
+		#endif
+
+		vec2 coverageDensity = mix(vec2(clearCovery, PC_CLEAR_DENSITY), vec2(PC_RAIN_COVERAGE, PC_RAIN_DENSITY), wetness);
+
+		float VdotL = dot(worldDir, worldShadowVector) * 0.5 + 0.5;
+
+		vec3 centerPosition = worldDir * intersection;
+
+		vec2 samplePosition = centerPosition.xz + cameraPosition.xz;
+
+		cloudTransmittance = min(GetPlanarCloudsDensity(samplePosition, coverageDensity, windDirection) * cloudTransmittance * 40.0, 0.92);
+		#ifdef VOLUMETRIC_CLOUDS
+			cloudTransmittance *= 1.0 - wetness;
+		#endif
+		
+		if (cloudTransmittance > 1e-5){
+			float stepLength = mix(150.0, 0.0, worldShadowVector.z);
+			
+			samplePosition += stepLength * dither * worldShadowVector.xy;
+
+			float lightingDepth = 0.0;
+			for (int i = 0; i < 4; i++, samplePosition += worldShadowVector.xy * stepLength, stepLength *= 1.5){
+				lightingDepth += GetPlanarCloudsLightingDensity(samplePosition, coverageDensity, windDirection) * stepLength;
+			}
+
+			float sunlightEnergy = 1.0 / (lightingDepth + 1.0);
+			float powderFactor = exp2(-cloudTransmittance * (worldShadowVector.y * 5.0 + 0.5));
+			sunlightEnergy *= MiePhaseFunction(powderFactor * 0.8, VdotL * 0.5 + 0.5);
+			sunlightEnergy *= MiePhaseFunction(0.9, VdotL) * 0.4 + 1.0;
+			vec3 cloudColor = colorSun * (sunlightEnergy * mix(PC_CLEAR_SUNLIGHTING, PC_RAIN_SUNLIGHTING, wetness) * 7.0);
+
+			float skylightEnergy = exp2(-cloudTransmittance * 0.15);
+
+			cloudColor += colorSky * (skylightEnergy * mix(PC_CLEAR_SKYLIGHTING, PC_RAIN_SKYLIGHTING, wetness) * 0.2);
+
+			cloudTransmittance *= exp2(-(length(centerPosition) + 2e3) * 4e-5);
+
+			vec3 atmoPoint = camera + centerPosition * 0.001;
+			vec3 transmittance;
+			vec3 aerialPerspective = GetSkyRadianceToPoint(camera, atmoPoint, worldSunVector, -worldSunVector, transmittance);
+
+			color *= (1.0 - cloudTransmittance);
+			color += (cloudColor * transmittance + aerialPerspective) * cloudTransmittance;
+		}
+	}
+}
+
+#endif // CLOUD_STYLE
diff --git a/shaders/Lib/IndividualFunctions/Rainbow.glsl b/shaders/Lib/IndividualFunctions/Rainbow.glsl
new file mode 100644
index 0000000..c11a009
--- /dev/null
+++ b/shaders/Lib/IndividualFunctions/Rainbow.glsl
@@ -0,0 +1,164 @@
+
+// ============================================================
+// Rainbow.glsl — Atmospheric Rainbow (Death Stranding style)
+// ============================================================
+//
+//  Physics:
+//    Primary bow:   ~42° from anti-solar point, red outer / violet inner
+//    Secondary bow: ~51°, violet outer / red inner (Alexander's dark band between)
+//    Supernumerary: faint oscillating fringes just inside the primary bow
+//
+//  Visibility conditions:
+//    - Sun elevation below ~42° (so the bow rim is above the horizon)
+//    - Some recent rain / overcast wetness
+//    - Not raining so hard that sky is fully obscured
+//    - Slowly time-varying probability (RAINBOW_PROBABILITY)
+//
+//  All brightness values are in the same linear HDR space as the rest of
+//  Sky_Overworld_FS.glsl. RAINBOW_BRIGHTNESS default 1.0 matches the
+//  look of Death Stranding's rainbow (vivid but not blown out).
+// ============================================================
+
+// ---- Spectral colour -------------------------------------------------------
+// Piecewise wavelength (nm) → linear-light sRGB.
+// Based on Bruton's algorithm, squared to convert from perceptual to linear.
+vec3 _RbWavelengthToRGB(float w) {
+    vec3 c;
+    if      (w < 440.0) { c = vec3((440.0-w)/60.0, 0.0,             1.0            ); }
+    else if (w < 490.0) { c = vec3(0.0,             (w-440.0)/50.0,  1.0            ); }
+    else if (w < 510.0) { c = vec3(0.0,             1.0,             (510.0-w)/20.0 ); }
+    else if (w < 580.0) { c = vec3((w-510.0)/70.0,  1.0,             0.0            ); }
+    else if (w < 645.0) { c = vec3(1.0,             (645.0-w)/65.0,  0.0            ); }
+    else                { c = vec3(1.0,             0.0,             0.0            ); }
+    return c * c; // gamma → linear light
+}
+
+// Spectral colour with saturation control and optional sun-colour tint.
+// t: 0 = violet end, 1 = red end (maps to 400–700 nm)
+vec3 _RbSpectrum(float t, vec3 sunColor, float saturation) {
+    float w      = mix(400.0, 700.0, saturate(t));
+    vec3  pure   = _RbWavelengthToRGB(w);
+    float lum    = dot(pure, vec3(0.2126, 0.7152, 0.0722));
+    vec3  grey   = vec3(lum);
+    vec3  sat    = mix(grey, pure, saturation);
+
+    // Subtle solar tint: sunset rainbows lean warm, midday lean cool
+    vec3 sunNorm = normalize(sunColor + vec3(0.001));
+    return mix(sat, sat * sunNorm * (length(pure) + 0.3), 0.18);
+}
+
+// ---- Main rainbow renderer -------------------------------------------------
+
+void RenderRainbow(inout vec3 color, vec3 worldDir, vec3 sunDir,
+                   vec3 sunColor, float rainbowStrength)
+{
+    if (rainbowStrength < 0.001) return;
+    // Only sky pixels above horizon
+    if (worldDir.y < -0.04) return;
+
+    vec3  antiSun  = -sunDir;
+    float cosTheta = clamp(dot(worldDir, antiSun), -1.0, 1.0);
+    float thetaDeg = degrees(acos(cosTheta));
+
+    float sat = RAINBOW_SATURATION;
+
+    // ---- Primary bow (40.4° – 42.5°) ----------------------------------------
+    // t=0 → violet at inner edge (40.4°), t=1 → red at outer edge (42.5°)
+    {
+        const float thetaMin = 40.4;
+        const float thetaMax = 42.5;
+        float t = (thetaDeg - thetaMin) / (thetaMax - thetaMin);
+
+        if (t > -0.6 && t < 1.6) {
+            // Radial profile: gaussian-ish, sharpest at the red (outer) edge
+            float profile = 1.0 - abs(t - 0.5) / 0.5;
+            profile = saturate(profile);
+            profile = profile * profile * (3.0 - 2.0 * profile); // smoothstep shape
+
+            // Extra sharpness at outer (red) edge — physically real
+            profile *= mix(0.7, 1.0, saturate((t - 0.5) * 3.0 + 0.5));
+
+            vec3 spectral = _RbSpectrum(saturate(t), sunColor, sat);
+            color += spectral * profile * rainbowStrength * 0.12;
+
+            // Supernumerary fringes: oscillating bands just inside the primary bow.
+            // They arise from wave interference and give that DS "haunted" quality.
+            if (t < 0.05) {
+                float inner = saturate(-t * 2.5); // ramps up as we move inside the bow
+                float fringes = sin(t * 28.0 * 3.14159 + 1.5) * 0.5 + 0.5;
+                fringes *= inner * 0.3;
+                // Fringes are nearly white / pale blue
+                vec3 fringeColor = mix(vec3(0.5, 0.6, 1.0), vec3(0.9, 0.95, 1.0), saturate(-t * 4.0));
+                color += fringeColor * fringeColor * fringes * rainbowStrength * 0.025;
+            }
+
+            // Alexander's dark band: between primary outer edge and secondary inner edge
+            // (42.5° – 50°). We don't add light here — the natural effect is
+            // that this region *lacks* the extra backscatter the bow provides.
+            // A subtle desaturation of the sky behind emulates the perceived darkening.
+            if (t > 1.0 && thetaDeg < 50.0) {
+                float bandFade = remapSaturate(thetaDeg, 42.5, 50.0) *
+                                 remapSaturate(thetaDeg, 50.0, 45.0);
+                color *= mix(1.0, 0.82, bandFade * rainbowStrength * 0.6);
+            }
+        }
+    }
+
+    // ---- Secondary bow (50.0° – 53.5°) — reversed order ---------------------
+    // t=0 → red at inner edge (50°), t=1 → violet at outer edge (53.5°)
+    #ifdef RAINBOW_SECONDARY
+    {
+        const float thetaMin = 50.0;
+        const float thetaMax = 53.5;
+        float t = (thetaDeg - thetaMin) / (thetaMax - thetaMin);
+
+        if (t > -0.6 && t < 1.6) {
+            float profile = 1.0 - abs(t - 0.5) / 0.5;
+            profile = saturate(profile);
+            profile = profile * profile * (3.0 - 2.0 * profile);
+
+            // Reversed: t=0→red end of spectrum, t=1→violet end
+            vec3 spectral = _RbSpectrum(1.0 - saturate(t), sunColor, sat);
+            // Secondary is naturally ~40–50% as bright, and broader
+            color += spectral * profile * rainbowStrength * 0.042;
+        }
+    }
+    #endif
+}
+
+// ---- Visibility / strength -------------------------------------------------
+
+float GetRainbowStrength() {
+    // --- Sun height gate ---
+    // Primary bow rim touches the horizon when sun elevation = 42°.
+    // As sun rises above that, the full bow sinks below ground.
+    // We fade in as sun drops below 42° and fade out below the horizon.
+    float sunElev     = worldSunVector.y;               // -1…1
+    float sunGate     = remapSaturate(sunElev,  0.72, 0.52)   // fades in under 42°
+                      * remapSaturate(sunElev, -0.12, 0.05);   // fades out at night
+
+    if (sunGate < 0.001) return 0.0;
+
+    // --- Wetness gate ---
+    // Peak during / just after rain (wetness 0.1–0.7).
+    // Heavy overcast (wetness→1) blocks the sun → no rainbow.
+    float wetGate = remapSaturate(wetness, 0.03, 0.20)
+                  * (1.0 - remapSaturate(wetness, 0.60, 1.0) * 0.85);
+
+    if (wetGate < 0.001) return 0.0;
+
+    // --- Time-varying probability ---
+    // Uses the same CLOUD_TRANSITION_SPEED so rainbow timing feels linked
+    // to cloud movement. Produces a slow sinusoidal "appear / linger / fade"
+    // with a period of about 3–4 Minecraft hours at speed 1.0.
+    float cycle = sin(frameTimeCounter * CLOUD_TRANSITION_SPEED * 1.85e-4) * 0.5 + 0.5;
+    // A second harmonic adds variation so it doesn't feel perfectly periodic.
+    cycle += sin(frameTimeCounter * CLOUD_TRANSITION_SPEED * 7.3e-5 + 1.2) * 0.18;
+    cycle = saturate(cycle * 0.85);
+    // Threshold: only pass when the cycle exceeds (1 - probability).
+    cycle = remapSaturate(cycle, 1.0 - RAINBOW_PROBABILITY, 1.0);
+    // Smooth the hard threshold so entry/exit are gradual.
+    cycle = cycle * cycle * (3.0 - 2.0 * cycle);
+
+    return sunGate * wetGate * cycle * RAINBOW_BRIGHTNESS;
+}
