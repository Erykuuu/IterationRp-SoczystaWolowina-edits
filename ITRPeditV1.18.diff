-vec3 sRGB_EncodeSafe(vec3 c) {
-   // 为宽色域保存符号
-   vec3 s = sign(c);
-   c = abs(c);
-    
-   // sRGB 编码
-   c = mix(
-		c * 12.92, 
-		pow(c, vec3(1.0 / 2.4)) * 1.055 - 0.055,
-		step(vec3(0.0031308), c)
-	);
-
-   // 恢复符号
-   return c * s;
-}
