+vec3 ApplyInjectedLut(vec3 color){
+	float strength = LUT_STRENGTH;
+	#ifdef HDR_ENABLED
+		strength *= saturate(1.0 - (Luminance(color) - 1.0) * 10.0); // Fade out LUT for values above paper white
+	#endif
+	#if LUT_PROFILE == 1
+		return mix(color, ManualSampleLut(lutSlot1_2D, color), strength);
+	#elif LUT_PROFILE == 2
+		return mix(color, ManualSampleLut(lutSlot2_2D, color), strength);
+	#elif LUT_PROFILE == 3
+		return mix(color, ManualSampleLut(lutSlot3_2D, color), strength);
+	#elif LUT_PROFILE == 4
+		return mix(color, ManualSampleLut(lutSlot4_2D, color), strength);
+	#else
+		return color;
+	#endif
+}
