+		lightingDensity += SampleDensity(checkPos, windDirection, false, weather).y * stepLength;
+#else
+		lightingDensity += SampleDensity(checkPos, windDirection, i < 3, weather).y * stepLength;
+#endif	
+	}
+
+	//Direct Scattering
+		float hg = HenyeyGreenstein(VdotL, 0.65);
+
+		float directScattering = exp2(-lightingDensity * (cloudPos.w * 0.22 + 0.08)) * (hg + 0.02) * (1.0 - saturate(wetness + thunderStrength) * 0.9);
+#if PIXELATED_CLOUDS > 0
+		directScattering *= 0.88;
+#endif
+		
+		// Dual-Lobe Softening: Transition to ambient light based on density and aging
+		float agingMask = cloudDensity.z;
+		float softeningFactor = saturate(CLOUD_AGING_SOFTENING);
+		
+		float softening = mix(softeningFactor, 1.0, saturate(cloudDensity.y * 5.0));
+		softening = mix(softening, 1.0, 1.0 - agingMask); // Only fully apply if cloud is aged
+		
+		float bodyScattering = HenyeyGreenstein(VdotL, 0.15) + 0.15;
+		bodyScattering *= mix(1.0, CLOUD_AGING_SOFTENING, agingMask); // Use slider as a brightness multiplier for the soft body
+		
+		bodyScattering = mix(0.4, bodyScattering, saturate(cloudDensity.y * 10.0));
+		directScattering = mix(bodyScattering, directScattering, saturate(softening));
+		directScattering += (1.0 / (lightingDensity * 0.1 + 1.0)) * bodyScattering * saturate(1.0 - softening);
+
+		directScattering *= hg * 2.5 + 1.0;
+		directScattering *= mix(CLOUD_BOTTOM_BRIGHTNESS, 0.01 + pow(cloudDensity.y, CLOUD_OUTSCATTER_FACTOR), curve(saturate(cloudPos.w * 3.333 - 0.333)));
+		directScattering *= pow(max(cloudPos.w, 0.08), 0.85);
+
+		vec3 cloudColor = colorSun * (directScattering * lightingStrength.x * 20.0);
+
+	//Ambient Scattering
+		float ambientScattering = (1.0 - cloudDensity.x) * (1.0 - thunderStrength * 0.5);
+		ambientScattering *= fsqrt(cloudPos.w);
+
+		cloudColor += colorSky * (ambientScattering * lightingStrength.y * 0.35);
+
+	//Internal Lightning Illumination
+	#ifdef CLOUD_LIGHTNING
+		if (thunderStrength > 0.5 && wetness > 0.5 && CLOUD_LIGHTNING > 0.0) {
+			float timeEvents = CLOUD_ANIM_TIME * 2.0; // Constant speed to prevent flickering during weather changes
+			float eventID = floor(timeEvents);
+			float eventTime = fract(timeEvents);
+			
+			// Chance for a lightning strike event scales with thunder strength
+			float isStrike = step(0.92, fract(sin(eventID * 11.23) * 43758.5) * thunderStrength);
+			
+			if (isStrike > 0.0) {
+				// Snap camera position to a grid so the strike doesn't move with the player during the flash
+				vec2 camSnap = floor(cameraPosition.xz / 2000.0) * 2000.0;
+				
+				// Generate random localized position for the flash (relative to camera grid)
+				vec3 strikePos = vec3(
+					camSnap.x + (fract(sin(eventID * 13.52) * 43758.5) - 0.5) * 8000.0,
+					cloudAltitude.y + 1500.0, // Placed ABOVE the clouds so the light scatters through from behind
+					camSnap.y + (fract(sin(eventID * 17.81) * 43758.5) - 0.5) * 8000.0
+				);
+				
+				float dist = distance(marchingPos, strikePos);
+				
+				// Soft, single-pulse flash pattern
+				float flashPattern = exp(-eventTime * 14.0);
+				
+				// Very high attenuation for localized "one cloud at a time" look
+				float attenuation = exp2(-dist * 0.0015);
+				
+				float flashIntensity = flashPattern * attenuation * 1000.0 * CLOUD_LIGHTNING;
+				
+				// Add a vibrant, cool-white flash illumination
+				cloudColor += vec3(0.6, 0.8, 1.0) * flashIntensity * cloudDensity.y;
+			}
+		}
+	#endif
+
+	return cloudColor;
+}
+
+void NubisCumulus(inout vec3 color, vec3 worldDir, vec2 cloudAltitude, vec3 colorSun, vec3 colorSky, vec3 camera, vec2 noise, float maxLinearDepth, out float cloudTransmittance, vec2 screenCoord){
+	const float planetRadius = atmosphereModel_bottom_radius * 1e3;
+
+	//Marching Setup
+		WeatherState weather = GetWeatherEngineState();
+		vec3 windDirection = weather.windOffset;
+#if PIXELATED_CLOUDS > 0
+		windDirection *= 0.25;
+#endif
+		float baseThickness = cloudAltitude.y - cloudAltitude.x;
+		vec2 dynamicAlt = vec2(cloudAltitude.x, cloudAltitude.x + baseThickness * weather.thicknessMul);
+
+		vec3 rayStartPos = vec3(0.0, planetRadius + cameraPosition.y, 0.0);
+		vec2 cloudAltFull = vec2(dynamicAlt.x - CLOUD_ALTITUDE_VARIATION * 0.5, dynamicAlt.y + CLOUD_ALTITUDE_VARIATION * 0.5);
+
+		// Optimized Stable Ray-Sphere Intersection
+		float b = (planetRadius + cameraPosition.y) * worldDir.y;
+		float cBottom = (cameraPosition.y - cloudAltFull.x) * (2.0 * planetRadius + cameraPosition.y + cloudAltFull.x);
+		float cTop = (cameraPosition.y - cloudAltFull.y) * (2.0 * planetRadius + cameraPosition.y + cloudAltFull.y);
+		
+		float dBottom = b * b - cBottom;
+		float dTop = b * b - cTop;
+
+		vec2 iBottom = dBottom >= 0.0 ? vec2(-b - sqrt(dBottom), -b + sqrt(dBottom)) : vec2(1e10, -1e10);
+		vec2 iTop = dTop >= 0.0 ? vec2(-b - sqrt(dTop), -b + sqrt(dTop)) : vec2(1e10, -1e10);
+
+		vec2 iMarching = cameraPosition.y > dynamicAlt.y ? vec2(iTop.x, iBottom.x) : vec2(iBottom.y, iTop.y);
+		
+		if (iMarching.x > 45000.0 || iMarching.y < 0.0) iMarching = vec2(0.0); 
+
+		vec2 iPlanet = RaySphereIntersection(rayStartPos, worldDir, planetRadius);
+		if (iPlanet.x > 0.0) iMarching.y = min(iMarching.y, iPlanet.x);
+
+		vec3 marchingStart = iMarching.x * worldDir;
+		vec3 marchingEnd = iMarching.y * worldDir;
+
+		float inCloud = (1.0 - saturate((cameraPosition.y - dynamicAlt.y) * 0.005)) *
+						(1.0 - saturate((dynamicAlt.x - cameraPosition.y) * 0.005));
+
+		float iInner = iBottom.y >= 0.0 && cameraPosition.y > cloudAltitude.x ? iBottom.x : iTop.y;
+		iInner = min(iInner, 45000.0);
+
+		marchingStart = marchingStart * (1.0 - inCloud) + cameraPosition;
+		marchingEnd = mix(marchingEnd, iInner * worldDir, inCloud) + cameraPosition;
+
+		float marchingSteps = 20.0 - saturate(fsqrt(abs(worldDir.y)) * 1.4 - 0.4) * 8.0;
+		marchingSteps = floor(marchingSteps * CLOUD_QUALITY);
+#if PIXELATED_CLOUDS > 0
+		marchingSteps = max(marchingSteps, floor(24.0 * CLOUD_QUALITY));
+#endif
+
+		float marchingStepSize = 1.0 / marchingSteps;
+
+		vec3 marchingIncrement = (marchingEnd - marchingStart) * marchingStepSize;
+		
+		// Ray Offset Jitter for Sharpening: Reusing existing bayer4 utility for performance
+		float dither = fract(bayer4(screenCoord) + noise.x + float(frameCounter % 16) * goldenRatio); 
+		
+		vec3 marchingPos = marchingStart + marchingIncrement * dither;
+		float marchingLength = length(marchingIncrement);
+
+
+	//Cloud Properties
+		float stormFactor = saturate(wetness * 0.9 + thunderStrength * 0.1);
+		vec2 lightingStrength = vec2(mix(CLOUD_CLEAR_SUNLIGHTING, CLOUD_RAIN_SUNLIGHTING, wetness),
+									 mix(CLOUD_CLEAR_SKYLIGHTING, CLOUD_RAIN_SKYLIGHTING, wetness));
+		lightingStrength *= 1.0 - stormFactor * 0.95;
+		float cloudScale = 			 mix(CLOUD_CLEAR_SCALE,       CLOUD_RAIN_SCALE,       wetness);
+		float cloudDensityMul = 	 mix(CLOUD_CLEAR_DENSITY,     CLOUD_RAIN_DENSITY,     wetness);
+		cloudDensityMul *= (cloudAltitude.y - cloudAltitude.x) * marchingStepSize * 0.6;
+		
+		cloudDensityMul *= 1.0 + stormFactor * 2.5;
+
+		float VdotL = dot(worldDir, worldShadowVector);
+
+
+	//Marching
+		vec3 cloudAccum = vec3(0.0);
+		cloudTransmittance = 1.0;
+		vec3 rayHitPos = vec3(0.0);
+		float sumTransmit = 0.0;
+
+		for (int i = 0; i < int(marchingSteps); i++, marchingPos += marchingIncrement){	
+			if (distance(marchingPos, cameraPosition) > maxLinearDepth) break;
+
+			vec4 cloudPos = SetCloudPos(marchingPos, dynamicAlt, planetRadius, cloudScale, windDirection);
+			vec3 cloudDensity = SampleDensity(cloudPos, windDirection, true, weather);
+
+			// Dithered Alpha for Sorting and Edge Fidelity
+			float stepDither = fract(dither + float(i) * 0.61803398875);
+			if (cloudDensity.y < stepDither * 0.02) continue;
+
+			vec3 cloudColor = CloudLighting(marchingPos, dynamicAlt, planetRadius, cloudScale, lightingStrength, cloudDensity, cloudPos, colorSun, colorSky, windDirection, noise.y, VdotL, weather);
+			float absorption = exp2(-cloudDensity.y * cloudDensityMul);
+
+			// Dithered compositing to avoid banding in the alpha blend
+			float weight = cloudTransmittance - (absorption * cloudTransmittance);
+			cloudAccum += cloudColor * weight;
+
+			rayHitPos += marchingPos * cloudTransmittance;
+			sumTransmit += cloudTransmittance;
+
+			cloudTransmittance *= absorption;
+			if (cloudTransmittance < 0.0001) break;
+		}
+
+
+	//Aerial Perspective
+		#ifdef CLOUD_FADE
+			rayHitPos /= sumTransmit;
+			rayHitPos -= cameraPosition;
+
+			float fade = saturate(exp2(-length(rayHitPos) * 8e-5));
+			float cloudTransmittanceFaded = mix(1.0, cloudTransmittance, fade);
+			cloudAccum *= fade;
+
+			if(cloudTransmittance < 0.9999){
+				vec3 atmoPoint = camera + rayHitPos * 0.001;
+				vec3 transmittance;
+				vec3 sunDir = worldShadowVector * (step(sunAngle, 0.5) * 2.0 - 1.0);
+				vec3 aerialPerspective = GetSkyRadianceToPoint(camera, atmoPoint, sunDir, -sunDir, transmittance);
+
+				aerialPerspective *= 1.0 - stormFactor * 0.95;
+
+				color *= cloudTransmittanceFaded;
+
+				color += aerialPerspective * (1.0 - cloudTransmittanceFaded);
+				color += cloudAccum * transmittance;
+			}
+		#else
+			if(cloudTransmittance < 0.9999){
+				rayHitPos /= sumTransmit;
+				rayHitPos -= cameraPosition;
+
+				vec3 atmoPoint = camera + rayHitPos * 0.001;
+				vec3 transmittance;
+				vec3 sunDir = worldShadowVector * (step(sunAngle, 0.5) * 2.0 - 1.0);
+				vec3 aerialPerspective = GetSkyRadianceToPoint(camera, atmoPoint, sunDir, -sunDir, transmittance);
+
+				aerialPerspective *= 1.0 - stormFactor * 0.95;
+
+				color *= cloudTransmittance;
+
+				color += aerialPerspective * (1.0 - cloudTransmittance);
+				color += cloudAccum * transmittance;
+			}
+		#endif
+}
+
+#else
+
+// ================= ORIGINAL CLOUDS (IterationRP) =================
+
+vec2 SampleDensity(vec4 cloudPos, vec3 windDirection, bool sampleDetail, WeatherState weather){
+	vec3 densityPos = cloudPos.xyz;
+	vec3 coveragePos = densityPos;
+#if PIXELATED_CLOUDS > 0
+	float pixelStep = PixelatedCloudStep();
+	coveragePos = PixelatedCloudPos(coveragePos, pixelStep * 1.5);
+	densityPos = PixelatedCloudPos(densityPos, pixelStep);
+#endif
+
+	//Base Noise
+		vec4 baseNoise = textureLod(CloudNoise3D, densityPos * CLOUD_BASE_NOISE_SCALE + windDirection * 10.0, 0.0);
+
+		float baseDensity = baseNoise.y * 0.4 + baseNoise.z * 0.4 + baseNoise.w * 0.2;
+		baseDensity = remapSaturate(baseNoise.x, baseDensity - 1.0, 1.0);
+
+		float shapeCurve = curveTop(saturate(1.0 - cloudPos.w)) * 0.5;
+		shapeCurve += curve(saturate(1.15 - cloudPos.w * 1.43)) * 0.5;
+		baseDensity *= shapeCurve;
+		baseDensity *= fsqrt(saturate(cloudPos.w * 2.5)) * 0.2 + 0.8;
+		baseDensity *= mix(1.0, curveTop(saturate(cloudPos.w * 3.0)), wetness);
+
+	//Coverage
+		float coverageNoise = textureLod(CloudNoise3D, coveragePos * vec3(8.5e-5, 1e-5, 8.5e-5) + windDirection + CLOUD_COVERAGE_NOISE_OFFSET, 0.0).x;
+
+		#if CLOUD_STYLE == 2
+			#ifdef CLOUD_WEATHER_NETWORK
+				float clearCovery = mix(CLOUD_COVERAGE_MIN, CLOUD_COVERAGE_MAX, weather.targetCoverage);
+				clearCovery = mix(clearCovery, 0.92, weather.rainFactor);
+			#elif defined CLOUD_DYNAMIC_COVERAGE
+				float dynT = sin(CLOUD_ANIM_TIME * CLOUD_TRANSITION_SPEED * 2e-4) * 0.5 + 0.5;
+				dynT = smoothstep(0.0, 1.0, dynT);
+				float clearCovery = mix(CLOUD_COVERAGE_MIN, CLOUD_COVERAGE_MAX, dynT);
+			#else
+				float clearCovery = CLOUD_CLEAR_COVERY;
+			#endif
+		#else
+			float clearCovery = CLOUD_CLEAR_COVERY;
+		#endif
+
+		float coverage = mix(clearCovery, CLOUD_RAIN_COVERY, wetness);
+		coverage = remapSaturate(1.0 - coverageNoise, coverage * 0.2, coverage);
+
+		baseDensity = remapSaturate(baseDensity, coverage, 1.0); 
+
+	//Density Control
+		baseDensity *= curve(saturate(cloudPos.w * 1.8 - 0.8)) * 2.0 + 1.0;
+		baseDensity *= curveTop(saturate(cloudPos.w * 1.8));
+
+		baseDensity = saturate(baseDensity);
+
+#if PIXELATED_CLOUDS > 0 && PIXELATED_CLOUD_OCCUPANCY > 0
+	// Stronger voxel ownership for original cloud style.
+	if (sampleDetail) {
+		vec3 voxelCenter = PixelatedCloudPos(cloudPos.xyz, pixelStep);
+		vec3 occPosA = voxelCenter + vec3(0.34, -0.19, 0.27) * pixelStep;
+		vec3 occPosB = voxelCenter + vec3(-0.31, 0.23, -0.29) * pixelStep;
+		vec4 occNoiseA = textureLod(CloudNoise3D, occPosA * CLOUD_BASE_NOISE_SCALE + windDirection * 10.0, 0.0);
+		vec4 occNoiseB = textureLod(CloudNoise3D, occPosB * CLOUD_BASE_NOISE_SCALE + windDirection * 10.0, 0.0);
+		float occA = occNoiseA.y * 0.4 + occNoiseA.z * 0.4 + occNoiseA.w * 0.2;
+		float occB = occNoiseB.y * 0.4 + occNoiseB.z * 0.4 + occNoiseB.w * 0.2;
+		occA = remapSaturate(occNoiseA.x, occA - 1.0, 1.0);
+		occB = remapSaturate(occNoiseB.x, occB - 1.0, 1.0);
+		occA *= shapeCurve;
+		occB *= shapeCurve;
+		occA *= fsqrt(saturate(cloudPos.w * 2.5)) * 0.2 + 0.8;
+		occB *= fsqrt(saturate(cloudPos.w * 2.5)) * 0.2 + 0.8;
+		occA *= mix(1.0, curveTop(saturate(cloudPos.w * 3.0)), wetness);
+		occB *= mix(1.0, curveTop(saturate(cloudPos.w * 3.0)), wetness);
+		occA = remapSaturate(occA, coverage, 1.0);
+		occB = remapSaturate(occB, coverage, 1.0);
+		occA *= curve(saturate(cloudPos.w * 1.8 - 0.8)) * 2.0 + 1.0;
+		occB *= curve(saturate(cloudPos.w * 1.8 - 0.8)) * 2.0 + 1.0;
+		occA *= curveTop(saturate(cloudPos.w * 1.8));
+		occB *= curveTop(saturate(cloudPos.w * 1.8));
+		occA = saturate(occA);
+		occB = saturate(occB);
+
+		float occAvg = (baseDensity + occA + occB) * 0.3333333;
+		float occMax = max(baseDensity, max(occA, occB));
+		float occMin = min(baseDensity, min(occA, occB));
+
+		#if PIXELATED_CLOUD_OCCUPANCY > 1
+			vec3 occPosC = voxelCenter + vec3(0.12, 0.33, 0.18) * pixelStep;
+			vec4 occNoiseC = textureLod(CloudNoise3D, occPosC * CLOUD_BASE_NOISE_SCALE + windDirection * 10.0, 0.0);
+			float occC = occNoiseC.y * 0.4 + occNoiseC.z * 0.4 + occNoiseC.w * 0.2;
+			occC = remapSaturate(occNoiseC.x, occC - 1.0, 1.0);
+			occC *= shapeCurve;
+			occC *= fsqrt(saturate(cloudPos.w * 2.5)) * 0.2 + 0.8;
+			occC *= mix(1.0, curveTop(saturate(cloudPos.w * 3.0)), wetness);
+			occC = remapSaturate(occC, coverage, 1.0);
+			occC *= curve(saturate(cloudPos.w * 1.8 - 0.8)) * 2.0 + 1.0;
+			occC *= curveTop(saturate(cloudPos.w * 1.8));
+			occC = saturate(occC);
+			occAvg = (baseDensity + occA + occB + occC) * 0.25;
+			occMax = max(occMax, occC);
+			occMin = min(occMin, occC);
+		#endif
+
+		float voxelOccupancy = mix(occAvg, occMax, 0.58);
+		voxelOccupancy = max(voxelOccupancy, occMin * 0.65);
+		voxelOccupancy = saturate(smoothstep(0.10, 0.92, voxelOccupancy));
+		float occupancyBlend = min(0.82, 0.46 + float(PIXELATED_CLOUD_OCCUPANCY) * 0.18);
+		baseDensity = saturate(mix(baseDensity, voxelOccupancy, occupancyBlend));
+		densityPos = voxelCenter;
+	}
+#endif
+
+	float detailedDensity = 0.0;
+
+	if(baseDensity > 1e-6 && sampleDetail){
+		#if PIXELATED_CLOUDS > 0 && PIXELATED_CLOUD_OCCUPANCY > 0
+			vec3 voxelCenter = PixelatedCloudPos(cloudPos.xyz, pixelStep);
+			vec3 detailPos = voxelCenter;
+			float curlNoise = textureLod(noisetex, detailPos.xy * 0.0001, 0.0).w;
+			detailPos.xy += curlNoise * (60.0 - cloudPos.w * 60.0);
+			detailPos = PixelatedCloudPos(detailPos, pixelStep);
+			vec3 detailedNoise = textureLod(CloudDetailedNoise3D, detailPos * CLOUD_DETAILED_NOISE_SCALE + windDirection * 140.0, 0.0).xyz;
+			detailedDensity = 1.0 - detailedNoise.x * 0.625 - detailedNoise.y * 0.25 - detailedNoise.z * 0.125;
+			detailedDensity *= (0.16 - wetness * 0.08) * CLOUD_DETAILED_NOISE_STRENGTH;
+			detailedDensity = remapSaturate(baseDensity, detailedDensity, 1.0);
+			densityPos = voxelCenter;
+		#else
+			//Curl Noise
+				float curlNoise = textureLod(noisetex, densityPos.xy * 0.0001, 0.0).w;
+				densityPos.xy += curlNoise * (100.0 - cloudPos.w * 100.0);
+#if PIXELATED_CLOUDS > 0
+				densityPos = PixelatedCloudPos(densityPos, pixelStep);
+#endif
+
+			//Detailed Noise
+				vec3 detailedNoise = textureLod(CloudDetailedNoise3D, densityPos * CLOUD_DETAILED_NOISE_SCALE + windDirection * 140.0, 0.0).xyz;
+				detailedDensity = 1.0 - detailedNoise.x * 0.625 - detailedNoise.y * 0.25 - detailedNoise.z * 0.125;
+				detailedDensity *= (0.21 - wetness * 0.11) * CLOUD_DETAILED_NOISE_STRENGTH;
+
+				detailedDensity = remapSaturate(baseDensity, detailedDensity, 1.0);
+		#endif
+	}else{
+		detailedDensity = baseDensity;
+	}
+
+#if PIXELATED_CLOUDS > 0
+	float voxelVariation = PixelCloudVoxelVariation(densityPos, pixelStep);
+	float voxelShade = mix(0.88, 1.12, voxelVariation);
+	baseDensity = saturate(QuantizePixelCloudValue(baseDensity, 4.0) * voxelShade);
+	detailedDensity = saturate(QuantizePixelCloudValue(detailedDensity, 4.0) * voxelShade);
+#endif
+
+	return vec2(baseDensity, detailedDensity);
+}
+
+vec4 SetCloudPos(vec3 marchingPos, vec2 cloudAltitude, float planetRadius, float cloudScale, vec3 windDirection){
+	vec4 cloudPos = vec4(marchingPos, 0.0);
+	cloudPos.y = length(cloudPos.xyz + vec3(0.0, planetRadius, 0.0)) - planetRadius;
+	cloudPos.w = remapSaturate(cloudPos.y, cloudAltitude.x, cloudAltitude.y);
+	cloudPos.xyz = cloudPos.xyz * cloudScale + vec3(30.0 * cloudPos.w, 0.0, -12.0 * cloudPos.w);
+	return cloudPos;
+}
+
+vec3 CloudLighting(vec3 marchingPos, vec2 cloudAltitude, float planetRadius, float cloudScale, vec2 lightingStrength, vec2 cloudDensity, vec4 cloudPos, vec3 colorSun, vec3 colorSky, vec3 windDirection, float noise, float VdotL, WeatherState weather){
+	float stepLength = 28.0;
+	float lightingDensity = 0.0;
+
+	for (int i = 0; i < 5; i++, marchingPos += worldShadowVector * stepLength, stepLength *= 1.5){
+		vec4 checkPos = SetCloudPos(marchingPos + worldShadowVector * stepLength * noise, cloudAltitude, planetRadius, cloudScale, windDirection);
+
+#if PIXELATED_CLOUDS > 0 && PIXELATED_CLOUD_OCCUPANCY > 0
+		lightingDensity += SampleDensity(checkPos, windDirection, false, weather).y * stepLength;
+#else
+		lightingDensity += SampleDensity(checkPos, windDirection, i < 3, weather).y * stepLength;
+#endif	
+	}
+
+	//Direct Scattering
+		float hg = HenyeyGreenstein(VdotL, 0.65);
+
+		float directScattering = exp2(-lightingDensity * (cloudPos.w * 0.15 + 0.05)) * (hg + 0.02) * (1.0 - wetness * 0.8);
+#if PIXELATED_CLOUDS > 0
+		directScattering *= 0.88;
+#endif
+		directScattering += (1.0 / (lightingDensity * 0.2 + 1.0)) * (HenyeyGreenstein(VdotL, 0.2) + 0.1);
+
+		directScattering *= hg * 1.6 + 1.0;
+		directScattering *= mix(CLOUD_BOTTOM_BRIGHTNESS, 0.005 + pow(cloudDensity.y, CLOUD_OUTSCATTER_FACTOR), curve(saturate(cloudPos.w * 3.333 - 0.333)));
+		directScattering *= pow(max(cloudPos.w, 0.05), 0.75);
+
+		vec3 cloudColor = colorSun * (directScattering * lightingStrength.x * 24.0);
+
+	//Ambient Scattering
+		float ambientScattering = 1.0 - cloudDensity.x;
+		ambientScattering *= fsqrt(cloudPos.w);
+
+		cloudColor += colorSky * (ambientScattering * lightingStrength.y * 0.35);
+
+	return cloudColor;
+}
+
+void NubisCumulus(inout vec3 color, vec3 worldDir, vec2 cloudAltitude, vec3 colorSun, vec3 colorSky, vec3 camera, vec2 noise, float maxLinearDepth, out float cloudTransmittance, vec2 screenCoord){
+	const float planetRadius = atmosphereModel_bottom_radius * 1e3;
+
+	//Marching Setup
+		WeatherState weather = GetWeatherEngineState();
+		vec3 windDirection = weather.windOffset;
+#if PIXELATED_CLOUDS > 0
+		windDirection *= 0.25;
+#endif
+
+		vec3 rayStartPos = vec3(0.0, planetRadius + cameraPosition.y, 0.0);
+		vec2 iBottom = RaySphereIntersection(rayStartPos, worldDir, planetRadius + cloudAltitude.x);
+		vec2 iTop = RaySphereIntersection(rayStartPos, worldDir, planetRadius + cloudAltitude.y);
+
+		vec2 iMarching = cameraPosition.y > cloudAltitude.y ? vec2(iTop.x, iBottom.x) : vec2(iBottom.y, iTop.y);
+		vec3 marchingStart = iMarching.x * worldDir;
+		vec3 marchingEnd = iMarching.y * worldDir;
+
+		float inCloud = (1.0 - saturate((cameraPosition.y - cloudAltitude.y) * 0.005)) *
+						(1.0 - saturate((cloudAltitude.x - cameraPosition.y) * 0.005));
+
+		float iInner = iBottom.y >= 0.0 && cameraPosition.y > cloudAltitude.x ? iBottom.x : iTop.y;
+		iInner = min(iInner, 5000.0);
+
+		marchingStart = marchingStart * (1.0 - inCloud) + cameraPosition;
+		marchingEnd = mix(marchingEnd, iInner * worldDir, inCloud) + cameraPosition;
+
+		float marchingSteps = 20.0 - saturate(fsqrt(abs(worldDir.y)) * 1.4 - 0.4) * 8.0;
+		marchingSteps = floor(marchingSteps * CLOUD_QUALITY);
+#if PIXELATED_CLOUDS > 0
+		marchingSteps = max(marchingSteps, floor(24.0 * CLOUD_QUALITY));
+#endif
+
+		float marchingStepSize = 1.0 / marchingSteps;
+
+		vec3 marchingIncrement = (marchingEnd - marchingStart) * marchingStepSize;
+		vec3 marchingPos = marchingStart + marchingIncrement * noise.x;
+		float marchingLength = length(marchingIncrement);
+
+
+	//Cloud Properties
+		vec2 lightingStrength = vec2(mix(CLOUD_CLEAR_SUNLIGHTING, CLOUD_RAIN_SUNLIGHTING, wetness),
+									 mix(CLOUD_CLEAR_SKYLIGHTING, CLOUD_RAIN_SKYLIGHTING, wetness));
+		float cloudScale = 			 mix(CLOUD_CLEAR_SCALE,       CLOUD_RAIN_SCALE,       wetness);
+		float cloudDensityMul = 	 mix(CLOUD_CLEAR_DENSITY,     CLOUD_RAIN_DENSITY,     wetness);
+		cloudDensityMul *= (cloudAltitude.y - cloudAltitude.x) * marchingStepSize * 0.6;
+
+		float VdotL = dot(worldDir, worldShadowVector);
+
+
+	//Marching
+		vec3 cloudAccum = vec3(0.0, 0.0, 0.0);
+		cloudTransmittance = 1.0;
+		vec3 rayHitPos = vec3(0.0);
+		float sumTransmit = 0.0;
+
+		for (int i = 0; i < int(marchingSteps); i++, marchingPos += marchingIncrement){	
+			if (distance(marchingPos, cameraPosition) > maxLinearDepth) break;
+
+			vec4 cloudPos = SetCloudPos(marchingPos, cloudAltitude, planetRadius, cloudScale, windDirection);
+
+			vec2 cloudDensity = SampleDensity(cloudPos, windDirection, true, weather);
+
+			if (cloudDensity.y < 1e-6) continue;
+
+			vec3 cloudColor = CloudLighting(marchingPos, cloudAltitude, planetRadius, cloudScale, lightingStrength, cloudDensity, cloudPos, colorSun, colorSky, windDirection, noise.y, VdotL, weather);
+			float absorption = exp2(-cloudDensity.y * cloudDensityMul);
+
+			cloudAccum += cloudColor * (cloudTransmittance - absorption * cloudTransmittance);
+			//cloudAccum += cloudColor * ((1.0 - absorption) / cloudDensity.y * cloudTransmittance);
+
+			rayHitPos += marchingPos * cloudTransmittance;
+			sumTransmit += cloudTransmittance;
+
+			cloudTransmittance *= absorption;
+			if (cloudTransmittance < 0.0001) break;
+		}
+
+
+	//Aerial Perspective
+		#ifdef CLOUD_FADE
+			rayHitPos /= sumTransmit;
+			rayHitPos -= cameraPosition;
+
+			float fade = saturate(exp2(-length(rayHitPos) * 8e-5));
+			float cloudTransmittanceFaded = mix(1.0, cloudTransmittance, fade);
+			cloudAccum *= fade;
+
+			if(cloudTransmittance < 0.9999){
+				vec3 atmoPoint = camera + rayHitPos * 0.001;
+				vec3 transmittance;
+				vec3 sunDir = worldShadowVector * (step(sunAngle, 0.5) * 2.0 - 1.0);
+				vec3 aerialPerspective = GetSkyRadianceToPoint(camera, atmoPoint, sunDir, -sunDir, transmittance);
+
+				color *= cloudTransmittanceFaded;
+
+				color += aerialPerspective * (1.0 - cloudTransmittanceFaded);
+				color += cloudAccum * transmittance;
+			}
+		#else
+			if(cloudTransmittance < 0.9999){
+				rayHitPos /= sumTransmit;
+				rayHitPos -= cameraPosition;
+
+				vec3 atmoPoint = camera + rayHitPos * 0.001;
+				vec3 transmittance;
+				vec3 sunDir = worldShadowVector * (step(sunAngle, 0.5) * 2.0 - 1.0);
+				vec3 aerialPerspective = GetSkyRadianceToPoint(camera, atmoPoint, sunDir, -sunDir, transmittance);
+
+				color *= cloudTransmittance;
+
+				color += aerialPerspective * (1.0 - cloudTransmittance);
+				color += cloudAccum * transmittance;
+			}
+		#endif
+}
+
+#endif // CLOUD_STYLE
+
+#endif
