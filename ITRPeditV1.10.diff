+	vec3 low  = color - (1.0 - 2.0 * blendLayer) * color * (1.0 - color);
+	vec3 high = color + (2.0 * blendLayer - 1.0) * (d - color);
+	
+	return mix(high, low, step(blendLayer, vec3(0.5)));
+}
