+vec3 SampleLutTexel(sampler2D lutSampler, vec3 indexCoord) {
+	const float size = 32.0;
+	const float width = 1024.0;
+	
+	vec2 uv = vec2(
+		(indexCoord.z * size + indexCoord.x + 0.5) / width,
+		(indexCoord.y + 0.5) / size
+	);
+
+	return textureLod(lutSampler, uv, 0.0).rgb;
+}
+
+vec3 ManualSampleLut(sampler2D lutSampler, vec3 color) {
+	color = saturate(color);
+	const float size = 32.0;
+	
+	vec3 coord = color * (size - 1.0);
+	vec3 c0 = floor(coord);
+	vec3 c1 = min(c0 + 1.0, vec3(size - 1.0));
+	vec3 f = fract(coord);
+
+	vec3 c000 = SampleLutTexel(lutSampler, vec3(c0.x, c0.y, c0.z));
+	vec3 c100 = SampleLutTexel(lutSampler, vec3(c1.x, c0.y, c0.z));
+	vec3 c010 = SampleLutTexel(lutSampler, vec3(c0.x, c1.y, c0.z));
+	vec3 c110 = SampleLutTexel(lutSampler, vec3(c1.x, c1.y, c0.z));
+	vec3 c001 = SampleLutTexel(lutSampler, vec3(c0.x, c0.y, c1.z));
+	vec3 c101 = SampleLutTexel(lutSampler, vec3(c1.x, c0.y, c1.z));
+	vec3 c011 = SampleLutTexel(lutSampler, vec3(c0.x, c1.y, c1.z));
+	vec3 c111 = SampleLutTexel(lutSampler, vec3(c1.x, c1.y, c1.z));
+
+	vec3 x00 = mix(c000, c100, f.x);
+	vec3 x10 = mix(c010, c110, f.x);
+	vec3 x01 = mix(c001, c101, f.x);
+	vec3 x11 = mix(c011, c111, f.x);
+	
+	vec3 y0 = mix(x00, x10, f.y);
+	vec3 y1 = mix(x01, x11, f.y);
+
+	return mix(y0, y1, f.z);
+}
+
+vec3 ApplyInjectedLut(vec3 color){
+	#if LUT_PROFILE == 1
+		return mix(color, ManualSampleLut(lutSlot1_2D, color), LUT_STRENGTH);
+	#elif LUT_PROFILE == 2
+		return mix(color, ManualSampleLut(lutSlot2_2D, color), LUT_STRENGTH);
+	#elif LUT_PROFILE == 3
+		return mix(color, ManualSampleLut(lutSlot3_2D, color), LUT_STRENGTH);
+	#elif LUT_PROFILE == 4
+		return mix(color, ManualSampleLut(lutSlot4_2D, color), LUT_STRENGTH);
+	#else
+		return color;
+	#endif
+}
