 vec3 RRTAndODTFit(vec3 v){
 	vec3 a = v * (v + 0.0245786) - 0.000090537;
@@ -220,6 +224,258 @@ float Vignette(vec2 coord, const float falloff, const float roundness){
 	return 1.0 / (rf * rf);
 }
 
+float Hash11(float x){
+	return fract(sin(x * 127.1) * 43758.5453123);
+}
+
+float Hash21(vec2 p){
+	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
+}
+
+float SampleSunDepthVisibility(vec2 coord, float sunDepth){
+	if (clamp(coord, 0.0, 1.0) != coord) return 0.0;
+
+	// Sample both opaque and translucent depth for maximum safety
+	float sceneDepth = textureLod(depthtex0, coord, 0.0).x;
+	sceneDepth = min(sceneDepth, textureLod(depthtex1, coord, 0.0).x);
+	
+	#if defined DISTANT_HORIZONS || defined VOXY
+		float lodDepth = textureLod(LOD_DEPTH_TEX_1, coord, 0.0).x;
+		#ifdef LOD_RENDERING
+			lodDepth = ScreenDepth_From_LODScreenDepth(lodDepth);
+		#endif
+		sceneDepth = min(sceneDepth, lodDepth);
+	#endif
+
+	// Binary check: Everything significantly less than 1.0 is an opaque occluder.
+	return step(0.9999, sceneDepth);
+}
+
+float isSunVisible(vec2 sunCoord, float sunDepth){
+	if (sunCoord.x <= 0.0 || sunCoord.x >= 1.0 || sunCoord.y <= 0.0 || sunCoord.y >= 1.0) return 0.0;
+
+	// Opaque Visibility (Walls, Terrain)
+	float edgeDist = min(min(sunCoord.x, 1.0 - sunCoord.x), min(sunCoord.y, 1.0 - sunCoord.y));
+	float radius = mix(15.0, 5.0, saturate(edgeDist * 8.0));
+	vec2 tapScale = pixelSize * radius;
+
+	float opaqueVis = 0.0;
+	opaqueVis += SampleSunDepthVisibility(sunCoord, sunDepth);
+	opaqueVis += SampleSunDepthVisibility(sunCoord + vec2( tapScale.x, 0.0), sunDepth);
+	opaqueVis += SampleSunDepthVisibility(sunCoord + vec2(-tapScale.x, 0.0), sunDepth);
+	opaqueVis += SampleSunDepthVisibility(sunCoord + vec2(0.0,  tapScale.y), sunDepth);
+	opaqueVis += SampleSunDepthVisibility(sunCoord + vec2(0.0, -tapScale.y), sunDepth);
+	opaqueVis += SampleSunDepthVisibility(sunCoord + tapScale, sunDepth);
+	opaqueVis += SampleSunDepthVisibility(sunCoord - tapScale, sunDepth);
+	opaqueVis /= 7.0;
+
+	// Translucent Visibility (Clouds, Foliage)
+	// We use the luminance of the sun spot to determine how much light is passing through.
+	vec3 sunColorSample = textureLod(colortex1, sunCoord, 0.0).rgb;
+	float sunLuma = Luminance(sunColorSample);
+	
+	// Soft curve: Flare dims naturally as clouds get thicker or sun dips behind leaves.
+	float lumaVis = saturate(sunLuma * 0.12 - 0.06);
+
+	// Combine: Opaque occlusion is a hard cutoff, while Translucent is a soft dimming.
+	return opaqueVis * lumaVis;
+}
+
+float StarburstMask(vec2 coord, vec2 sunCoord){
+	vec2 ray = coord - sunCoord;
+	float r = max(length(ray), 1e-5);
+	float a = atan(ray.y, ray.x);
+
+	float petals = abs(cos(a * 8.0));
+	float finePetals = abs(cos(a * 16.0 + Hash11(floor(a * 57.0)) * 0.75));
+	float angular = mix(petals, finePetals, 0.35);
+	float radial = exp(-r * 35.0) + exp(-abs(r - 0.025) * 220.0) * 0.35;
+
+	float sparkle = Hash21(floor(coord * screenSize * 0.25) + vec2(float(frameCounter % 1024), 0.0));
+	sparkle = mix(0.82, 1.15, sparkle);
+
+	return angular * radial * sparkle;
+}
+
+vec3 SampleGhostChromatic(vec2 center, vec2 deltaDir, float radius, vec3 ghostColor){
+	vec2 chroma = deltaDir * (pixelSize * (6.0 + radius * 240.0));
+
+	float r = exp(-length(texCoord - (center + chroma * 1.0)) * (90.0 - radius * 900.0));
+	float g = exp(-length(texCoord - center) * (95.0 - radius * 900.0));
+	float b = exp(-length(texCoord - (center - chroma * 1.15)) * (90.0 - radius * 900.0));
+
+	vec3 ring = vec3(r, g, b) * ghostColor;
+	float hollow = exp(-abs(length(texCoord - center) - radius) * 190.0) * 0.75;
+	return ring * (0.35 + hollow);
+}
+
+float EllipseMask(vec2 coord, vec2 center, vec2 axisDir, vec2 radius){
+	vec2 delta = coord - center;
+	vec2 axisPerp = vec2(-axisDir.y, axisDir.x);
+	vec2 e = vec2(dot(delta, axisDir), dot(delta, axisPerp)) / max(radius, vec2(1e-4));
+	return exp(-dot(e, e) * 2.7);
+}
+
+vec3 GhostBlob(vec2 coord, vec2 center, vec2 axisDir, vec2 radius, vec3 tint, float ca){
+	vec2 chroma = axisDir * pixelSize * ca;
+	float r = EllipseMask(coord, center + chroma * 1.15, axisDir, radius * vec2(1.02, 0.98));
+	float g = EllipseMask(coord, center, axisDir, radius);
+	float b = EllipseMask(coord, center - chroma, axisDir, radius * vec2(0.98, 1.02));
+	return vec3(r, g, b) * tint;
+}
+
+vec3 getEyeFlare(vec2 coord, vec3 sunScreen, vec2 centerVec, vec2 fromSun) {
+    vec3 flare = vec3(0.0);
+    vec2 aspectVec = vec2(viewWidth / viewHeight, 1.0);
+    vec2 circularFromSun = fromSun * aspectVec;
+    float dist = length(circularFromSun);
+    if (dist < 1e-5) return vec3(0.0);
+
+    // Subtle chromatic diffraction ring
+    float ringRadius = 0.26;
+    float rR = exp(-abs(dist - ringRadius * 0.96) * 60.0);
+    float rG = exp(-abs(dist - ringRadius * 1.00) * 60.0);
+    float rB = exp(-abs(dist - ringRadius * 1.04) * 60.0);
+    vec3 diffractionRing = vec3(rR, rG, rB) * 0.08;
+
+    // Ciliary Spikes (wet, organic, spiky starburst)
+    float angle = atan(circularFromSun.y, circularFromSun.x);
+    // Movement based on camera center distance (so it shifts as you look around)
+    float camShift = length(centerVec) * 4.0 + float(frameCounter) * 0.002;
+    
+    // Organic radial noise
+    float p1 = sin(angle * 12.0 + camShift);
+    float p2 = sin(angle * 28.0 - camShift * 1.5);
+    float p3 = sin(angle * 54.0 + camShift * 0.5);
+    float spikes = max(0.0, p1 * 0.4 + p2 * 0.3 + p3 * 0.3);
+    spikes = pow(spikes, 3.0); // Sharpen spikes
+
+    // Add some high-frequency jitter
+    float jitter = fract(sin(floor(angle * 100.0) * 12.9898) * 43758.5453) * 0.2;
