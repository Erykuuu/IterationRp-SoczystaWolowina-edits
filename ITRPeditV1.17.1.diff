+	//Final Coverage Integration
+		float erosionScale = mix(CLOUD_AGING_EROSION_MAX, max(CLOUD_AGING_EROSION_MIN, 0.5), localAging); 
+		float heightSquash = mix(CLOUD_AGING_SQUASH, 1.0, localAging); 
+
+		coverage = remapSaturate(1.0 - coverageNoise, coverage * 0.1, coverage);
+		baseDensity = remapSaturate(baseDensity, coverage, 1.0); 
+
+	//Density Control
+		float verticalTaper = curve(saturate(cloudPos.w * 1.3 - 0.3)) * 1.0 + 1.0;
+		verticalTaper *= curveTop(saturate(cloudPos.w * 1.5));
+		verticalTaper *= smoothstep(0.0, 0.15, cloudPos.w) * smoothstep(1.0, 0.7, cloudPos.w / heightSquash);
+		
+		baseDensity *= verticalTaper;
+		baseDensity = saturate(baseDensity);
+		baseDensity *= weather.densityMul;
+		baseDensity = saturate(baseDensity);
+
+
+	float detailedDensity = 0.0;
+
+	if(baseDensity > 1e-6 && sampleDetail){
+		// Visible Hair/Wisp Stretching
+		vec3 detailedPos = cloudPos.xyz * CLOUD_DETAILED_NOISE_SCALE * 1.2 * CLOUD_WISP_FREQUENCY + windDirection * 150.0;
+		
+		// Anisotropic stretching for tendrils
+		vec3 stretchDir = normalize(vec3(0.5, 0.1, 0.25)); 
+		detailedPos -= stretchDir * dot(detailedPos, stretchDir) * (0.82 * wispFactor * CLOUD_WISP_HAIR_STRENGTH);
+
+		vec3 detailedNoise = textureLod(CloudDetailedNoise3D, detailedPos, 0.0).xyz;
+		float noiseValue = 1.0 - (detailedNoise.x * 0.625 + detailedNoise.y * 0.25 + detailedNoise.z * 0.125);
+		
+		// Adaptive Erosion: Enhanced at wispy edges
+		float erosionAmount = (0.3 - wetness * 0.15) * CLOUD_DETAILED_NOISE_STRENGTH * erosionScale;
+		erosionAmount *= 1.0 + wispFactor * 0.75; 
+		
+		detailedDensity = baseDensity * (1.0 - noiseValue * erosionAmount * saturate(1.2 - baseDensity));
+		detailedDensity = smoothstep(0.04 * (1.0 - wispFactor), 1.0, detailedDensity); 
+	}else{
+		detailedDensity = baseDensity;
+	}
+
+	return vec3(baseDensity, detailedDensity, localAging);
+}
