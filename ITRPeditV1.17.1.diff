+vec3 CloudLighting(vec3 marchingPos, vec2 cloudAltitude, float planetRadius, float cloudScale, vec2 lightingStrength, vec3 cloudDensity, vec4 cloudPos, vec3 colorSun, vec3 colorSky, vec3 windDirection, float noise, float VdotL, WeatherState weather){
+	float stepLength = 28.0;
+	float lightingDensity = 0.0;
+
+	for (int i = 0; i < 5; i++, marchingPos += worldShadowVector * stepLength, stepLength *= 1.5){
+		vec4 checkPos = SetCloudPos(marchingPos + worldShadowVector * stepLength * noise, cloudAltitude, planetRadius, cloudScale, windDirection);
+
+		lightingDensity += SampleDensity(checkPos, windDirection, i < 3, weather).y * stepLength;	
+	}
+
+	//Direct Scattering
+		float hg = HenyeyGreenstein(VdotL, 0.65);
+
+		float directScattering = exp2(-lightingDensity * (cloudPos.w * 0.22 + 0.08)) * (hg + 0.02) * (1.0 - saturate(wetness + thunderStrength) * 0.9);
+		
+		// Dual-Lobe Softening: Transition to ambient light based on density and aging
+		float agingMask = cloudDensity.z;
+		float softeningFactor = saturate(CLOUD_AGING_SOFTENING);
+		
+		float softening = mix(softeningFactor, 1.0, saturate(cloudDensity.y * 5.0));
+		softening = mix(softening, 1.0, 1.0 - agingMask); // Only fully apply if cloud is aged
+		
+		float bodyScattering = HenyeyGreenstein(VdotL, 0.15) + 0.15;
+		bodyScattering *= mix(1.0, CLOUD_AGING_SOFTENING, agingMask); // Use slider as a brightness multiplier for the soft body
+		
+		bodyScattering = mix(0.4, bodyScattering, saturate(cloudDensity.y * 10.0));
+		directScattering = mix(bodyScattering, directScattering, saturate(softening));
+		directScattering += (1.0 / (lightingDensity * 0.1 + 1.0)) * bodyScattering * saturate(1.0 - softening);
+
+		directScattering *= hg * 2.5 + 1.0;
+		directScattering *= mix(CLOUD_BOTTOM_BRIGHTNESS, 0.01 + pow(cloudDensity.y, CLOUD_OUTSCATTER_FACTOR), curve(saturate(cloudPos.w * 3.333 - 0.333)));
+		directScattering *= pow(max(cloudPos.w, 0.08), 0.85);
+
+		vec3 cloudColor = colorSun * (directScattering * lightingStrength.x * 20.0);
+
+	//Ambient Scattering
+		float ambientScattering = (1.0 - cloudDensity.x) * (1.0 - thunderStrength * 0.5);
+		ambientScattering *= fsqrt(cloudPos.w);
+
+		cloudColor += colorSky * (ambientScattering * lightingStrength.y * 0.35);
+
+	//Internal Lightning Illumination
+	#ifdef CLOUD_LIGHTNING
+		if (thunderStrength > 0.5 && wetness > 0.5 && CLOUD_LIGHTNING > 0.0) {
+			float timeEvents = CLOUD_ANIM_TIME * 2.0; // Constant speed to prevent flickering during weather changes
+			float eventID = floor(timeEvents);
+			float eventTime = fract(timeEvents);
+			
+			// Chance for a lightning strike event scales with thunder strength
+			float isStrike = step(0.92, fract(sin(eventID * 11.23) * 43758.5) * thunderStrength);
+			
+			if (isStrike > 0.0) {
+				// Snap camera position to a grid so the strike doesn't move with the player during the flash
+				vec2 camSnap = floor(cameraPosition.xz / 2000.0) * 2000.0;
+				
+				// Generate random localized position for the flash (relative to camera grid)
+				vec3 strikePos = vec3(
+					camSnap.x + (fract(sin(eventID * 13.52) * 43758.5) - 0.5) * 8000.0,
+					cloudAltitude.y + 1500.0, // Placed ABOVE the clouds so the light scatters through from behind
+					camSnap.y + (fract(sin(eventID * 17.81) * 43758.5) - 0.5) * 8000.0
+				);
+				
+				float dist = distance(marchingPos, strikePos);
+				
+				// Soft, single-pulse flash pattern
+				float flashPattern = exp(-eventTime * 14.0);
+				
+				// Very high attenuation for localized "one cloud at a time" look
+				float attenuation = exp2(-dist * 0.0015);
+				
+				float flashIntensity = flashPattern * attenuation * 1000.0 * CLOUD_LIGHTNING;
+				
+				// Add a vibrant, cool-white flash illumination
+				cloudColor += vec3(0.6, 0.8, 1.0) * flashIntensity * cloudDensity.y;
+			}
+		}
+	#endif
+
+	return cloudColor;
+}
