+			   mix(textureLod(noisetex, c.yz, 0.0).w, textureLod(noisetex, c.xz, 0.0).w, m.x),
+			   m.y);
+}
+
+float BilinearNoise(vec2 position) {
+	return textureLod(noisetex, mod(position * 1.2e-4, 1.0), 0.0).w;
+}
+
+
+
+float GetPlanarCloudsDistortion(vec2 movingPos){
+	float density = BilinearNoise(movingPos * 0.5);
+	float scale = 4.0;
+	for (int i = 0; i < 2; i++, scale *= 2.0){
+		density += BilinearNoise(movingPos * scale) * pow(scale, -1.0);
+	}
+	return density;
+}
+
+vec2 GetPlanarMovingPos(vec2 centerPosition, vec2 cameraPosition, vec2 windDirection) {
+	vec2 position = (centerPosition + cameraPosition + 10000.0) * PC_NOISE_SCALE;
+	vec2 movingPos = position - windDirection;
+
+	#if CLOUD_PLANAR_TYPE == 4
+		float cycle = CLOUD_ANIM_TIME * 0.006 * CLOUD_TRANSITION_SPEED;
+		float w1 = saturate(sin(cycle) * 1.5);             
+		float w2 = saturate(sin(cycle + 2.09) * 1.5);      
+		float w3 = saturate(sin(cycle + 4.18) * 1.5);      
+		float totalW = w1 + w2 + w3 + 1e-5;
+		float cirrusWeight = w1 / totalW;
+		float curlsWeight  = w2 / totalW;
+
+		if (cirrusWeight > 0.001) {
+			vec2 cirrusUV = movingPos;
+			cirrusUV.x *= 0.45; 
+			float warp = BicubicBlurNoise(cirrusUV * 0.4 + windDirection * 0.05);
+			cirrusUV += vec2(warp, warp * 0.2) * 0.8;
+			movingPos = mix(movingPos, cirrusUV, cirrusWeight);
+		}
+
+		if (curlsWeight > 0.001) {
+			vec2 curlsUV = movingPos;
+			vec2 warpUV = curlsUV * 0.4;
+			vec2 warpOffset = vec2(BilinearNoise(warpUV), BilinearNoise(warpUV + 0.5));
+			curlsUV += warpOffset * 1.5;
+			movingPos = mix(movingPos, curlsUV, curlsWeight);
+		}
+	#elif CLOUD_PLANAR_TYPE == 1 // Cirrus
+		movingPos.x *= 0.45; 
+		float warp = BicubicBlurNoise(movingPos * 0.4 + windDirection * 0.05);
+		movingPos += vec2(warp, warp * 0.2) * 0.8;
+	#elif CLOUD_PLANAR_TYPE == 2 // Cirrocumulus
+		vec2 warpUV = movingPos * 0.4;
+		vec2 warpOffset = vec2(BilinearNoise(warpUV), BilinearNoise(warpUV + 0.5));
+		movingPos += warpOffset * 1.5;
+	#endif
+
+	return movingPos;
+}
+
+float GetPlanarCloudsDensity(vec2 centerPosition, vec2 cameraPosition, vec2 coverageDensity, vec2 windDirection){
+	vec2 movingPos = GetPlanarMovingPos(centerPosition, cameraPosition, windDirection);
+
+	float distortion = GetPlanarCloudsDistortion(movingPos);
+	movingPos += distortion * 100.0;
+
+	const float octScale = 2.45;
+	const mat2 rotateGoldenAngle = octScale * rotMatGA;
+
+	float density = BicubicBlurNoise(movingPos);
+	mat2 rot = rotateGoldenAngle;
+	float weights = 1.0;
+
+	float softnessBias = mix(0.45, 0.95, saturate(PC_SOFTNESS / 20.0));
+	
+	// Performance Fix: Locked to 6 octaves for speed as requested
+	for (int i = 1; i <= 6; i++, rot = rotateGoldenAngle * rot){
+		float scale = fsqrt(float(i));
+		
+		float angle = float(i) * 2.399; 
+		mat2 octaveRot = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
+		
+		vec2 noisePosition = (rot * octaveRot) * (movingPos * scale);
+		noisePosition *= vec2(0.8, 1.2); 
+
+		float weight = pow(octScale, -softnessBias * i);
+
+		density += textureLod(noisetex, mod(noisePosition * (1.2e-4 * 128.0), 128.0) / 128.0, PC_SOFTNESS / 8.0).w * weight;
+		weights += weight;
+	}
+	density /= weights;
+
+	float detail = 0.0;
+	float detailWeights = 0.0;
+	float freq = 3.5; 
+	float amp = 0.5;
+	int detailOctaves = clamp(PC_QUALITY / 3 + 2, 2, 10);
+	for (int i = 0; i < detailOctaves; i++){
+		detail += BicubicBlurNoise(movingPos * freq) * amp; 
+		detailWeights += amp;
+		freq *= 2.15;
+		amp *= mix(0.5, 0.2, saturate(PC_SOFTNESS / 20.0)); 
+	}
+	density = mix(density, detail / detailWeights, mix(0.4, 0.05, saturate(PC_SOFTNESS / 20.0)));
+
+	#if CLOUD_PLANAR_TYPE == 3 // Altocumulus (Ice Scales)
+		density = pow(saturate(density * 1.1 - 0.1), 2.5); 
+		density = saturate(density * 1.8 - 0.6 + coverageDensity.x * 0.4);
+	#elif CLOUD_PLANAR_TYPE == 4
+		float cycle = CLOUD_ANIM_TIME * 0.006 * CLOUD_TRANSITION_SPEED;
+		float scalesWeight = saturate(sin(cycle + 4.18) * 1.5);
+		scalesWeight /= (saturate(sin(cycle) * 1.5) + saturate(sin(cycle + 2.09) * 1.5) + scalesWeight + 1e-5);
+		
+		float scalesDensity = pow(saturate(density * 1.1 - 0.1), 2.5);
+		scalesDensity = saturate(scalesDensity * 1.7 - 0.5 + coverageDensity.x * 0.4);
+		
+		float baseDensity = saturate(density * 1.25 - 1.25 + coverageDensity.x);
+		density = mix(baseDensity, scalesDensity, scalesWeight);
+	#else
+		// Softer remapping for standard/cirrus modes
+		density = saturate(density * 1.25 - 1.25 + coverageDensity.x);
+	#endif
+
+	density *= exp(-distortion * 0.35);
+	
+	float finalDensity = density * density * coverageDensity.y;
+
+	#ifdef CLOUD_PLANAR_DOUBLE_LAYER
+		vec2 lagPos = movingPos + windDirection * 0.15 + vec2(15.0, 10.0);
+		float shadowLayer = BicubicBlurNoise(lagPos * 0.85);
+		shadowLayer = saturate(shadowLayer * 2.2 - 1.1);
+		finalDensity = mix(finalDensity * 0.65, finalDensity, shadowLayer * 0.5 + 0.5);
+	#endif
+
+	return finalDensity;
+}
+
+float GetPlanarCloudsLightingDensity(vec2 centerPosition, vec2 cameraPosition, vec2 coverageDensity, vec2 windDirection){
+	vec2 movingPos = GetPlanarMovingPos(centerPosition, cameraPosition, windDirection);
+
+	float distortion = GetPlanarCloudsDistortion(movingPos);
+	movingPos += distortion * 120.0;
+
+	const float octScale = 2.45;
+	const mat2 rotateGoldenAngle = octScale * rotMatGA;
+
+	float density = BicubicBlurNoise(movingPos);
+	mat2 rot = rotateGoldenAngle;
+	float weights = 1.0;
+
+	float softnessBias = mix(0.6, 1.15, saturate(PC_SOFTNESS / 20.0));
+
+	// Performance Fix: Locked to 3 octaves for speed as requested
+	for (int i = 1; i <= 3; i++, rot = rotateGoldenAngle * rot){
+		float scale = fsqrt(float(i));
+		
+		float angle = float(i) * 2.399; 
+		mat2 octaveRot = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
+		
+		vec2 noisePosition = (rot * octaveRot) * (movingPos * scale);
+		noisePosition *= vec2(1.0 - 0.35 * scale, 1.0 + 0.05 * scale);
+
+		float weight = pow(octScale, -softnessBias * i);
+
+		density += textureLod(noisetex, mod(noisePosition * (1.2e-4 * 128.0), 128.0) / 128.0, PC_SOFTNESS / 8.0).w * weight;
+		weights += weight;
+	}
+	density /= weights;
+
+	#if CLOUD_PLANAR_TYPE == 3
+		density = pow(saturate(density * 1.1 - 0.1), 2.5);
+		density = saturate(density * 1.7 - 0.5 + coverageDensity.x * 0.4);
+	#elif CLOUD_PLANAR_TYPE == 4
+		float cycle = CLOUD_ANIM_TIME * 0.006 * CLOUD_TRANSITION_SPEED;
+		float scalesWeight = saturate(sin(cycle + 4.18) * 1.5);
+		scalesWeight /= (saturate(sin(cycle) * 1.5) + saturate(sin(cycle + 2.09) * 1.5) + scalesWeight + 1e-5);
+		
+		float scalesDensity = pow(saturate(density * 1.1 - 0.1), 2.5);
+		scalesDensity = saturate(scalesDensity * 1.7 - 0.5 + coverageDensity.x * 0.4);
+		
+		float baseDensity = saturate(density * 1.15 - 1.2 + coverageDensity.x);
+		density = mix(baseDensity, scalesDensity, scalesWeight);
+	#else
+		density = saturate(density * 1.15 - 1.2 + coverageDensity.x);
+	#endif
+
+	density *= exp(-distortion * 0.9);
+	
+	return density * density * coverageDensity.y;
+}
+
+vec2 GetPlanarCloudWind(){
+	float wind = 0.001 * (CLOUD_ANIM_TIME * CLOUD_SPEED + 10.0 * FTC_OFFSET);
+	return vec2(-wind, wind * 0.2);
+}
+
+vec2 GetPlanarCloudCoverage(){
+	WeatherState weather = GetWeatherEngineState();
+	
+	#ifdef CLOUD_WEATHER_NETWORK
+		float pcClearCoverage = mix(PC_COVERAGE_MIN, PC_COVERAGE_MAX, weather.targetCoverage);
+		float pcClearDensity  = PC_CLEAR_DENSITY * weather.densityMul;
+	#elif defined CLOUD_DYNAMIC_COVERAGE
+		float pcDynT = sin(CLOUD_ANIM_TIME * CLOUD_TRANSITION_SPEED * 1e-3) * 0.5 + 0.5;
+		pcDynT = smoothstep(0.0, 1.0, pcDynT);
+		float pcClearCoverage = mix(PC_COVERAGE_MIN, PC_COVERAGE_MAX, pcDynT);
+		float pcClearDensity  = PC_CLEAR_DENSITY;
+	#else
+		float pcClearCoverage = PC_CLEAR_COVERAGE;
+		float pcClearDensity  = PC_CLEAR_DENSITY;
+	#endif
+
+	vec2 coverageDensity = mix(vec2(pcClearCoverage, pcClearDensity), vec2(PC_RAIN_COVERAGE, PC_RAIN_DENSITY), wetness);
+	coverageDensity.x = saturate(coverageDensity.x);
+
+	return coverageDensity;
+}
